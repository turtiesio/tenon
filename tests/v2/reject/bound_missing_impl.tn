// error: type Point does not implement Shape (needed by bound T: Shape of total)
trait Shape {
    fn area(self) -> Int
}

struct Circle { r: Int }

struct Point { x: Int }

fn total[T: Shape](xs: List[T]) -> Int { xs.map(fn(x) => x.area()).sum() }

fn main() {
    let _ = total([Point { x: 1 }])
}
