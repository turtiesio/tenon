// error: 'h' was already used: a unique value cannot be used after it is moved
// Authority finding 6 (2026-10-28): moved on one path is moved: the value may be gone.
unique struct Handle { fd: Int }
fn take(h: Handle) -> Int { h.fd }
fn main(sys: Sys) {
    let h = Handle { fd: 3 }
    if sys.args.len() > 5 { let _ = take(h) }
    sys.console.println("{h.fd}")
}
