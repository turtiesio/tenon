// error: 'self' was already used: a unique value cannot be copied
// Authority finding 8 (2026-10-28, issue #14): a method of a declared unique wrapper returned self
// twice, giving two owners of one Listener.
unique struct Hold { listener: Listener }
fn Hold.dup(self) -> (Hold, Hold) { (self, self) }
fn main(sys: Sys) {
    let (a, b) = Hold { listener: sys.net.listen(0).unwrap() }.dup()
    sys.console.println("{a.listener.port() == b.listener.port()}")
}
