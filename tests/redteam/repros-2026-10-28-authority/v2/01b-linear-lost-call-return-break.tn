// The same through a plain call, a tuple, and `return`/`break` inside a later argument.
linear struct Claim { id: Int }
fn Claim.complete(self, con: Console) { con.println("completed {self.id}") }
fn take(c: Claim, con: Console, n: Int) { c.complete(con) }
fn fails() -> Result[Int, Str] { Err("boom") }
fn viaq(con: Console) -> Result[Unit, Str] {
    let c = Claim { id: 1 }
    take(c, con, fails()?)
    Ok(())
}
fn viaret(con: Console, early: Bool) {
    let c = Claim { id: 2 }
    take(c, con, if early { return } else { 0 })
}
fn viabreak(con: Console) {
    for i in 0..3 {
        let c = Claim { id: 3 + i }
        take(c, con, if i == 1 { break } else { 0 })
    }
}
fn main(sys: Sys) {
    sys.console.println("{viaq(sys.console)}")
    viaret(sys.console, true)
    viabreak(sys.console)
}
