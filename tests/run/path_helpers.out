join("a", "b") = "a/b"
join("a/", "b") = "a/b"
join("a//", "b") = "a//b"
join("", "b") = "b"
join("a", "") = "a"
join("", "") = ""
join("a", "/b") = "/b"
join("/", "b") = "/b"
join(".", "b") = "./b"
join("a/b", "c/d") = "a/b/c/d"
"a/b/c": parent "a/b" base "c"
"a/b": parent "a" base "b"
"a/b/": parent "a" base "b"
"a//b": parent "a" base "b"
"a": parent "." base "a"
"a/": parent "." base "a"
"": parent "." base ""
".": parent "." base "."
"..": parent "." base ".."
"a/..": parent "a" base ".."
"/": parent "/" base "/"
"//": parent "/" base "/"
"/a": parent "/" base "a"
"/a/": parent "/" base "a"
"//a": parent "/" base "a"
"/a/b": parent "/a" base "b"
"./a": parent "." base "a"
"é/ü": parent "é" base "ü"
