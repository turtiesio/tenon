// If/else-if chains and matches that compare one Int with constants: `tenon
// build` emits them as a C switch (compiler/emitctl.tn "C switches"), the
// interpreter runs them as written; both must print the same. Also the chains
// that must stay tests: guards that are not equalities, another variable, a
// repeated constant, too few constants.

fn esc(b: Int) -> Str {
    if b == '&' { "&amp;" } else if b == '<' { "&lt;" } else if '>' == b { "&gt;" } else if b == '"' { "&quot;" } else { "" }
}

fn class(b: Int) -> Str {
    if b == ' ' or b == '\t' or b == '\n' { "space" } else if b == -1 { "eof" } else if b == 0 { "nul" } else { "other" }
}

// No else: a statement chain.
fn count(xs: List[Int]) -> (Int, Int, Int) {
    var a = 0
    var b = 0
    var c = 0
    for x in xs {
        if x == 1 {
            a += 1
        } else if x == 2 {
            b += 1
        } else if x == 3 {
            c += 1
        }
    }
    (a, b, c)
}

// `break` and `continue` in a branch still mean the loop.
fn scan(xs: List[Int]) -> Str {
    var out = ""
    for x in xs {
        if x == 0 {
            continue
        } else if x == 9 {
            break
        } else if x == 5 {
            out += "five "
        } else {
            out += "{x} "
        }
    }
    out
}

// The chain stops at a condition that is not an equality: the rest is the else.
fn guard(x: Int, y: Int) -> Str {
    if x == 1 {
        "one"
    } else if x == 2 {
        "two"
    } else if x == 3 {
        "three"
    } else if x == 4 and y > 0 {
        "four, y positive"
    } else if x < 0 {
        "negative"
    } else if x == 4 {
        "four"
    } else {
        "many"
    }
}

// Not converted: guards first, two variables, a repeated constant, two constants.
fn not_equal(x: Int) -> Str { if x > 2 { "big" } else if x == 1 { "one" } else if x == 2 { "two" } else { "small" } }

fn two_vars(x: Int, y: Int) -> Str { if x == 1 { "x1" } else if y == 2 { "y2" } else if x == 3 { "x3" } else { "none" } }

fn repeated(x: Int) -> Str { if x == 1 { "first" } else if x == 2 { "two" } else if x == 1 { "second" } else { "other" } }

fn few(x: Int) -> Str { if x == 1 { "one" } else if x == 2 { "two" } else { "other" } }

// A `mut` parameter as the value; extreme constants.
fn bump(x: mut Int) -> Str {
    let s = if x == 9223372036854775807 { "max" } else if x == -9223372036854775807 { "min" } else if x == 0 { "zero" } else { "other" }
    x = s.len()
    s
}

fn name(n: Int) -> Str {
    match n {
        1 => "one",
        2 | 3 => "two or three",
        -4 => "minus four",
        k => "other {k}",
    }
}

fn digit(n: Int) -> Int {
    match n {
        0 => 10,
        1 => 11,
        2 => 12,
        _ => -1,
    }
}

// Not converted: a guard.
fn guarded(n: Int, flag: Bool) -> Str {
    match n {
        1 if flag => "one, flag",
        1 => "one",
        2 => "two",
        3 => "three",
        _ => "other",
    }
}

fn main(sys: Sys) {
    let con = sys.console
    var line = ""
    for b in "a&<b>\"c".bytes() { line += esc(b) }
    con.println(line)
    con.println([' ', '\t', '\n', -1, 0, 'x'].map(fn(b) => class(b)).join(","))
    con.println("{count([1, 2, 3, 3, 4, 1, 3])}")
    con.println(scan([1, 0, 5, 7, 9, 8]))
    con.println([1, 2, 3, 4, 5, -2].map(fn(x) => guard(x, 1)).join(","))
    con.println([4, 5].map(fn(x) => guard(x, 0)).join(","))
    con.println([0, 1, 2, 3].map(fn(x) => not_equal(x)).join(","))
    con.println("{two_vars(1, 2)} {two_vars(0, 2)} {two_vars(3, 0)} {two_vars(0, 0)}")
    con.println([1, 2, 3].map(fn(x) => repeated(x)).join(","))
    con.println([1, 2, 3].map(fn(x) => few(x)).join(","))
    var v = 9223372036854775807
    con.println(bump(mut v))
    v = -9223372036854775807
    let a = bump(mut v)
    con.println("{a} {v}")
    v = 0
    con.println(bump(mut v) + " " + bump(mut v))
    con.println([1, 2, 3, -4, 5].map(fn(n) => name(n)).join(","))
    con.println("{[0, 1, 2, 3].map(fn(n) => digit(n))}")
    con.println("{guarded(1, true)} {guarded(1, false)} {guarded(3, true)} {guarded(7, false)}")
}
