    rows(c, "[a-cx-z]+", ["abcxyz", "d", "abdxyz"])
    rows(c, "[0-9a-fA-F]\{2}", ["ff", "FG", "0a"])
    rows(c, "[a-a]", ["a", "b"])
    rows(c, "[\\.]", [".", "a"])
    rows(c, "[\\-]", ["-", "a"])
    rows(c, "[a-z&&[^b]]", ["a"])
