    rows(c, "(a+)+$", ["aaa", "aab", ""])
    rows(c, "(a|aa)+$", ["aaa", "aaaa", "aab"])
    rows(c, "(a*)*b", ["aaab", "b", "aaa"])
    rows(c, "(a*)+b", ["aaab", "b", "aaa"])
    rows(c, "(a?)+?b", ["aab", "b"])
    rows(c, "(?:a*)*?b", ["aab", "b"])
    rows(c, "(a*?)*b", ["aab", "b"])
    rows(c, "(?:a|b|)*c", ["abc", "c", "x"])
    rows(c, "(?:|a)*b", ["aab", "b"])
    rows(c, "(a+?)+b", ["aaab", "b", "c"])
    rows(c, "((a)|b)*", ["ab"])
    rows(c, "(\\b\\w)", ["foo bar", ""])
    rows(c, "(x)(y)?", ["x", "xy"])
    rows(c, "a(?:b|c)*d", ["abcbd", "ad", "abx"])
}

fn errors(c: Console) {
    err(c, "(")
    err(c, "a)")
    err(c, ")")
    err(c, "(a")
    err(c, "(a|b")
    err(c, "((a)")
    err(c, "(a))")
    err(c, "[")
    err(c, "[a")
    err(c, "[a-")
    err(c, "[^")
    err(c, "[]")
    err(c, "[]a")
    err(c, "a**")
    err(c, "*")
    err(c, "+a")
    err(c, "?")
    err(c, "a|*")
    err(c, "(*)")
    err(c, "\{2}")
    err(c, "a\{3,2}")
    err(c, "[z-a]")
    err(c, "\\")
    err(c, "a\\")
    err(c, "\\q")
    err(c, "\\w\\y")
    err(c, "(?=a)")
    err(c, "(?!a)")
    err(c, "(?<=a)b")
    err(c, "(?P<n>a)")
    err(c, "(?i)a")
    err(c, "(?")
    err(c, "(?:a")
    err(c, "[\\")
    err(c, "[a\\")
    err(c, "x[")
    err(c, "a\{2}\{3}")
    err(c, "a*?*")
    err(c, "a++")
    err(c, "a?*")
    err(c, "^*")
    err(c, "$+")
    err(c, "\\b?")
    err(c, "\\B*")
    err(c, "[\\d-z]")
    err(c, "[a-\\d]")
    err(c, "\\1")
    err(c, "(a)\\1")
    err(c, "\\9")
    err(c, "a\{1001}")
    err(c, "a\{0,1001}")
    err(c, "a\{2,1}")
    err(c, "ab(cd")
    err(c, "ab)cd")
    err(c, "|*")
    err(c, "(|*)")
    err(c, "(?:*)")
    err(c, "x\{2}*")
    err(c, "x\{2}+")
    err(c, "x\{2}?\{3}")
    err(c, "x\{1}\{2}")
    err(c, "[a-b-c]d)")
    err(c, "a|b)")
    err(c, "\\d\{2}\{3}")
    err(c, "(日")
    err(c, "日)")
    err(c, "é**")
    err(c, "[é-a]")
    err(c, "café\\q")
    err(c, "(?:(")
    err(c, "((((")
    err(c, "))")
    err(c, "[[:alpha:]")
    err(c, "[a-\\")
    err(c, "\\")
    err(c, "\\\\\\")
    err(c, "a\{2,1}?")
}

// Cases for the documented differences from Python, and for the API as a whole.
fn differences(c: Console) {
    // `$` is the end of the string only: no match before a final "\n" (Python's `$` would)
    let dollar = regex.compile("a$").unwrap()
    c.println("{dollar.find("a\n")} {dollar.find("a")} {dollar.is_full("a\n")}")
    // a group that did not take part gives ""
    let opt = regex.compile("(a)|(b)").unwrap()
    c.println("{opt.full("b")} {opt.full("a")}")
    // an empty match advances by one character (Python also retries a non-empty match there)
    let empty_or_a = regex.compile("|a").unwrap()
    c.println("{empty_or_a.find_all("a")} {qs(empty_or_a.replace_all("aa", "-"))}")
    // \d \w \s \b are ASCII: é is not a word character, but a class can name it
    let word = regex.compile("\\w+").unwrap()
    c.println("{word.find_all("café au lait")} {regex.compile("[\\wé]+").unwrap().find_all("café au lait")}")
    // \f and \v are control characters, and \s includes them
    let ff = regex.compile("\\f\\v").unwrap()
    c.println("{ff.is_full(12.char() + 11.char())} {ff.is_full("fv")} {regex.compile("\\s+").unwrap().is_full(12.char() + 11.char() + " ")}")
    // the replacement is literal text
    let digits = regex.compile("(\\d)").unwrap()
    c.println("{digits.replace_all("a1b2", "\\1$1\{x}")}")
}

fn api(c: Console) {
    let re = regex.compile("(\\d+)-(\\d+)").unwrap()
    c.println("{re.is_full("1-2")} {re.is_full("1-2x")} {re.is_full("")} {re.full("10-20")} {re.full("10-")}")
    c.println("{re.find("tel 555-1234.")} {re.find("none")} {re.find_all("1-2, 33-44")} {qs(re.replace_all("1-2, 33-44", "N"))}")
    // a Regex is reusable and values are independent
    let again = regex.compile("(\\d+)-(\\d+)").unwrap()
    c.println("{again.full("7-8")} {re.full("9-9")}")
    // full backtracks into other choices until the match reaches the end
    let ab = regex.compile("a*ab?").unwrap()
    c.println("{ab.full("aaab")} {ab.full("aa")} {ab.find("aaab")}")
    // find reports byte offsets
    c.println("{regex.compile("c+").unwrap().find("日本語ccc")} {regex.compile("é").unwrap().find("aé")}")
}

// Long subjects: the matcher is linear for these patterns and stays within its step budget.
fn large(c: Console) {
    let unit = "abc123"
    let big = unit.repeat(1700)
    let ident = regex.compile("(?:[a-z]+\\d+)+").unwrap()
    c.println("{big.len()} {ident.is_full(big)} {ident.is_full(big + "!")} {ident.is_full(big + "x")}")
    c.println("{regex.compile("[a-z]+").unwrap().find_all(big).len()} {regex.compile("\\d+").unwrap().replace_all(big, "#").len()}")
    let email = regex.compile("^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]\{2,}$").unwrap()
    let local = "a".repeat(10000)
    c.println("{email.is_full(local + "@example.com")} {email.is_full(local + "@example")} {email.is_full(local)}")
    let line = regex.compile("^(\\w+)=(.*)$").unwrap()
    let long_value = "v".repeat(100000)
    c.println("{line.full("key=" + long_value).unwrap()[2].len()}")
    let none = regex.compile("needle\\d").unwrap()
    c.println("{none.find("hay ".repeat(50000))} {none.find("hay ".repeat(50000) + "needle7")}")
}

fn main(sys: Sys) {
    let c = sys.console
    table(c)
    errors(c)
    differences(c)
    api(c)
    large(c)
}
