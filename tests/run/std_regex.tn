    // classes
    rows(c, "[abc]", ["a", "d", "cab", "xyz"])
    rows(c, "[abc]+", ["abccba", "abcd", "ddabcdd"])
    rows(c, "[a-c]+", ["abcabc", "abd", "xxabc"])
