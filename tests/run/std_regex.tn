// Tests for the std regex module. Every case in the big table was checked
// against Python's `re` (re.ASCII, with `$` written as `\Z`): the same patterns
// and subjects were run through a throwaway script that printed exactly this
// output, and the two were identical. The differences from Python that are
// intended are listed in the header of std/regex.tn; the cases that exercise
// them are in `differences` below and were checked by hand.
//
// Each row prints, for a pattern and a subject: the groups of a full match, the
// leftmost match (byte offset and groups), all matches, and replace_all with a
// literal replacement ("<>" unless given).
import regex

fn qs(s: Str) -> Str {
    let t = "{[s]}"
    t.slice(1, t.len() - 1)
}

fn rowsr(c: Console, pat: Str, with: Str, subjects: List[Str]) {
    let re = regex.compile(pat).unwrap()
    for s in subjects {
        c.println("/{pat}/ {qs(s)}: full={re.full(s)} find={re.find(s)} all={re.find_all(s)} sub={qs(re.replace_all(s, with))}")
    }
}

fn rows(c: Console, pat: Str, subjects: List[Str]) { rowsr(c, pat, "<>", subjects) }

fn err(c: Console, pat: Str) {
    match regex.compile(pat) {
        Ok(_) => c.println("/{pat}/ compiles"),
        Err(e) => c.println("/{pat}/ error: {e}"),
    }
}

fn table(c: Console) {
    // dates
    rows(c, "(\\d\{4})-(\\d\{2})-(\\d\{2})", ["2024-03-15", "2024-3-15", "x2024-03-15y", "2024-03-15 and 1999-12-31", "", "12024-03-155"])
    rows(c, "^(\\d\{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$", ["2024-03-15", "2024-13-15", "2024-12-31", "2024-00-10", "2024-02-32"])
    rows(c, "(\\d\\d?)/(\\d\\d?)/(\\d\{2}|\\d\{4})", ["1/2/99", "12/31/2024", "1/2/3", "on 5/6/07 and 10/11/2012"])
    rows(c, "(\\d\{2}):(\\d\{2})(?::(\\d\{2}))?", ["12:30", "12:30:45", "at 09:05:01 or 23:59", "1:30"])
    // numbers
    rows(c, "[+-]?\\d+(\\.\\d+)?([eE][+-]?\\d+)?", ["3.14", "-2e10", "+7", "1.", ".5", "abc", "1 22 333.5 x", "", "1e", "12.5E-3"])
    rows(c, "[+-]?(?:\\d+\\.?\\d*|\\.\\d+)", ["3.14", "5.", ".5", "-.5", "a", "1.2.3"])
    rows(c, "\\d\{1,3}(,\\d\{3})*", ["1,234,567", "12,34", "1234", "123,456 and 7,890,123"])
    rows(c, "\\d+", ["abc123def45", "", "007", "no digits"])
    rows(c, "0x[0-9a-fA-F]+", ["0x1F", "0xzz", "see 0xdeadBEEF and 0x0"])
    rows(c, "-?\\d+", ["-5", "--5", "a-1b-22"])
    // emails-lite
    rows(c, "[\\w.+-]+@[\\w-]+(\\.[\\w-]+)+", ["bob@example.com", "a.b+c@x-y.co.uk", "bad@", "@x.com", "two@a.com three@b.org", "a@b", "me@host.", ""])
    rows(c, "^[^@\\s]+@[^@\\s]+\\.[a-z]\{2,}$", ["x@y.io", "x@y", "x y@z.com", "x@@y.com", "a@b.c"])
    rows(c, "(\\w+)@(\\w+)\\.com", ["joe@site.com", "joe@site.org", "to: ann@corp.com, bob@corp.com"])
    // alternation
    rows(c, "cat|dog|bird", ["cat", "dog", "bird", "cow", "hotdog", "catdogbird", ""])
    rows(c, "(cat|dog)s?", ["cats", "dog", "dogss", "cat dogs bird"])
    rows(c, "a|ab|abc", ["abc", "ab", "a", "xabc"])
    rows(c, "(a|ab)(c|bcd)(d*)", ["abcd", "abc", "acd", "abcdd"])
    rows(c, "(|a)+", ["aaa", "", "b"])
    rows(c, "a||b", ["a", "b", "", "ab"])
    rows(c, "(?:a|b|c)+", ["abcabc", "abcd", "d"])
    rows(c, "^(a|b)$", ["a", "ab", ""])
    rows(c, "(foo|foobar)$", ["foobar", "foo", "xfoobar"])
    rows(c, "x(a|b)*y", ["xy", "xabay", "xabcy"])
    rows(c, "(a)|(b)", ["a", "b", "ab", "c"])
    rows(c, "red|green|blue", ["red green blue", "bluered", "RED"])
    rows(c, "(\\d+)|([a-z]+)", ["123", "abc", "12ab34", "!"])
    // nested groups
    rows(c, "((a)(b(c)))", ["abc", "ab", "xabcx"])
    rows(c, "(a(b(c)?)?)+", ["abc", "aba", "ababc", "a"])
    rows(c, "((x)|(y))+", ["xyx", "y", "x", "z"])
    rows(c, "(?:(a)|b)*", ["ab", "ba", "abab", "b", ""])
    rows(c, "(a*)*", ["b", "aab", "", "aaa"])
    rows(c, "(a*)+", ["b", "aab", "", "aaa"])
    rows(c, "(a|b*)*", ["ab", "bbb", ""])
    rows(c, "((a)|(b))*", ["ab", "ba", "aab"])
    rows(c, "(?:(?:a)b)+", ["abab", "aba"])
    rows(c, "((ab)+c)+", ["abcababc", "abc", "ababcx"])
    rows(c, "(a(b)?)+", ["aba", "ab", "abab"])
    rows(c, "(?:)", ["", "ab"])
    rows(c, "()", ["", "a"])
    rows(c, "(()())", ["", "a"])
    rows(c, "(a)(?:b)(c)", ["abc", "ac"])
    rows(c, "((((((((((a))))))))))", ["a"])
    rows(c, "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)(l)", ["abcdefghijkl"])
    // quantifier edge cases
    rows(c, "a\{0}", ["", "a", "b"])
    rows(c, "a\{0}b", ["b", "ab", "aab"])
    rows(c, "a\{2}", ["aa", "a", "aaa", "baaab"])
    rows(c, "a\{2,}", ["a", "aa", "aaaa", "baaaab aa"])
    rows(c, "a\{,2}", ["", "a", "aa", "aaa", "baab"])
    rows(c, "a\{1,3}", ["a", "aaa", "aaaa", "", "xaaaaaay"])
    rows(c, "a\{1,3}?", ["a", "aaa", "aaaa", "aaaaaaa"])
    rows(c, "a\{2,3}?b", ["aaab", "aab", "ab"])
    rows(c, "a\{2,2}", ["aa", "aaa"])
    rows(c, "a\{3,}?", ["aaaaa", "aaaaaaa"])
    rows(c, "x\{}", ["x\{}", "x"])
    rows(c, "a\{", ["a\{", "a"])
    rows(c, "a\{1", ["a\{1", "a"])
    rows(c, "a\{1,2", ["a\{1,2", "aa"])
    rows(c, "a\{,}", ["", "aaa", "b"])
    rows(c, "a\{,}b", ["aaab", "b", "c"])
    rows(c, "a\{x}", ["a\{x}", "a"])
    rows(c, "a\{1,x}", ["a\{1,x}"])
    rows(c, "a\{ 1}", ["a\{ 1}"])
    rows(c, "\{", ["\{", "a\{"])
    rows(c, "}", ["}", "a}"])
    rows(c, "a}", ["a}"])
    rows(c, "]", ["]", "a]"])
    rows(c, "x\{a", ["x\{a"])
    rows(c, "\{a}", ["\{a}", "a"])
    rows(c, "\{,a}", ["\{,a}"])
    rows(c, "(ab)\{2}", ["abab", "ab", "ababab", "xababx"])
    rows(c, "(ab)\{2,3}", ["ab", "abab", "ababab", "abababab"])
    rows(c, "(ab)\{2,}", ["abababab", "ab"])
    rows(c, "(a|b)\{2,3}c", ["abc", "ababc", "ac", "bbbbc"])
    rows(c, "(a?)\{3}", ["", "a", "aa", "aaaa"])
    rows(c, "(a?)*", ["aa", "b"])
    rows(c, "a?", ["a", "", "aa", "b"])
    rows(c, "a??", ["a", "", "aa", "b"])
    rows(c, "a??b", ["ab", "b", "aab"])
    rows(c, "a*?", ["aaa", "", "b"])
    rows(c, "a+?", ["aaa", "", "baa"])
    rows(c, "a*?b", ["aaab", "b", "aac"])
    rows(c, "a+?b", ["aaab", "b", "xaab"])
    rows(c, ".\{3}", ["abc", "ab", "abcd", "a\nb", "日本語"])
    rows(c, "\\d\{3}-\\d\{4}", ["555-1234", "5555-1234", "call 555-1234 or 555-9999"])
    rows(c, "a\{1000}", ["a".repeat(1000), "a".repeat(999), "a".repeat(1001)])
    rows(c, "a\{500,1000}", ["a".repeat(700), "a".repeat(499), "a".repeat(1200)])
    rows(c, "(a\{10})\{10}", ["a".repeat(100), "a".repeat(99)])
    rows(c, "(?:a\{2,3})\{2}", ["aaaa", "aaaaaa", "aaa", "aaaaaaa"])
    rows(c, "a+", ["", "a", "baab", "aaa"])
    rows(c, "a*", ["", "aaa", "baab", "bbb"])
    rows(c, "(?:ab)*", ["abab", "aba", ""])
    rows(c, "(?:ab)?c", ["abc", "c", "ac"])
    rows(c, "x*y*z*", ["xxyyzz", "zy", ""])
    rows(c, "a+b+", ["aabb", "ab", "ba", "aabbaab"])
    rows(c, "(a+)(a+)", ["aaaa", "a", "aa"])
    rows(c, "(a+?)(a*)", ["aaaa", "a"])
    rows(c, "(a*?)(a+)", ["aaaa", "a"])
    rows(c, "(a*)(a*)", ["aaa", ""])
    rows(c, "a*a", ["aaa", "a", ""])
    rows(c, "a*?a", ["aaa", "a"])
    rows(c, "(.*)(\\d+)", ["abc123", "123", "abc"])
    rows(c, "(.*?)(\\d+)", ["abc123", "123", "abc"])
    rows(c, "(.*?)(\\d*)$", ["abc123", "abc"])
    rows(c, "^(.*?),(.*)$", ["a,b,c", "abc", ",", "a,"])
    rows(c, "^(.*),(.*)$", ["a,b,c", "abc", ",", "a,"])
    // anchors
    rows(c, "^abc", ["abc", "abcd", "xabc", ""])
    rows(c, "abc$", ["abc", "xabc", "abcx", "abc\n"])
    rows(c, "^$", ["", "a", "\n"])
    rows(c, "^", ["", "ab"])
    rows(c, "$", ["", "ab"])
    rows(c, "^a|b$", ["ab", "cb", "ca", "a", "b", ""])
    rows(c, "(^a)|(b$)", ["a", "b", "ab", "ba"])
    rows(c, "^a*$", ["", "aaa", "aab"])
    rows(c, "a$", ["a\n", "ba", "a"])
    rows(c, "^a$", ["a\n", "a"])
    rows(c, "a^b", ["a^b", "ab"])
    rows(c, "a$b", ["a$b", "ab"])
    rows(c, "\\^a", ["^a", "a"])
    rows(c, "a\\$", ["a$", "a"])
    rows(c, "(?:^|,)(\\w+)", ["a,b,c", "x"])
    rows(c, "(\\w+)(?:,|$)", ["a,b,c", "x"])
    rows(c, "^\\s*$", ["", "   ", " \t\n", " x "])
    rows(c, "^\\s+|\\s+$", ["  hi  ", "hi", " ", ""])
    rows(c, "\\bcat\\b", ["cat", "cat concat cat.", "concat", "a cat", "cat!"])
    rows(c, "\\Bcat", ["concat", "cat", "a cat concat"])
    rows(c, "\\b", ["", "ab cd", " "])
    rows(c, "\\B", ["", "ab cd", " "])
