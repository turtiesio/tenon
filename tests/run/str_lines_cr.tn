// stdin: a\x0d\x0d\nb\x0d\n\x0d\n\nc\x0d
// Str.lines() reads lines as Console.read_line does: split on "\n", drop a
// final empty piece, then remove one trailing "\r" from every line, also from
// the last. Before wave 6 lines() kept the "\r" ("a\r\nb".lines() was
// ["a\r", "b"]); the final-empty-line rule is unchanged ("a\n".lines() == ["a"],
// "a\n\n".lines() == ["a", ""], "".lines() == []).
fn show(c: Console, s: Str) {
    // the list, and the fused `for l in s.lines()` loop of the C backend
    var looped: List[Str] = []
    for l in s.lines() { looped.push(l) }
    c.println("{encode(s)} -> {s.lines()} {looped == s.lines()}")
}

fn main(sys: Sys) {
    let c = sys.console
    show(c, "a\r\nb\r\n") // CRLF
    show(c, "a\r\nb")     // CRLF, last line without "\n"
    show(c, "a\nb\r")     // "\r" only at the very end
    show(c, "a\r\r\nb\r") // only one "\r" is removed
    show(c, "\r")         // a lone "\r" is an empty line
    show(c, "\r\n")
    show(c, "\n\r")   // the last piece is "\r": a line, not dropped
    show(c, "a\rb\n") // a "\r" inside a line stays
    show(c, "")       // empty
    show(c, "\n")
    show(c, "\n\n")
    show(c, "a\n\nb\n")
    show(c, "a\r\n\r\n") // a final empty line after CRLF lines
    // the same lines as reading the same text (stdin above) with read_line
    var by_read: List[Str] = []
    while let Some(l) = c.read_line() { by_read.push(l) }
    let text = "a\r\r\nb\r\n\r\n\nc\r"
    c.println("{by_read} {text.lines() == by_read}")
    // lines are views of the original; slicing one works as usual
    c.println("{text.lines()[0].slice(0, 1)} {text.lines().map(fn(l) => l.len())}")
}
