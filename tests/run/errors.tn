enum ParseError { Empty, Bad(Str) }

fn parse_pos(s: Str) -> Result[Int, ParseError] {
    if s == "" { return Err(Empty) }
    let n = s.to_int().ok_or(Bad(s))?
    if n < 0 { return Err(Bad("negative: {n}")) }
    Ok(n)
}

fn sum_all(xs: List[Str]) -> Result[Int, ParseError] {
    var total = 0
    for x in xs { total += parse_pos(x)? }
    Ok(total)
}

fn first_even(xs: List[Int]) -> Option[Int] {
    for x in xs {
        if x % 2 == 0 { return Some(x) }
    }
    None
}

fn half_of_first_even(xs: List[Int]) -> Option[Int] { Some(first_even(xs)? / 2) }

fn main(sys: Sys) -> Result[Unit, ParseError] {
    let c = sys.console
    c.println("{sum_all(["1", "2", "3"])} {sum_all(["1", "x"])} {sum_all(["", "1"])} {sum_all(["-4"])}")
    c.println("{half_of_first_even([1, 3, 8])} {half_of_first_even([1, 3])}")
    let n = sum_all(["5", "oops"])?
    c.println("not reached {n}")
    Ok(())
}
