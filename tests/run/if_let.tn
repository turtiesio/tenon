// `if let` and `while let`: chains, values, scoping, loops, linear values.
enum Cmd { Push(Int), Pop, Add, Say(Str), Quit }
enum Chain { Link(Int, Chain), End }

linear struct Claim { job: Str }
fn Claim.done(self) -> Str { "done " + self.job }
fn Claim.release(self) -> Str { "released " + self.job }

unique struct Handle { fd: Int }

fn parse(line: Str) -> Cmd {
    if let Some(rest) = line.strip_prefix("push ") {
        Push(rest.to_int().unwrap_or(0))
    } else if line == "pop" {
        Pop
    } else if let Some(text) = line.strip_prefix("say ") {
        Say(text)
    } else if let "add" | "plus" = line {
        Add
    } else {
        Quit
    }
}

// An outer linear value consumed on both paths of an `if let`.
fn settle(c: Claim, note: Option[Str]) -> Str {
    if let Some(n) = note { c.done() + " (" + n + ")" } else { c.release() }
}

// A unique scrutinee: moved into the binding, or dropped by the `else`.
fn fd_of(h: Option[Handle]) -> Int {
    if let Some(x) = h { x.fd } else { -1 }
}

fn first_even(xs: List[Int]) -> Option[Int] {
    for x in xs {
        if let 0 = x % 2 { return Some(x) }
    }
    None
}

fn sum_chain(c: Chain) -> Int {
    var node = c
    var total = 0
    while let Link(v, rest) = node {
        total += v
        node = rest
    }
    total
}

fn main(sys: Sys) {
    let con = sys.console
    var stack: List[Int] = []
    for line in ["push 3", "push 4", "add", "say hi", "plus", "pop", "pop", "bogus"] {
        let cmd = parse(line)
        if let Push(n) = cmd { stack.push(n) }
        if let Add = cmd {
            if let Some(b) = stack.pop() {
                if let Some(a) = stack.pop() { stack.push(a + b) } else { stack.push(b) }
            }
        }
        if let Pop = cmd {
            let v = if let Some(x) = stack.pop() { "{x}" } else { "empty" }
            con.println("pop -> {v}")
        }
        if let Say(text) = cmd { con.println("say {text}") }
        if let Quit = cmd { con.println("quit at '{line}'") }
    }

    // The same name may be bound again once the first binding is out of scope.
    let o: Option[Int] = Some(7)
    if let Some(x) = o { con.println("x is {x}") }
    if let Some(x) = first_even([1, 3, 8, 10]) { con.println("first even {x}") }
    if let None = first_even([1, 3]) { con.println("no even") }

    // Irrefutable patterns are allowed.
    if let (a, b) = (1, "one") { con.println("{a} {b}") }

    // while let draining a list, with continue and break.
    var xs = [1, 2, 3, 4, 5, 6]
    var seen: List[Int] = []
    while let Some(x) = xs.pop() {
        if x == 5 { continue }
        if x == 2 { break }
        seen.push(x)
    }
    con.println("seen {seen}, left {xs}")

    // while let over an Option state.
    var cur: Option[Int] = Some(3)
    while let Some(n) = cur {
        con.println("countdown {n}")
        cur = if n > 1 { Some(n - 1) } else { None }
    }

    con.println("chain {sum_chain(Link(1, Link(2, Link(3, End))))}")
    con.println(settle(Claim { job: "a" }, Some("ok")))
    con.println(settle(Claim { job: "b" }, None))
    con.println("fd {fd_of(Some(Handle { fd: 9 }))} {fd_of(None)}")

    // As an expression inside a match arm.
    let r: Result[Int, Str] = Err("bad")
    let msg = match o {
        Some(_) => if let Err(e) = r { "err " + e } else { "fine" },
        None => "none",
    }
    con.println(msg)
}
