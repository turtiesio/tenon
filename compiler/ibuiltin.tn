// module
// Builtins: the prelude's `extern fn`s on numbers, strings, lists, maps,
// Option/Result and the console (seed/src/builtins.rs `call_extern`,
// `extern_mut`). The host's own builtins do the work (they are the C
// runtime's, which agrees with the bootstrap); every precondition whose
// failure is a trap is checked first, so the trap is the interpreted
// program's, with its message and location.
import ckast
import ival
import ieval
import icap
import iwork

// A builtin, found by its name in `table` once, when the program is lowered
// (icode numbers the table's names; the interpreter keeps the variants), so
// adding one moves no other. A worker logs the results of the effects (the
// console, the capabilities, the workers and channels; iwork.tn).
pub enum Bi { BCore(CoreOp), BStr(StrOp), BCon(ConOp), BFs(icap.FsOp), BNet(icap.NetOp), BPoll(icap.PollOp), BSys(icap.SysOp), BWork(iwork.WorkOp) }

pub enum CoreOp {
    BxPanic, BxAssert, BxEncode, BxAddChk, BxSubChk, BxMulChk, BxDivChk, BxToFloat, BxChar, BxToInt, BxSqrt, BxFloor, BxCeil,
    BxRound, BxToFixed, BxListLen, BxListSlice, BxListJoin, BxMapLen, BxMapGet, BxMapKeys, BxMapValues, BxOptUnwrap,
    BxOptExpect, BxResUnwrap, BxResExpect,
}

pub enum StrOp {
    BsLen, BsByte, BsSlice, BsFind, BsFindFrom, BsSplit, BsTrim, BsTrimStart, BsTrimEnd, BsStartsWith, BsEndsWith, BsToInt,
    BsToFloat, BsUpper, BsLower, BsReplace, BsChars, BsCharCount, BsBytes, BsFromUtf8, BsFromUtf8Lossy, BsLines, BsWords,
}

pub enum ConOp { BcPrint, BcPrintln, BcEprintln, BcReadLine, BcReadAll, BcReadAllBytes, BcWriteBytes, BcFlush, BcReadBytes }

// The builtins taking their receiver by value, by name.
pub fn table() -> List[(Str, Bi)] {
    [
        ("panic", BCore(BxPanic)), ("assert", BCore(BxAssert)), ("encode", BCore(BxEncode)),
        ("Int.checked_add", BCore(BxAddChk)), ("Int.checked_sub", BCore(BxSubChk)), ("Int.checked_mul", BCore(BxMulChk)),
        ("Int.checked_div", BCore(BxDivChk)), ("Int.to_float", BCore(BxToFloat)), ("Int.char", BCore(BxChar)),
        ("Float.to_int", BCore(BxToInt)), ("Float.sqrt", BCore(BxSqrt)), ("Float.floor", BCore(BxFloor)),
        ("Float.ceil", BCore(BxCeil)), ("Float.round", BCore(BxRound)), ("Float.to_fixed", BCore(BxToFixed)),
        ("List.len", BCore(BxListLen)), ("List.slice", BCore(BxListSlice)), ("List.join", BCore(BxListJoin)),
        ("Map.len", BCore(BxMapLen)), ("Map.get", BCore(BxMapGet)), ("Map.keys", BCore(BxMapKeys)),
        ("Map.values", BCore(BxMapValues)), ("Option.unwrap", BCore(BxOptUnwrap)), ("Option.expect", BCore(BxOptExpect)),
        ("Result.unwrap", BCore(BxResUnwrap)), ("Result.expect", BCore(BxResExpect)),
        ("Str.len", BStr(BsLen)), ("Str.byte", BStr(BsByte)), ("Str.slice", BStr(BsSlice)), ("Str.find", BStr(BsFind)),
        ("Str.find_from", BStr(BsFindFrom)), ("Str.split", BStr(BsSplit)), ("Str.trim", BStr(BsTrim)),
        ("Str.trim_start", BStr(BsTrimStart)), ("Str.trim_end", BStr(BsTrimEnd)), ("Str.starts_with", BStr(BsStartsWith)),
        ("Str.ends_with", BStr(BsEndsWith)), ("Str.to_int", BStr(BsToInt)), ("Str.to_float", BStr(BsToFloat)),
        ("Str.upper", BStr(BsUpper)), ("Str.lower", BStr(BsLower)), ("Str.replace", BStr(BsReplace)),
        ("Str.chars", BStr(BsChars)), ("Str.char_count", BStr(BsCharCount)), ("Str.bytes", BStr(BsBytes)),
        ("Str.from_utf8", BStr(BsFromUtf8)), ("Str.from_utf8_lossy", BStr(BsFromUtf8Lossy)), ("Str.lines", BStr(BsLines)),
        ("Str.words", BStr(BsWords)),
        ("Console.print", BCon(BcPrint)), ("Console.println", BCon(BcPrintln)), ("Console.eprintln", BCon(BcEprintln)),
        ("Console.read_line", BCon(BcReadLine)), ("Console.read_all", BCon(BcReadAll)),
        ("Console.read_all_bytes", BCon(BcReadAllBytes)), ("Console.write_bytes", BCon(BcWriteBytes)),
        ("Console.flush", BCon(BcFlush)), ("Console.read_bytes", BCon(BcReadBytes)),
    ] + icap.table() + iwork.table()
}

fn Bi.effect(self) -> Bool {
    match self {
        BCore(_) => false,
        BStr(_) => false,
        _ => true,
    }
}

// `mut self` builtins.
pub enum MutOp { BmPush, BmPop, BmInsert, BmRemove, BmClear, BmReverse, BmSort, BmSortBy, BmSortByDesc, BmMapInsert, BmMapRemove }

pub fn mut_table() -> List[(Str, MutOp)] {
    [
        ("List.push", BmPush), ("List.pop", BmPop), ("List.insert", BmInsert), ("List.remove", BmRemove),
        ("List.clear", BmClear), ("List.reverse", BmReverse), ("List.sort", BmSort), ("List.sort_by", BmSortBy),
        ("List.sort_by_desc", BmSortByDesc), ("Map.insert", BmMapInsert), ("Map.remove", BmMapRemove),
    ]
}

// The number of each name (its position in the table), for icode.lower.
pub fn numbering[T](table: List[(Str, T)]) -> Map[Str, Int] {
    var m: Map[Str, Int] = [:]
    for i in 0..table.len() { m[table[i].0] = i }
    m
}

fn strs(xs: List[Str]) -> ival.Val {
    var out: List[ival.Val] = []
    for x in xs { out.push(ival.vstr(x)) }
    ival.vlist(out)
}

// The bytes of a List[Int] value; an element outside 0..255 traps.
pub fn list_bytes(l: ival.Val, sp: ckast.Span) -> Result[List[Int], ieval.Ctl] {
    var out: List[Int] = []
    for i in 0..l.xs.len() {
        let v = l.xs[i].i
        if v < 0 or v > 255 { return ieval.trap("byte {v} at index {i} is not in 0..255", sp) }
        out.push(v)
    }
    Ok(out)
}

fn int_list(l: ival.Val) -> List[Int] {
    var out: List[Int] = []
    for x in l.xs { out.push(x.i) }
    out
}

pub fn str_list(l: ival.Val) -> List[Str] {
    var out: List[Str] = []
    for x in l.xs { out.push(x.s) }
    out
}

fn boundary(s: Str, i: Int) -> Bool { i == 0 or i == s.len() or s.byte(i) < 128 or s.byte(i) >= 192 }

fn opt_int(ix: ieval.Ix, o: Option[Int]) -> ival.Val {
    match o {
        Some(x) => ieval.some(ix, ival.vint(x)),
        None => ieval.none(ix),
    }
}

// Call builtin number `id` of `table` (function fi) with arguments a.
pub fn call(it: mut ieval.Interp, id: Int, fi: Int, a: List[ival.Val], sp: ckast.Span) -> Result[ival.Val, ieval.Ctl] {
    if id < 0 { panic("interp: missing builtin {it.fns[fi].name}") }
    let b = it.bis[id]
    it.fty = it.fns[fi].fty
    if it.wk.cur >= 0 and b.effect() { return iwork.logged(mut it, b, a, sp) }
    call_raw(mut it, b, a, sp)
}

pub fn call_raw(it: mut ieval.Interp, b: Bi, a: List[ival.Val], sp: ckast.Span) -> Result[ival.Val, ieval.Ctl] {
    match b {
        BCore(op) => core_op(mut it, op, a, sp),
        BStr(op) => str_op(mut it, op, a, sp),
        BCon(op) => con_op(mut it, op, a, sp),
        BFs(op) => icap.fs_op(mut it, op, a, sp),
        BNet(op) => {
            it.con.flush() // a program about to block has shown all of its output
            Ok(icap.net_op(mut it, op, a))
        }
        BPoll(op) => {
            it.con.flush()
            icap.poller_op(mut it, op, a, sp)
        }
        BSys(op) => icap.sys_op(mut it, op, a, sp),
        BWork(op) => iwork.call(mut it, op, a, sp),
    }
}

// An expression-dispatch `match` (tenon.md: one arm per builtin).
fn core_op(it: mut ieval.Interp, op: CoreOp, a: List[ival.Val], sp: ckast.Span) -> Result[ival.Val, ieval.Ctl] {
    let ix = it.ix
    match op {
        BxPanic => ieval.trap(a[0].s, sp),
        BxAssert => if a[0].i == 0 { ieval.trap("assertion failed", sp) } else { Ok(ival.unit()) },
        BxEncode => {
            var s = ""
            ival.show(mut s, a[0], false, it.names, true)
            Ok(ival.vstr(s))
        }
        BxAddChk => Ok(opt_int(ix, a[0].i.checked_add(a[1].i))),
        BxSubChk => Ok(opt_int(ix, a[0].i.checked_sub(a[1].i))),
        BxMulChk => Ok(opt_int(ix, a[0].i.checked_mul(a[1].i))),
        BxDivChk => Ok(opt_int(ix, a[0].i.checked_div(a[1].i))),
        BxToFloat => Ok(ival.vfloat(a[0].i.to_float())),
        BxChar => {
            let c = a[0].i
            if c < 0 or c > 1114111 or (c >= 55296 and c <= 57343) { return ieval.trap("invalid character code {c}", sp) }
            Ok(ival.vstr(c.char()))
        }
        BxToInt => {
            let x = a[0].f
            if not (x >= -9223372036854775808.0 and x < 9223372036854775808.0) {
                return ieval.trap("float to int conversion out of range", sp)
            }
            Ok(ival.vint(x.to_int()))
        }
        BxSqrt => Ok(ival.vfloat(a[0].f.sqrt())),
        BxFloor => Ok(ival.vfloat(a[0].f.floor())),
        BxCeil => Ok(ival.vfloat(a[0].f.ceil())),
        BxRound => Ok(ival.vfloat(a[0].f.round())),
        BxToFixed => Ok(ival.vstr(a[0].f.to_fixed(a[1].i))),
        BxListLen => Ok(ival.vint(a[0].xs.len())),
        BxListSlice => {
            let n = a[0].xs.len()
            let x = a[1].i
            let y = a[2].i
            if x < 0 or y < x or y > n { return ieval.trap_slice(x, y, n, sp) }
            Ok(ival.vlist(a[0].xs.slice(x, y)))
        }
        BxListJoin => Ok(ival.vstr(str_list(a[0]).join(a[1].s))),
        BxMapLen => Ok(ival.vint(a[0].m.len())),
        BxMapGet => Ok(ieval.opt(ix, a[0].m.get(ival.to_key(a[1])))),
        BxMapKeys => {
            var out: List[ival.Val] = []
            for (k, _) in a[0].m { out.push(ival.from_key(k)) }
            Ok(ival.vlist(out))
        }
        BxMapValues => {
            var out: List[ival.Val] = []
            for (_, v) in a[0].m { out.push(v) }
            Ok(ival.vlist(out))
        }
        BxOptUnwrap => if a[0].j == 0 { Ok(a[0].xs[0]) } else { ieval.trap("unwrap on None", sp) },
        BxOptExpect => if a[0].j == 0 { Ok(a[0].xs[0]) } else { ieval.trap(a[1].s, sp) },
        BxResUnwrap => {
            if a[0].j == 0 { return Ok(a[0].xs[0]) }
            let p = ieval.prerender(mut it, a[0], it.fty)?
            ieval.trap("unwrap on " + ival.show_nested(p, it.names), sp)
        }
        BxResExpect => {
            if a[0].j == 0 { return Ok(a[0].xs[0]) }
            let p = ieval.prerender(mut it, a[0], it.fty)?
            ieval.trap(a[1].s + ": " + ival.show_nested(p.xs[0], it.names), sp)
        }
    }
}

fn con_op(it: mut ieval.Interp, op: ConOp, a: List[ival.Val], sp: ckast.Span) -> Result[ival.Val, ieval.Ctl] {
    let ix = it.ix
    match op {
        BcPrint => {
            it.con.print(a[1].s)
            Ok(ival.unit())
        }
        BcPrintln => {
            it.con.println(a[1].s)
            Ok(ival.unit())
        }
        BcEprintln => {
            it.con.eprintln(a[1].s)
            Ok(ival.unit())
        }
        BcReadLine => {
            match it.con.read_line() {
                Some(l) => Ok(ieval.some(ix, ival.vstr(l))),
                None => Ok(ieval.none(ix)),
            }
        }
        BcReadAll => Ok(ival.vstr(it.con.read_all())),
        BcReadAllBytes => Ok(ival.bytes_val(it.con.read_all_bytes())),
        BcWriteBytes => {
            let b = list_bytes(a[1], sp)?
            it.con.write_bytes(b)
            Ok(ival.unit())
        }
        BcFlush => {
            it.con.flush()
            Ok(ival.unit())
        }
        BcReadBytes => Ok(ival.bytes_val(it.con.read_bytes(a[1].i))),
    }
}

fn str_op(it: mut ieval.Interp, op: StrOp, a: List[ival.Val], sp: ckast.Span) -> Result[ival.Val, ieval.Ctl] {
    let s = a[0].s
    let ix = it.ix
    match op {
        BsLen => Ok(ival.vint(s.len())),
        BsByte => {
            let i = a[1].i
            if i < 0 or i >= s.len() { return ieval.trap_oob(i, s.len(), sp) }
            Ok(ival.vint(s.byte(i)))
        }
        BsSlice => {
            let x = a[1].i
            let y = a[2].i
            if x < 0 or y < x or y > s.len() { return ieval.trap_slice(x, y, s.len(), sp) }
            if not boundary(s, x) or not boundary(s, y) { return ieval.trap("slice [{x}, {y}) is not on a character boundary", sp) }
            Ok(ival.vstr(s.slice(x, y)))
        }
        BsFind => Ok(opt_int(ix, s.find(a[1].s))),
        BsFindFrom => {
            let from = a[2].i
            if from < 0 or from > s.len() { return ieval.trap_oob(from, s.len(), sp) }
            Ok(opt_int(ix, s.find_from(a[1].s, from)))
        }
        BsSplit => {
            if a[1].s.is_empty() { return ieval.trap("split with an empty separator", sp) }
            Ok(strs(s.split(a[1].s)))
        }
        BsTrim => Ok(ival.vstr(s.trim())),
        BsTrimStart => Ok(ival.vstr(s.trim_start())),
        BsTrimEnd => Ok(ival.vstr(s.trim_end())),
        BsStartsWith => Ok(ival.vbool(s.starts_with(a[1].s))),
        BsEndsWith => Ok(ival.vbool(s.ends_with(a[1].s))),
        BsToInt => Ok(opt_int(ix, s.to_int())),
        BsToFloat => match s.to_float() {
            Some(f) => Ok(ieval.some(ix, ival.vfloat(f))),
            None => Ok(ieval.none(ix)),
        },
        BsUpper => Ok(ival.vstr(s.upper())),
        BsLower => Ok(ival.vstr(s.lower())),
        BsReplace => {
            if a[1].s.is_empty() { return ieval.trap("replace with an empty pattern", sp) }
            Ok(ival.vstr(s.replace(a[1].s, a[2].s)))
        }
        BsChars => Ok(strs(s.chars())),
        BsCharCount => Ok(ival.vint(s.char_count())),
        BsBytes => Ok(ival.bytes_val(s.bytes())),
        BsFromUtf8 => {
            for x in a[0].xs {
                if x.i < 0 or x.i > 255 { return Ok(ieval.none(ix)) }
            }
            match Str.from_utf8(int_list(a[0])) {
                Some(t) => Ok(ieval.some(ix, ival.vstr(t))),
                None => Ok(ieval.none(ix)),
            }
        }
        BsFromUtf8Lossy => Ok(ival.vstr(Str.from_utf8_lossy(list_bytes(a[0], sp)?))),
        BsLines => Ok(strs(s.lines())),
        BsWords => Ok(strs(s.words())),
    }
}

// Stable merge sort by the derived ordering of keys[i] (the elements
// themselves for `sort`); a map comparison makes it trap afterwards, as the
// bootstrap's sort does.
fn sorted_order(keys: List[ival.Val], desc: Bool, bad: mut Bool) -> List[Int] {
    let n = keys.len()
    var idx: List[Int] = []
    for i in 0..n { idx.push(i) }
    var width = 1
    while width < n {
        var out: List[Int] = []
        var lo = 0
        while lo < n {
            let mid = (lo + width).min(n)
            let hi = (lo + 2 * width).min(n)
            var i = lo
            var j = mid
            while i < mid or j < hi {
                var take_left = j >= hi
                if not take_left and i < mid {
                    let c = match ival.cmp(keys[idx[j]], keys[idx[i]]) {
                        Ok(c) => c,
                        Err(_) => {
                            bad = true
                            0
                        }
                    }
                    take_left = if desc { c <= 0 } else { c >= 0 }
                }
                if take_left {
                    out.push(idx[i])
                    i += 1
                } else {
                    out.push(idx[j])
                    j += 1
                }
            }
            lo = hi
        }
        idx = out
        width *= 2
    }
    idx
}

// A `mut self` builtin applied to the value at its place.
pub fn mut_op(v: mut ival.Val, op: MutOp, a: List[ival.Val], keys: List[ival.Val], sp: ckast.Span, ix: ieval.Ix) -> Result[ival.Val, ieval.Ctl] {
    match op {
        BmPush => v.xs.push(a[0]),
        BmMapInsert => { v.m[ival.to_key(a[0])] = a[1] }
        BmPop => return match v.xs.pop() {
            Some(x) => Ok(ieval.some(ix, x)),
            None => Ok(ieval.none(ix)),
        },
        BmInsert => {
            let i = a[0].i
            if i < 0 or i > v.xs.len() { return ieval.trap_oob(i, v.xs.len(), sp) }
            v.xs.insert(i, a[1])
        }
        BmRemove => {
            let i = a[0].i
            if i < 0 or i >= v.xs.len() { return ieval.trap_oob(i, v.xs.len(), sp) }
            return Ok(v.xs.remove(i))
        }
        BmClear => v.xs.clear(),
        BmReverse => v.xs.reverse(),
        BmMapRemove => return match v.m.remove(ival.to_key(a[0])) {
            Some(x) => Ok(ieval.some(ix, x)),
            None => Ok(ieval.none(ix)),
        },
        BmSort | BmSortBy | BmSortByDesc => {
            var bad = false
            let ks = if op == BmSort { v.xs } else { keys }
            let order = sorted_order(ks, op == BmSortByDesc, mut bad)
            if bad { return ieval.trap("maps are not ordered", sp) }
            var out: List[ival.Val] = []
            for i in order { out.push(v.xs[i]) }
            v.xs = out
        }
    }
    Ok(ival.unit())
}
