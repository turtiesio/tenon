// module
// The interpreter's code: the checked program (checker.Checked) lowered to a
// tree with every resolution done once. Names become frame slots (a function
// frame holds its parameters, then one slot per name bound in its body; a
// lambda frame holds its captures, its parameters, then its locals), calls
// know their target, and builtins are numbered. The meaning of each node is
// seed/src/interp.rs on the node it was lowered from; compiler/ieval.tn
// evaluates it in the same order.
import ckast
import ckenv
import cktypes
import checker
import ival
import parser

pub enum Node {
    NLit(ival.Val),
    NStr(List[Seg]),
    NLocal(Int),
    NConst(Int, ckast.Span),
    NFnVal(Int),
    NCtorFn(Int, Int),
    NCall(Int, List[Node], ckast.Span, Bool), // function, arguments, call site, sets the prelude call site
    NCallMut(Int, List[Arg], ckast.Span, Bool),
    NDecode(cktypes.Ty, List[Node], ckast.Span, Bool),
    NCtor(Int, Int, List[Node]),
    NApply(Node, List[Node], ckast.Span),
    NToStr(Node, Int), // the value, its type (Code.fmts; -1 unless Names.typed)
    NMutSelf(Int, Place, List[Arg], ckast.Span, Bool),
    NExtMut(Int, Place, List[Node], ckast.Span, Bool),
    NMethodMut(Int, Node, List[Arg], ckast.Span, Bool),
    NField(Node, Int),
    NIndex(Node, Node, ckast.Span, Int), // ..., the key's type (Code.fmts) for the key-not-found trap
    NNeg(Node, ckast.Span),
    NNot(Node),
    NBin(Int, Node, Node, ckast.Span),
    NAnd(Node, Node),
    NOr(Node, Node),
    NIf(Node, List[Stm], Option[Node]),
    NBlock(List[Stm]),
    NMatch(Node, List[IArm]),
    NList(List[Node]),
    NTuple(List[Node]),
    NMapLit(List[(Node, Node)]),
    NNew(Int, Int, List[(Int, Node)], Option[Node]),
    NTry(Node),
    NLambda(Int, List[Int]),
    NDyn(Node, Int),                            // a value and its vtable (Code.vts)
    NDynCall(Int, Node, List[Arg], ckast.Span), // method of the receiver's vtable
}

pub enum Seg { GLit(Str), GShow(Node, Int), GFmt(Node, parser.Spec) } // GShow: the value's type (Code.fmts)

pub enum Arg { AVal(Node), AMut(Place) }

pub enum PStep { PathField(Int), PathIndex(Node, Int) } // PathIndex: the key's type (Code.fmts)
// A place: a frame slot and a path into it; `sp` is where navigation traps.
pub struct Place { pub root: Int, pub steps: List[PStep], pub sp: ckast.Span }

pub enum IPat { BWild, BBind(Int), BInt(Int), BStr(Str), BBool(Bool), BTuple(List[IPat]), BVariant(Int, List[IPat]), BOr(List[IPat]) }

pub struct IArm { pub pat: IPat, pub guard: Option[Node], pub body: Node }

pub enum Stm {
    IExpr(Node),
    ILet(IPat, Node),
    ILetElse(IPat, Node, List[Stm]),
    IAssign(Place, Int, Node, ckast.Span), // place, operator (-1: plain), value, statement span
    IWhile(Node, List[Stm]),
    IForRange(IPat, Node, Node, List[Stm]),
    IForEach(IPat, Node, List[Stm]),
    IReturn(Option[Node]),
    IBreak,
    IContinue,
}

// Binary operators.
pub const OP_ADD: Int = 0
pub const OP_SUB: Int = 1
pub const OP_MUL: Int = 2
pub const OP_DIV: Int = 3
pub const OP_REM: Int = 4
pub const OP_EQ: Int = 5
pub const OP_NE: Int = 6
pub const OP_LT: Int = 7
pub const OP_LE: Int = 8
pub const OP_GT: Int = 9
pub const OP_GE: Int = 10

pub fn op_id(op: Str) -> Int {
    match op {
        "Add" => OP_ADD,
        "Sub" => OP_SUB,
        "Mul" => OP_MUL,
        "Div" => OP_DIV,
        "Rem" => OP_REM,
        "Eq" => OP_EQ,
        "Ne" => OP_NE,
        "Lt" => OP_LT,
        "Le" => OP_LE,
        "Gt" => OP_GT,
        _ => OP_GE,
    }
}

// A function: `ext` is the builtin number of an `extern fn` (-1 otherwise);
// `fty`: an extern instance's first parameter type (Code.fmts), for the
// builtins that format it (Result.unwrap and expect), else -1.
pub struct FnRt { pub name: Str, pub ext: Int, pub nparams: Int, pub nslots: Int, pub body: List[Stm], pub fty: Int }
pub struct LamRt { pub nslots: Int, pub body: Node }

// `vts`: the vtables of `dyn` values, a function per trait method.
// `fmts`, `vt_tys`, `main_ty`: Show impls by type (Names.typed only, else empty and -1).
pub struct Code {
    pub fns: List[FnRt], pub lams: List[LamRt], pub vts: List[List[Int]], pub fmts: List[Fmt], pub vt_tys: List[Int], pub main_ty: Int,
}

// How to format a value of one type when Show impls depend on type
// arguments (`impl Show for Box[Int]`, `impl[T: Hash] Show for Box[T]`: the
// value alone does not say which applies, Names.typed): `show`, the function
// of its Show impl that applies (ckenv.show_impl) or -1; `kids`, the types of
// its parts (struct fields; enum payloads per variant; a list's element; a
// map's key and value; tuple elements); `plain`, no Show impl applies to it
// or to any part (formatted as it is).
pub struct Fmt { pub show: Int, pub kids: List[List[Int]], pub plain: Bool }

// Functions that need their type arguments (bounded by a trait other than
// the derived Eq, Ord, Hash and Show, or a trait's default method) are
// lowered once per instantiation, as the C backend does: `tps`/`tas` is the
// instance being lowered, `insts` the instances (function index in `out`).
struct Cx {
    c: checker.Checked, scope: Map[Str, Int], n: Int, lams: List[LamRt], exts: Map[Str, Int], mexts: Map[Str, Int],
    tps: List[Str], tas: List[cktypes.Ty], needs: List[Bool], insts: Map[(Int, List[cktypes.Ty]), Int],
    queue: List[(Int, List[cktypes.Ty], Int)], out: List[FnRt], vts: List[List[Int]], vt_ix: Map[(Int, cktypes.Ty), Int],
    typed: Bool, fmts: List[Fmt], fmt_ix: Map[cktypes.Ty, Int], vt_tys: List[Int],
}

// Show impls whose use depends on type arguments (a target with type
// arguments): then every generic function is lowered per instantiation, so
// that each place that formats knows the type it formats (Code.fmts).
pub fn typed_shows(env: ckenv.Env) -> Bool {
    env.impls.any(fn(im) => env.is_show(im.tr) and match im.target {
        Con(_, args) => not args.is_empty(),
        _ => false,
    })
}

fn needs_types(env: ckenv.Env, fi: Int) -> Bool {
    let f = env.fns[fi]
    match f.origin {
        ODefault(_, _) => return true,
        _ => {}
    }
    f.bounds.any(fn(bs) => bs.any(fn(b) => not env.is_builtin_trait(b)))
}

// Lower the whole program. `exts` numbers the builtins that take their
// receiver by value, `mexts` the `mut self` ones (compiler/ibuiltin.tn).
pub fn lower(c: checker.Checked, exts: Map[Str, Int], mexts: Map[Str, Int]) -> Code {
    let n = c.prog.fns.len()
    let typed = typed_shows(c.env)
    var needs: List[Bool] = []
    for fi in 0..n { needs.push(needs_types(c.env, fi) or (typed and not c.env.fns[fi].tparams.is_empty())) }
    var cx = Cx {
        c, scope: [:], n: 0, lams: [], exts, mexts, tps: [], tas: [], needs, insts: [:], queue: [], out: [], vts: [],
        vt_ix: [:], typed, fmts: [], fmt_ix: [:], vt_tys: [],
    }
    let main_ty = if typed { cx.fmt_ty(c.env.fns[c.main].ret) } else { -1 }
    for fi in 0..n { cx.out.push(cx.stub(fi)) }
    for fi in 0..n {
        if not cx.needs[fi] { cx.out[fi] = cx.function(fi) }
    }
    while let Some(job) = cx.queue.pop() {
        cx.tps = cx.c.env.fns[job.0].tparams
        cx.tas = job.1
        cx.out[job.2] = cx.function(job.0)
    }
    if typed { cx.mark_plain() }
    Code { fns: cx.out, lams: cx.lams, vts: cx.vts, fmts: cx.fmts, vt_tys: cx.vt_tys, main_ty }
}

// The format plan (Code.fmts) of type t as written in the code being lowered; -1 unless typed.
fn Cx.fmt_ty(mut self, t0: cktypes.Ty) -> Int {
    if not self.typed { return -1 }
    let t = self.st(t0)
    match self.fmt_ix.get(t) {
        Some(i) => return i,
        None => {}
    }
    let i = self.fmts.len()
    self.fmts.push(Fmt { show: -1, kids: [], plain: true })
    self.fmt_ix[t] = i
    let env = self.c.env
    if env.dyn_trait(t).is_some() {
        // the value inside has its own type (Code.vt_tys)
        self.fmts[i] = Fmt { show: -1, kids: [], plain: false }
        return i
    }
    match env.show_impl(t, [:]) {
        Some((ii, ts)) => {
            let f = self.target(env.impls[ii].fns[0], ts)
            self.fmts[i] = Fmt { show: f, kids: [], plain: false }
            return i
        }
        None => {}
    }
    var parts: List[List[cktypes.Ty]] = []
    match t {
        Tup(ts) => parts = [ts],
        Con(n, args) => match env.struct_fields(t) {
            Some(fs) => parts = [fs.map(fn(f) => f.1)],
            None => match env.enum_variants(t) {
                Some(vs) => parts = vs.map(fn(v) => v.1),
                None => if n == "List" or n == "Map" { parts = [args] },
            },
        },
        _ => {}
    }
    var kids: List[List[Int]] = []
    for ps in parts {
        var ks: List[Int] = []
        for p in ps { ks.push(self.fmt_ty(p)) }
        kids.push(ks)
    }
    self.fmts[i] = Fmt { show: -1, kids, plain: true }
    i
}

// A plan is plain when no part has a Show impl (to the fixpoint: recursive types).
fn Cx.mark_plain(mut self) {
    var changed = true
    while changed {
        changed = false
        for i in 0..self.fmts.len() {
            let f = self.fmts[i]
            if f.plain and f.kids.any(fn(ks) => ks.any(fn(k) => not self.fmts[k].plain)) {
                self.fmts[i] = Fmt { plain: false, ..f }
                changed = true
            }
        }
    }
}

fn Cx.stub(self, fi: Int) -> FnRt {
    let info = self.c.env.fns[fi]
    FnRt { name: info.name, ext: -1, nparams: info.params.len(), nslots: info.params.len(), body: [], fty: -1 }
}

fn Cx.st(self, t: cktypes.Ty) -> cktypes.Ty { t.subst(self.tps, self.tas) }

// The function to call for function fi at type arguments targs (as written in the code being lowered).
fn Cx.target(mut self, fi: Int, targs: List[cktypes.Ty]) -> Int {
    if not self.needs[fi] { return fi }
    let ts = targs.map(fn(t) => self.st(t))
    let open = ts.any(fn(t) => ckenv.deeper(t, 48) or t.any(fn(x) => match x {
        Par(_) => true,
        _ => false,
    }))
    if self.typed and open and not needs_types(self.c.env, fi) {
        // polymorphic recursion in a function lowered per instantiation only
        // for Show (the C backend refuses to build it): one generic copy, as
        // without typed Show impls, where formatting a type parameter applies
        // no impl; calls from it (type arguments with parameters) stay in it
        let ps = self.c.env.fns[fi].tparams.map(fn(p) => cktypes.Ty.Par(p))
        if not self.insts.contains((fi, ps)) {
            self.insts[(fi, ps)] = fi
            self.queue.push((fi, ps, fi))
        }
        return fi
    }
    match self.insts.get((fi, ts)) {
        Some(i) => return i,
        None => {}
    }
    let i = self.out.len()
    self.out.push(self.stub(fi))
    self.insts[(fi, ts)] = i
    self.queue.push((fi, ts, i))
    i
}

// The vtable of trait tr for values of type v.
fn Cx.vtable(mut self, tr: Int, v: cktypes.Ty) -> Int {
    match self.vt_ix.get((tr, v)) {
        Some(i) => return i,
        None => {}
    }
    var fs: List[Int] = []
    if not self.c.env.is_builtin_trait(tr) {
        for mi in 0..self.c.env.traits[tr].methods.len() {
            match self.c.env.method_for(tr, mi, v, []) {
                Some((fi, targs)) => fs.push(self.target(fi, targs)),
                None => panic("interp: no impl of " + self.c.env.traits[tr].name + " for " + v.show()),
            }
        }
    }
    let i = self.vts.len()
    self.vts.push(fs)
    let vty = self.fmt_ty(v)
    self.vt_tys.push(vty)
    self.vt_ix[(tr, v)] = i
    i
}

fn Cx.function(mut self, fi: Int) -> FnRt {
    let info = self.c.env.fns[fi]
    let np = info.params.len()
    if info.is_extern {
        let fty = if np > 0 and (info.name == "Result.unwrap" or info.name == "Result.expect") { self.fmt_ty(info.params[0].1) } else { -1 }
        return FnRt { name: info.name, ext: self.exts.get(info.name).unwrap_or(-2), nparams: np, nslots: np, body: [], fty }
    }
    self.scope = [:]
    self.n = 0
    for p in info.params { let _ = self.bind(p.0) }
    let body = match self.c.prog.fns[fi].body {
        Some(b) => self.block(b),
        None => [],
    }
    FnRt { name: info.name, ext: -1, nparams: np, nslots: self.n, body, fty: -1 }
}

fn Cx.bind(mut self, n: Str) -> Int {
    // The checker forbids shadowing, so a name already in scope here was bound
    // by an earlier alternative of the same `|` pattern: share its slot.
    match self.scope.get(n) {
        Some(s) => return s,
        None => {}
    }
    self.scope[n] = self.n
    self.n += 1
    self.n - 1
}

fn Cx.slot(self, n: Str) -> Int {
    match self.scope.get(n) {
        Some(s) => s,
        None => panic("interp: unbound local {n}"),
    }
}

fn Cx.block(mut self, b: ckast.Block) -> List[Stm] {
    let saved = self.scope
    var out: List[Stm] = []
    for s in b.stmts { out.push(self.stmt(s)) }
    self.scope = saved
    out
}

fn Cx.stmt(mut self, s: ckast.Stmt) -> Stm {
    match s.k {
        KLet(p, _, _, v, els) => {
            let value = self.expr(v)
            match els {
                Some(b) => {
                    let eb = self.block(b)
                    ILetElse(self.pat(p), value, eb)
                }
                None => ILet(self.pat(p), value),
            }
        }
        KExpr(e) => IExpr(self.expr(e)),
        KAssign(t, op, v) => {
            let pl = self.place(t)
            let value = self.expr(v)
            let o = match op {
                Some(x) => op_id(x),
                None => -1,
            }
            IAssign(pl, o, value, s.sp)
        }
        KWhile(c, b) => {
            let cond = self.expr(c)
            IWhile(cond, self.block(b))
        }
        KFor(p, it, b) => {
            match it {
                FRange(lo, hi) => {
                    let a = self.expr(lo)
                    let z = self.expr(hi)
                    let saved = self.scope
                    let ip = self.pat(p)
                    let body = self.block(b)
                    self.scope = saved
                    IForRange(ip, a, z, body)
                }
                FEach(x) => {
                    let e = self.expr(x)
                    let saved = self.scope
                    let ip = self.pat(p)
                    let body = self.block(b)
                    self.scope = saved
                    IForEach(ip, e, body)
                }
            }
        }
        KReturn(e) => match e {
            Some(x) => IReturn(Some(self.expr(x))),
            None => IReturn(None),
        },
        KBreak => IBreak,
        KContinue => IContinue,
    }
}

fn Cx.pats(mut self, ps: List[ckast.Pat]) -> List[IPat] {
    var out: List[IPat] = []
    for p in ps { out.push(self.pat(p)) }
    out
}

fn Cx.pat(mut self, p: ckast.Pat) -> IPat {
    match p.k {
        QWild => BWild,
        QBind(n) => if n == "_" { BWild } else { BBind(self.bind(n)) },
        QInt(i) => BInt(i),
        QStr(s) => BStr(s),
        QBool(b) => BBool(b),
        QTuple(ps) => BTuple(self.pats(ps)),
        QVariant(_, _, ps) => {
            let vi = match self.c.res.get(p.id) {
                Some(RVariant(_, v, _)) => v,
                _ => panic("interp: unresolved variant pattern"),
            }
            BVariant(vi, self.pats(ps))
        }
        QOr(alts) => BOr(self.pats(alts)),
    }
}

fn Cx.exprs(mut self, es: List[ckast.Expr]) -> List[Node] {
    var out: List[Node] = []
    for e in es { out.push(self.expr(e)) }
    out
}

fn Cx.args(mut self, es: List[ckast.Expr]) -> List[Arg] {
    var out: List[Arg] = []
    for e in es {
        match e.k {
            XMutArg(inner) => {
                let pl = self.place(inner)
                out.push(AMut(Place { root: pl.root, steps: pl.steps, sp: e.sp }))
            }
            _ => out.push(AVal(self.expr(e))),
        }
    }
    out
}

fn Cx.place(mut self, e: ckast.Expr) -> Place {
    match e.k {
        XName(n) => Place { root: self.slot(n), steps: [], sp: e.sp },
        XField(b, _) => {
            let base = self.place(b)
            let i = match self.c.res.get(e.id) {
                Some(RField(i)) => i,
                _ => panic("interp: unresolved field"),
            }
            Place { root: base.root, steps: base.steps + [PathField(i)], sp: e.sp }
        }
        XTField(b, i) => {
            let base = self.place(b)
            Place { root: base.root, steps: base.steps + [PathField(i)], sp: e.sp }
        }
        XIndex(b, i) => {
            let base = self.place(b)
            let ix = self.expr(i)
            let kt = self.fmt_ty(self.c.types[i.id])
            Place { root: base.root, steps: base.steps + [PathIndex(ix, kt)], sp: e.sp }
        }
        _ => panic("interp: not a place"),
    }
}

// The prelude call site rule (seed/src/interp.rs `user_site`): a call
// from user code into a prelude function records where it was made.
fn Cx.into_prelude(self, fi: Int, sp: ckast.Span) -> Bool { self.c.env.fns[fi].sp.file == 0 and sp.file != 0 }

// An expression-dispatch match (one arm per expression kind; the long ones
// are methods below).
fn Cx.expr(mut self, e: ckast.Expr) -> Node {
    match e.k {
        XInt(i) => NLit(ival.vint(i)),
        XFloat(f) => NLit(ival.vfloat(f)),
        XBool(b) => NLit(ival.vbool(b)),
        XUnit => NLit(ival.unit()),
        XStr(xs, lits) => self.str_node(e, xs, lits),
        XName(_) | XPath(_, _) => self.name(e),
        XField(b, _) => {
            let i = match self.c.res.get(e.id) {
                Some(RField(i)) => i,
                _ => panic("interp: unresolved field"),
            }
            NField(self.expr(b), i)
        }
        XTField(b, i) => NField(self.expr(b), i),
        XIndex(a, b) => {
            let x = self.expr(a)
            let k = self.expr(b)
            NIndex(x, k, e.sp, self.fmt_ty(self.c.types[b.id]))
        }
        XCall(callee, args) => self.call(e, callee, args),
        XMethod(recv, _, args) => self.method(e, recv, args),
        XUnary(op, x) => if op == "neg" { NNeg(self.expr(x), e.sp) } else { NNot(self.expr(x)) },
        XBinary(op, l, r) => {
            let a = self.expr(l)
            let b = self.expr(r)
            if op == "And" { NAnd(a, b) } else if op == "Or" { NOr(a, b) } else { NBin(op_id(op), a, b, e.sp) }
        }
        XIf(c, t, els) => {
            let cond = self.expr(c)
            let then = self.block(t)
            match els {
                Some(x) => NIf(cond, then, Some(self.expr(x))),
                None => NIf(cond, then, None),
            }
        }
        XMatch(s, arms) => self.match_node(e, s, arms),
        XBlock(b) => NBlock(self.block(b)),
        XList(xs) => NList(self.exprs(xs)),
        XTuple(xs) => NTuple(self.exprs(xs)),
        XMap(ps) => {
            var out: List[(Node, Node)] = []
            for kv in ps {
                let k = self.expr(kv.0)
                out.push((k, self.expr(kv.1)))
            }
            NMapLit(out)
        }
        XNew(_, fields, base) => self.struct_node(e, fields, base),
        XTry(x) => NTry(self.expr(x)),
        XLambda(params, _, body) => self.lambda_node(e, params, body),
        XMutArg(_) => panic("interp: mut arguments are handled at calls"),
        XFmt(_, _) => panic("interp: format specs are handled in strings"),
        XDyn(_, x) => {
            let xt = self.st(self.c.types[x.id])
            let t = self.st(self.c.types[e.id])
            let v = self.expr(x)
            if xt == t { return v }
            let tr = self.c.env.dyn_trait(t).unwrap()
            NDyn(v, self.vtable(tr, xt))
        }
    }
}

fn Cx.str_node(mut self, e: ckast.Expr, xs: List[ckast.Expr], lits: List[Option[Str]]) -> Node {
    var segs: List[Seg] = []
    var k = 0
    var all_lit = true
    var text = ""
    for l in lits {
        match l {
            Some(s) => {
                segs.push(GLit(s))
                text += s
            }
            None => {
                all_lit = false
                match xs[k].k {
                    XFmt(inner, f) => segs.push(GFmt(self.expr(inner), f)),
                    _ => {
                        let x = self.expr(xs[k])
                        segs.push(GShow(x, self.fmt_ty(self.c.types[xs[k].id])))
                    }
                }
                k += 1
            }
        }
    }
    if all_lit { NLit(ival.vstr(text)) } else { NStr(segs) }
}

fn Cx.match_node(mut self, e: ckast.Expr, s: ckast.Expr, arms: List[ckast.Arm]) -> Node {
    let scrut = self.expr(s)
    var out: List[IArm] = []
    for a in arms {
        let saved = self.scope
        let pat = self.pat(a.pat)
        let guard = match a.guard {
            Some(g) => Some(self.expr(g)),
            None => None,
        }
        let body = self.expr(a.body)
        self.scope = saved
        out.push(IArm { pat, guard, body })
    }
    NMatch(scrut, out)
}

fn Cx.struct_node(mut self, e: ckast.Expr, fields: List[(Str, ckast.Expr)], base: Option[ckast.Expr]) -> Node {
    let si = match self.c.res.get(e.id) {
        Some(RStruct(i)) => i,
        _ => panic("interp: unresolved struct literal"),
    }
    let decl = self.c.env.structs[si]
    var given: List[(Int, Node)] = []
    for f in fields {
        var i = 0
        while decl.fields[i].0 != f.0 { i += 1 }
        given.push((i, self.expr(f.1)))
    }
    match base {
        Some(b) => NNew(si, decl.fields.len(), given, Some(self.expr(b))),
        None => NNew(si, decl.fields.len(), given, None),
    }
}

fn Cx.lambda_node(mut self, e: ckast.Expr, params: List[(Str, Option[ckast.TExpr])], body: ckast.Expr) -> Node {
    let caps = self.c.captures.get(e.id).unwrap_or([])
    var cap_slots: List[Int] = []
    for c in caps { cap_slots.push(self.slot(c.0)) }
    let li = self.lams.len()
    self.lams.push(LamRt { nslots: 0, body: NLit(ival.unit()) })
    let saved_scope = self.scope
    let saved_n = self.n
    self.scope = [:]
    self.n = 0
    for c in caps { let _ = self.bind(c.0) }
    for p in params {
        // parameters always get their own slot (they follow the captures)
        self.scope[p.0] = self.n
        self.n += 1
    }
    let b = self.expr(body)
    self.lams[li] = LamRt { nslots: self.n, body: b }
    self.scope = saved_scope
    self.n = saved_n
    NLambda(li, cap_slots)
}

fn Cx.name(mut self, e: ckast.Expr) -> Node {
    match self.c.res.get(e.id) {
        Some(RLocal(n)) => NLocal(self.slot(n)),
        Some(RConst(fi)) => NConst(fi, e.sp),
        Some(RFn(fi, targs)) => NFnVal(self.target(fi, targs)),
        Some(RVariant(ei, vi, _)) => {
            if self.c.env.enums[ei].variants[vi].1.is_empty() { NLit(ival.venum(ei, vi, [])) } else { NCtorFn(ei, vi) }
        }
        _ => panic("interp: unresolved name"),
    }
}

fn Cx.call(mut self, e: ckast.Expr, callee: ckast.Expr, args: List[ckast.Expr]) -> Node {
    let site = match self.c.res.get(callee.id) {
        Some(RFn(fi, _)) => self.into_prelude(fi, e.sp),
        _ => false,
    }
    match self.c.res.get(e.id) {
        Some(RCallValue) => {
            let f = self.expr(callee)
            return NApply(f, self.exprs(args), e.sp)
        }
        _ => {}
    }
    match self.c.res.get(callee.id) {
        Some(RFn(fi0, targs)) => {
            let info = self.c.env.fns[fi0]
            if info.name == "decode" { return NDecode(self.st(targs[0]), self.exprs(args), e.sp, site) }
            let fi = self.target(fi0, targs)
            if info.muts.any(fn(b) => b) { return NCallMut(fi, self.args(args), e.sp, site) }
            NCall(fi, self.exprs(args), e.sp, site)
        }
        Some(RVariant(ei, vi, _)) => NCtor(ei, vi, self.exprs(args)),
        _ => {
            let f = self.expr(callee)
            NApply(f, self.exprs(args), e.sp)
        }
    }
}

fn Cx.method(mut self, e: ckast.Expr, recv: ckast.Expr, args: List[ckast.Expr]) -> Node {
    match self.c.res.get(e.id) {
        Some(RToStr) => {
            let r = self.expr(recv)
            NToStr(r, self.fmt_ty(self.c.types[recv.id]))
        }
        Some(RMethod(fi, targs)) => self.method_fn(e, recv, args, fi, targs),
        Some(RTrait(tr, mi, rt0, mt)) => {
            let rt = self.st(rt0)
            if self.c.env.dyn_trait(rt).is_some() {
                let r = self.expr(recv)
                return NDynCall(mi, r, self.args(args), e.sp)
            }
            match self.c.env.method_for(tr, mi, rt, mt.map(fn(t) => self.st(t))) {
                Some((fi, targs)) => self.method_fn(e, recv, args, fi, targs),
                None => panic("interp: no impl of " + self.c.env.traits[tr].name + " for " + rt.show()),
            }
        }
        _ => panic("interp: unresolved method"),
    }
}

fn Cx.method_fn(mut self, e: ckast.Expr, recv: ckast.Expr, args: List[ckast.Expr], fi0: Int, targs: List[cktypes.Ty]) -> Node {
    let info = self.c.env.fns[fi0]
    let fi = self.target(fi0, targs)
    let site = self.into_prelude(fi0, e.sp)
    if info.self_kind == MutSelf {
        let pl = self.place(recv)
        if info.is_extern {
            let id = self.mexts.get(info.name).unwrap_or(-2)
            return NExtMut(id, pl, self.exprs(args), e.sp, site)
        }
        return NMutSelf(fi, pl, self.args(args), e.sp, site)
    }
    let r = self.expr(recv)
    if info.muts.any(fn(b) => b) { return NMethodMut(fi, r, self.args(args), e.sp, site) }
    NCall(fi, [r] + self.exprs(args), e.sp, site)
}
