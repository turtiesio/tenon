// module
// The evaluator: a port of seed/src/interp.rs over the lowered code of
// compiler/icode.tn. Every rule that is visible to a program follows the
// bootstrap: evaluation order, `mut` arguments taken out of their places and
// written back after the call, where traps are reported (the last call from
// user code into the prelude, for traps inside the prelude), the depth limit.
import ckast
import checker
import icode
import ival
import ibuiltin
import icap
import icodec
import iwork

pub const MAX_DEPTH: Int = 20000
pub const EXIT_TRAP: Int = 70
pub const EXIT_STACK: Int = 72
pub const EXIT_OUTPUT: Int = 74

// How evaluation leaves an expression early.
// CNoKey: a missing map key in a place (nav), turned into the trap by nk
// with the key type's Show impl applied. CBlock: a worker would wait; it is
// suspended (compiler/iwork.tn).
pub enum Ctl { CRet(ival.Val), CBreak, CContinue, CTrap(Str, ckast.Span), CExit(Int), CNoKey(ival.Val, Int, ckast.Span), CBlock }

// Enum numbers the interpreter builds values of.
pub struct Ix { pub opt: Int, pub res: Int, pub io: Int, pub ev: Int }

// The interpreter's state. It owns the event-loop handles the program's
// sockets live in (compiler/icap.tn), so it is unique.
pub unique struct Interp {
    pub fns: List[icode.FnRt], pub lams: List[icode.LamRt], pub vts: List[List[Int]], pub names: ival.Names, pub ix: Ix,
    pub fmts: List[icode.Fmt], pub vt_tys: List[Int], pub fty: Int, // Show by type (icode.Code); the extern being called's FnRt.fty
    pub files: List[Str], pub site: ckast.Span, pub depth: Int,
    pub checked: checker.Checked,
    pub con: Console, pub clock: Clock, pub net: Net, pub proc: Proc, pub fss: List[Fs],
    pub net_state: icap.NetState,
    pub bp: Poller, pub pp0: Poller, pub pp1: Poller, pub pp2: Poller, pub pp3: Poller,
    pub wk: iwork.Sched,
    pub bis: List[ibuiltin.Bi], pub mbis: List[ibuiltin.MutOp], // the builtins numbered by icode.lower
    pub held: List[Int],                                        // the running frame's slots that may hold a socket (icode.FnRt.held)
}

pub fn trap[T](msg: Str, sp: ckast.Span) -> Result[T, Ctl] { Err(CTrap(msg, sp)) }
// The traps of a bad index and a bad slice, as the C runtime words them.
pub fn trap_oob[T](i: Int, n: Int, sp: ckast.Span) -> Result[T, Ctl] { trap("index {i} out of bounds for length {n}", sp) }
pub fn trap_slice[T](x: Int, y: Int, n: Int, sp: ckast.Span) -> Result[T, Ctl] { trap("slice [{x}, {y}) out of bounds for length {n}", sp) }

pub fn some(ix: Ix, v: ival.Val) -> ival.Val { ival.venum(ix.opt, 0, [v]) }
pub fn none(ix: Ix) -> ival.Val { ival.venum(ix.opt, 1, []) }
pub fn opt(ix: Ix, v: Option[ival.Val]) -> ival.Val {
    match v {
        Some(x) => some(ix, x),
        None => none(ix),
    }
}
pub fn ok(ix: Ix, v: ival.Val) -> ival.Val { ival.venum(ix.res, 0, [v]) }
pub fn err(ix: Ix, v: ival.Val) -> ival.Val { ival.venum(ix.res, 1, [v]) }

pub fn loc(it: mut Interp, sp: ckast.Span) -> Str { "{it.files[sp.file]}:{sp.line}:{sp.col}" }

fn overflow[T](it: mut Interp) -> Result[T, Ctl] {
    it.con.eprintln("trap: stack overflow")
    Err(CExit(EXIT_STACK))
}

// ---- calls ----

// Call function fi with the arguments in `fr`, which becomes its frame: after
// the call, fr[0..nparams] are the final values of the parameters (for `mut`
// parameters and `mut self`, which the caller writes back).
pub fn call_fn(it: mut Interp, fi: Int, fr: mut List[ival.Val], sp: ckast.Span) -> Result[ival.Val, Ctl] {
    let ext = it.fns[fi].ext
    if ext != -1 { return ibuiltin.call(mut it, ext, fi, fr, sp) }
    if it.depth >= MAX_DEPTH { return overflow(mut it) }
    let ns = it.fns[fi].nslots
    while fr.len() < ns { fr.push(ival.unit()) }
    let body = it.fns[fi].body
    let held = it.held
    it.held = it.fns[fi].held
    it.depth += 1
    let r = block(mut it, mut fr, body)
    it.depth -= 1
    it.held = held
    match r {
        Ok(v) => Ok(v),
        Err(CRet(v)) => Ok(v),
        Err(c) => Err(c),
    }
}

// ---- dropping sockets (compiler/icap.tn) ----

// The Listener and Conn ids inside v. Lists, maps, closures and `dyn` values
// cannot hold them (the checker), so only structs, enums and tuples are entered.
fn sock_ids(v: ival.Val, out: mut List[Int]) {
    if v.k == ival.K_CAP {
        if v.i == ival.CAP_LISTENER or v.i == ival.CAP_CONN { out.push(v.j) }
    } else if v.k == ival.K_STRUCT or v.k == ival.K_ENUM or v.k == ival.K_TUPLE {
        for x in v.xs { sock_ids(x, mut out) }
    }
}

// The values `gone` end: close every socket in them that nothing else holds.
// As in the C backend, which counts references, a socket lives while a
// variable, a temporary or a value holds it: here, a slot of the running frame
// (it.held: a value moved from a variable is still held by it until its scope
// ends, as in C), `kept` (the value being produced), or a caller's frame,
// which reaches this one only through parameters (which are in it.held).
pub fn release(it: mut Interp, fr: List[ival.Val], gone: List[ival.Val], kept: List[ival.Val]) {
    if it.net_state.open.is_empty() { return }
    var ids: List[Int] = []
    for v in gone { sock_ids(v, mut ids) }
    if ids.is_empty() { return }
    var keep: List[Int] = []
    for v in kept { sock_ids(v, mut keep) }
    for s in it.held { sock_ids(fr[s], mut keep) }
    for id in ids {
        if not keep.contains(id) { icap.close_sock(mut it, id) }
    }
}

// A block whose own slots end with it (icode.NScope). Not when a worker is
// suspended (CBlock: it runs again from the start) or the program stops.
fn scope(it: mut Interp, fr: mut List[ival.Val], ss: List[icode.Stm], mine: List[Int]) -> Result[ival.Val, Ctl] {
    let r = block(mut it, mut fr, ss)
    if it.net_state.open.is_empty() { return r }
    let result = match r {
        Ok(v) => [v],
        Err(CRet(v)) => [v],
        Err(CBreak) | Err(CContinue) => [],
        _ => return r,
    }
    let gone = mine.map(fn(s) => fr[s])
    for s in mine { fr[s] = ival.unit() }
    release(mut it, fr, gone, result)
    r
}

// Call a function value.
pub fn apply(it: mut Interp, f: ival.Val, args: List[ival.Val], sp: ckast.Span) -> Result[ival.Val, Ctl] {
    if f.k == ival.K_FNAMED {
        var av = args
        return call_fn(mut it, f.j, mut av, sp)
    }
    if f.k == ival.K_FCTOR { return Ok(ival.venum(f.i, f.j, args)) }
    if it.depth >= MAX_DEPTH { return overflow(mut it) }
    var fr = f.xs + args
    let ns = it.lams[f.j].nslots
    while fr.len() < ns { fr.push(ival.unit()) }
    let body = it.lams[f.j].body
    let held = it.held
    it.held = it.lams[f.j].held
    it.depth += 1
    let r = ev(mut it, mut fr, body)
    it.depth -= 1
    it.held = held
    match r {
        Ok(v) => Ok(v),
        Err(CRet(v)) => Ok(v),
        Err(c) => Err(c),
    }
}

// ---- Show impls ----

// v with every part whose type has a Show impl replaced by that impl's text
// (K_RAW), for formatting; the identity when the program has no Show impls.
// `ty`: v's type (icode.Code.fmts) when the impls depend on type arguments
// (Names.typed), else -1: then the impls are found by declaration.
pub fn prerender(it: mut Interp, v: ival.Val, ty: Int) -> Result[ival.Val, Ctl] {
    if it.names.typed { return if ty < 0 { Ok(v) } else { render_typed(mut it, v, ty) } }
    if it.names.ovs.is_empty() { return Ok(v) }
    render(mut it, v)
}

fn render_typed(it: mut Interp, v: ival.Val, ty: Int) -> Result[ival.Val, Ctl] {
    let f = it.fmts[ty]
    if f.plain { return Ok(v) }
    if f.show >= 0 {
        var av = [v]
        let s = call_fn(mut it, f.show, mut av, ckast.Span { file: 0, line: 0, col: 0 })?
        return Ok(ival.Val { k: ival.K_RAW, s: s.s, ..ival.unit() })
    }
    let k = v.k
    if k == ival.K_DYN { return render_typed(mut it, v.xs[0], it.vt_tys[v.i]) }
    if k == ival.K_MAP {
        if v.m.len() == 0 { return Ok(v) }
        var xs: List[ival.Val] = []
        for (key, x) in v.m {
            xs.push(render_typed(mut it, ival.from_key(key), f.kids[0][0])?)
            xs.push(render_typed(mut it, x, f.kids[0][1])?)
        }
        return Ok(ival.Val { k: ival.K_MAPV, xs, ..ival.unit() })
    }
    if v.xs.is_empty() or not (k == ival.K_STRUCT or k == ival.K_ENUM or k == ival.K_LIST or k == ival.K_TUPLE) { return Ok(v) }
    let ks = if k == ival.K_ENUM { f.kids[v.j] } else { f.kids[0] }
    var out: List[ival.Val] = []
    for i in 0..v.xs.len() { out.push(render_typed(mut it, v.xs[i], if k == ival.K_LIST { ks[0] } else { ks[i] })?) }
    Ok(ival.Val { xs: out, ..v })
}

fn render_all(it: mut Interp, xs: List[ival.Val]) -> Result[List[ival.Val], Ctl] {
    var out: List[ival.Val] = []
    for x in xs { out.push(render(mut it, x)?) }
    Ok(out)
}

fn render(it: mut Interp, v: ival.Val) -> Result[ival.Val, Ctl] {
    let k = v.k
    if k == ival.K_STRUCT or k == ival.K_ENUM {
        match it.names.ovs.get((if k == ival.K_STRUCT { 0 } else { 1 }, v.i)) {
            Some(fi) => {
                var av = [v]
                let s = call_fn(mut it, fi, mut av, ckast.Span { file: 0, line: 0, col: 0 })?
                return Ok(ival.Val { k: ival.K_RAW, s: s.s, ..ival.unit() })
            }
            None => {}
        }
    }
    if k == ival.K_STRUCT or k == ival.K_ENUM or k == ival.K_LIST or k == ival.K_TUPLE {
        if v.xs.is_empty() { return Ok(v) }
        return Ok(ival.Val { xs: render_all(mut it, v.xs)?, ..v })
    }
    if k == ival.K_DYN { return render(mut it, v.xs[0]) }
    if k == ival.K_MAP and v.m.len() > 0 {
        var xs: List[ival.Val] = []
        for (key, x) in v.m {
            xs.push(render(mut it, ival.from_key(key))?)
            xs.push(render(mut it, x)?)
        }
        return Ok(ival.Val { k: ival.K_MAPV, xs, ..ival.unit() })
    }
    Ok(v)
}

// A `mut` argument's place, its path evaluated, and where it is in the arguments.
struct Taken { at: Int, root: Int, steps: List[RStep], sp: ckast.Span }

// Evaluate arguments into av; `mut place` arguments are taken out of their
// places (left as unit) after all the others are evaluated.
fn args_mut(it: mut Interp, fr: mut List[ival.Val], args: List[icode.Arg], av: mut List[ival.Val], taken: mut List[Taken]) -> Result[Unit, Ctl] {
    for a in args {
        match a {
            AMut(pl) => {
                let steps = eval_steps(mut it, mut fr, pl.steps)?
                taken.push(Taken { at: av.len(), root: pl.root, steps, sp: pl.sp })
                av.push(ival.unit())
            }
            AVal(e) => av.push(ev(mut it, mut fr, e)?),
        }
    }
    for t in taken { av[t.at] = nk(mut it, nav(mut fr[t.root], t.steps, 0, false, MTake, t.sp, it.names, it.ix))? }
    Ok(())
}

fn put_back(it: mut Interp, fr: mut List[ival.Val], taken: List[Taken], finals: List[ival.Val], sp: ckast.Span) -> Result[Unit, Ctl] {
    for t in taken { let _ = nk(mut it, nav(mut fr[t.root], t.steps, 0, false, MSet(finals[t.at]), sp, it.names, it.ix))? }
    Ok(())
}

// ---- places ----

pub enum RStep { RsField(Int), RsIdx(ival.Val, Int) } // RsIdx: the key, its type (icode.PathIndex)

// What to do at the end of a path.
pub enum MOp {
    MGet,
    MCheck,
    MSet(ival.Val),
    MTake,
    MBin(Int, ival.Val, ckast.Span),
    MExt(ibuiltin.MutOp, List[ival.Val], List[ival.Val]), // builtin `mut self` method, arguments, sort keys
}

fn eval_steps(it: mut Interp, fr: mut List[ival.Val], steps: List[icode.PStep]) -> Result[List[RStep], Ctl] {
    var out: List[RStep] = []
    for s in steps {
        match s {
            PathField(f) => out.push(RsField(f)),
            PathIndex(e, kt) => out.push(RsIdx(ev(mut it, mut fr, e)?, kt)),
        }
    }
    Ok(out)
}

// A missing key from nav, shown with the key type's Show impl (as C does).
fn nk[T](it: mut Interp, r: Result[T, Ctl]) -> Result[T, Ctl] {
    match r {
        Err(CNoKey(k, kt, at)) => {
            let shown = prerender(mut it, k, kt)?
            trap("key not found: " + ival.show_nested(shown, it.names), at)
        }
        _ => r,
    }
}

// Follow `steps` from v (seed/src/interp.rs `navigate`); `create`: a
// missing map key at the end of the path is inserted (assignment `m[k] = v`).
pub fn nav(v: mut ival.Val, steps: List[RStep], i: Int, create: Bool, op: MOp, sp: ckast.Span, names: ival.Names, ix: Ix) -> Result[ival.Val, Ctl] {
    if i == steps.len() { return leaf(mut v, op, sp, names, ix) }
    match steps[i] {
        RsField(f) => nav(mut v.xs[f], steps, i + 1, create, op, sp, names, ix),
        RsIdx(k, kt) => {
            if v.k == ival.K_LIST {
                let n = v.xs.len()
                if k.i < 0 or k.i >= n { return trap_oob(k.i, n, sp) }
                return nav(mut v.xs[k.i], steps, i + 1, create, op, sp, names, ix)
            }
            let key = ival.to_key(k)
            if not v.m.contains(key) {
                if not (create and i + 1 == steps.len()) {
                    if names.shows() { return Err(CNoKey(k, kt, sp)) }
                    return trap("key not found: " + ival.show_nested(k, names), sp)
                }
                v.m[key] = ival.unit()
            }
            nav(mut v.m[key], steps, i + 1, create, op, sp, names, ix)
        }
    }
}

fn leaf(v: mut ival.Val, op: MOp, sp: ckast.Span, names: ival.Names, ix: Ix) -> Result[ival.Val, Ctl] {
    match op {
        MGet => Ok(v),
        MCheck => Ok(ival.unit()),
        MSet(x) => {
            v = x
            Ok(ival.unit())
        }
        MTake => {
            let old = v
            v = ival.unit()
            Ok(old)
        }
        MBin(o, x, ssp) => {
            if o == icode.OP_ADD and v.k == ival.K_STR {
                v.s += x.s
            } else if o == icode.OP_ADD and v.k == ival.K_LIST {
                v.xs.extend(x.xs)
            } else {
                let cur = v
                v = ival.unit()
                v = binop(o, cur, x, ssp)?
            }
            Ok(ival.unit())
        }
        MExt(m, args, keys) => ibuiltin.mut_op(mut v, m, args, keys, sp, ix),
    }
}

// ---- statements ----

pub fn block(it: mut Interp, fr: mut List[ival.Val], ss: List[icode.Stm]) -> Result[ival.Val, Ctl] {
    let n = ss.len()
    if n == 0 { return Ok(ival.unit()) }
    for i in 0..n - 1 { let _ = stmt(mut it, mut fr, ss[i])? }
    stmt(mut it, mut fr, ss[n - 1])
}

fn loop_body(it: mut Interp, fr: mut List[ival.Val], body: List[icode.Stm]) -> Result[Bool, Ctl] {
    match block(mut it, mut fr, body) {
        Ok(_) => Ok(true),
        Err(CContinue) => Ok(true),
        Err(CBreak) => Ok(false),
        Err(c) => Err(c),
    }
}

fn stmt(it: mut Interp, fr: mut List[ival.Val], s: icode.Stm) -> Result[ival.Val, Ctl] {
    match s {
        IExpr(e) => ev(mut it, mut fr, e),
        ILet(p, e) => {
            let v = ev(mut it, mut fr, e)?
            let _ = bind(mut fr, p, v)
            Ok(ival.unit())
        }
        IAssign(pl, op, e, ssp) => {
            if pl.steps.is_empty() {
                let v = ev(mut it, mut fr, e)?
                if op < 0 {
                    fr[pl.root] = v
                } else {
                    let _ = leaf(mut fr[pl.root], MBin(op, v, ssp), pl.sp, it.names, it.ix)?
                }
                return Ok(ival.unit())
            }
            let steps = eval_steps(mut it, mut fr, pl.steps)?
            let v = ev(mut it, mut fr, e)?
            if op < 0 {
                let _ = nk(mut it, nav(mut fr[pl.root], steps, 0, true, MSet(v), pl.sp, it.names, it.ix))?
            } else {
                let _ = nk(mut it, nav(mut fr[pl.root], steps, 0, false, MBin(op, v, ssp), pl.sp, it.names, it.ix))?
            }
            Ok(ival.unit())
        }
        IWhile(c, body) => {
            while true {
                let cv = ev(mut it, mut fr, c)?
                if not (cv.k == ival.K_BOOL and cv.i == 1) { break }
                if not loop_body(mut it, mut fr, body)? { break }
            }
            Ok(ival.unit())
        }
        IForRange(p, a, b, body) => {
            let lo = ev(mut it, mut fr, a)?
            let hi = ev(mut it, mut fr, b)?
            var i = lo.i
            while i < hi.i {
                let _ = bind(mut fr, p, ival.vint(i))
                if not loop_body(mut it, mut fr, body)? { break }
                i += 1
            }
            Ok(ival.unit())
        }
        IForEach(p, e, body) => {
            let v = ev(mut it, mut fr, e)?
            let items = if v.k == ival.K_MAP { ival.map_items(v.m) } else { v.xs }
            for x in items {
                let _ = bind(mut fr, p, x)
                if not loop_body(mut it, mut fr, body)? { break }
            }
            Ok(ival.unit())
        }
        ILetElse(p, e, els) => {
            let v = ev(mut it, mut fr, e)?
            if not bind(mut fr, p, v) {
                let _ = block(mut it, mut fr, els)?
                return trap("interp: 'let ... else' block did not leave", ckast.Span { file: 0, line: 0, col: 0 })
            }
            Ok(ival.unit())
        }
        IReturn(e) => match e {
            Some(x) => Err(CRet(ev(mut it, mut fr, x)?)),
            None => Err(CRet(ival.unit())),
        },
        IBreak => Err(CBreak),
        IContinue => Err(CContinue),
        IDrop(p, e) => {
            let v = ev(mut it, mut fr, e)?
            let _ = bind(mut fr, p, v)
            release(mut it, fr, [v], [])
            Ok(ival.unit())
        }
        IAssignDrop(pl, e) => {
            let steps = eval_steps(mut it, mut fr, pl.steps)?
            let v = ev(mut it, mut fr, e)?
            let old = if steps.is_empty() { fr[pl.root] } else { nk(mut it, nav(mut fr[pl.root], steps, 0, false, MGet, pl.sp, it.names, it.ix))? }
            if steps.is_empty() {
                fr[pl.root] = v
            } else {
                let _ = nk(mut it, nav(mut fr[pl.root], steps, 0, true, MSet(v), pl.sp, it.names, it.ix))?
            }
            release(mut it, fr, [old], [])
            Ok(ival.unit())
        }
    }
}

// Match v against p, binding names into the frame.
pub fn bind(fr: mut List[ival.Val], p: icode.IPat, v: ival.Val) -> Bool {
    match p {
        BBind(s) => {
            fr[s] = v
            true
        }
        BWild => true,
        BVariant(vi, ps) => {
            if v.k != ival.K_ENUM or v.j != vi { return false }
            let n = ps.len().min(v.xs.len())
            for i in 0..n {
                if not bind(mut fr, ps[i], v.xs[i]) { return false }
            }
            true
        }
        BTuple(ps) => {
            if v.k != ival.K_TUPLE { return false }
            let n = ps.len().min(v.xs.len())
            for i in 0..n {
                if not bind(mut fr, ps[i], v.xs[i]) { return false }
            }
            true
        }
        BInt(n) => v.k == ival.K_INT and v.i == n,
        BStr(s) => v.k == ival.K_STR and v.s == s,
        BBool(b) => v.k == ival.K_BOOL and (v.i == 1) == b,
        BOr(alts) => {
            for a in alts {
                if bind(mut fr, a, v) { return true }
            }
            false
        }
    }
}

// ---- expressions ----

pub fn ev(it: mut Interp, fr: mut List[ival.Val], e: icode.Node) -> Result[ival.Val, Ctl] {
    match e {
        NLocal(s) => Ok(fr[s]),
        NLit(v) => Ok(v),
        NBin(op, a, b, sp) => {
            // operands that are locals or literals are read without a nested evaluation
            let x = match a {
                NLocal(s) => fr[s],
                NLit(v) => v,
                _ => ev(mut it, mut fr, a)?,
            }
            let y = match b {
                NLocal(s) => fr[s],
                NLit(v) => v,
                _ => ev(mut it, mut fr, b)?,
            }
            binop(op, x, y, sp)
        }
        NField(b, i) => match b {
            NLocal(s) => Ok(fr[s].xs[i]),
            _ => {
                let v = ev(mut it, mut fr, b)?
                Ok(v.xs[i])
            }
        },
        NCall(fi, args, sp, site) => {
            if site { it.site = sp }
            var av: List[ival.Val] = []
            for a in args {
                match a {
                    NLocal(s) => av.push(fr[s]),
                    _ => av.push(ev(mut it, mut fr, a)?),
                }
            }
            call_fn(mut it, fi, mut av, sp)
        }
        NIf(c, t, els) => {
            let cv = ev(mut it, mut fr, c)?
            if cv.i == 1 {
                block(mut it, mut fr, t)
            } else {
                match els {
                    Some(x) => ev(mut it, mut fr, x),
                    None => Ok(ival.unit()),
                }
            }
        }
        NIndex(b, i, sp, kt) => {
            let bv = ev(mut it, mut fr, b)?
            let iv = ev(mut it, mut fr, i)?
            match index(bv, iv, sp, it.names) {
                Err(CTrap(m, at)) if m.starts_with("key not found: ") and it.names.shows() => {
                    let shown = prerender(mut it, iv, kt)?
                    trap("key not found: " + ival.show_nested(shown, it.names), at)
                }
                r => r,
            }
        }
        NAnd(a, b) => {
            let x = ev(mut it, mut fr, a)?
            if x.i == 0 { return Ok(x) }
            ev(mut it, mut fr, b)
        }
        NOr(a, b) => {
            let x = ev(mut it, mut fr, a)?
            if x.i == 1 { return Ok(x) }
            ev(mut it, mut fr, b)
        }
        NMatch(s, arms) => ev_match(mut it, mut fr, s, arms),
        NBlock(b) => block(mut it, mut fr, b),
        NNot(x) => {
            let v = ev(mut it, mut fr, x)?
            Ok(ival.vbool(v.i == 0))
        }
        _ => ev_more(mut it, mut fr, e),
    }
}

// The less frequent expressions (kept apart so that `ev`, the hot path, has a small frame).
// Over 80 lines: an expression-dispatch match, one arm per node kind.
fn ev_more(it: mut Interp, fr: mut List[ival.Val], e: icode.Node) -> Result[ival.Val, Ctl] {
    match e {
        NNeg(x, sp) => {
            let v = ev(mut it, mut fr, x)?
            if v.k == ival.K_FLOAT { return Ok(ival.vfloat(-v.f)) }
            if v.i == INT_MIN { return trap("integer overflow", sp) }
            Ok(ival.vint(-v.i))
        }
        NStr(segs) => {
            var s = ""
            for g in segs {
                match g {
                    GLit(l) => s += l,
                    GShow(x, t) => {
                        let v0 = ev(mut it, mut fr, x)?
                        let v = prerender(mut it, v0, t)?
                        ival.show(mut s, v, true, it.names, false)
                    }
                    GFmt(x, f) => {
                        let v = ev(mut it, mut fr, x)?
                        ival.fmt_spec(mut s, v, f)
                    }
                }
            }
            Ok(ival.vstr(s))
        }
        NCtor(ei, vi, args) => {
            var av: List[ival.Val] = []
            for a in args { av.push(ev(mut it, mut fr, a)?) }
            Ok(ival.venum(ei, vi, av))
        }
        NTry(x) => {
            let v = ev(mut it, mut fr, x)?
            if v.j == 0 { Ok(v.xs[0]) } else { Err(CRet(v)) }
        }
        NList(xs) => {
            var av: List[ival.Val] = []
            for a in xs { av.push(ev(mut it, mut fr, a)?) }
            Ok(ival.vlist(av))
        }
        NTuple(xs) => {
            var av: List[ival.Val] = []
            for a in xs { av.push(ev(mut it, mut fr, a)?) }
            Ok(ival.vtuple(av))
        }
        NNew(si, n, given, base) => {
            var vals: List[(Int, ival.Val)] = []
            for g in given { vals.push((g.0, ev(mut it, mut fr, g.1)?)) }
            var fs: List[ival.Val] = []
            match base {
                Some(b) => {
                    let bv = ev(mut it, mut fr, b)?
                    fs = bv.xs
                }
                None => fs = List.filled(n, ival.unit()),
            }
            // `..base`: the base's fields that are replaced are dropped
            let replaced = if it.net_state.open.is_empty() or base.is_none() { [] } else { vals.map(fn(g) => fs[g.0]) }
            for g in vals { fs[g.0] = g.1 }
            let r = ival.vstruct(si, fs)
            if not replaced.is_empty() { release(mut it, fr, replaced, [r]) }
            Ok(r)
        }
        NMapLit(ps) => {
            var m: Map[ival.Key, ival.Val] = [:]
            for p in ps {
                let k = ev(mut it, mut fr, p.0)?
                let v = ev(mut it, mut fr, p.1)?
                m[ival.to_key(k)] = v
            }
            Ok(ival.vmap(m))
        }
        NConst(fi, sp) => {
            var av: List[ival.Val] = []
            call_fn(mut it, fi, mut av, sp)
        }
        NFnVal(fi) => Ok(ival.vfnamed(fi)),
        NCtorFn(ei, vi) => Ok(ival.vfctor(ei, vi)),
        NLambda(li, caps) => {
            var cv: List[ival.Val] = []
            for c in caps { cv.push(fr[c]) }
            Ok(ival.vflam(li, cv))
        }
        NApply(f, args, sp) => {
            let fv = ev(mut it, mut fr, f)?
            var av: List[ival.Val] = []
            for a in args { av.push(ev(mut it, mut fr, a)?) }
            apply(mut it, fv, av, sp)
        }
        NToStr(x, t) => {
            let v0 = ev(mut it, mut fr, x)?
            let v = prerender(mut it, v0, t)?
            Ok(ival.vstr(ival.show_top(v, it.names)))
        }
        NDyn(x, vt) => {
            let v = ev(mut it, mut fr, x)?
            Ok(ival.Val { k: ival.K_DYN, i: vt, xs: [v], ..ival.unit() })
        }
        NDynCall(mi, recv, args, sp) => {
            let rv = ev(mut it, mut fr, recv)?
            let fi = it.vts[rv.i][mi]
            var av: List[ival.Val] = [rv.xs[0]]
            var taken: List[Taken] = []
            args_mut(mut it, mut fr, args, mut av, mut taken)?
            let r = call_fn(mut it, fi, mut av, sp)?
            put_back(mut it, mut fr, taken, av, sp)?
            Ok(r)
        }
        _ => ev_calls(mut it, mut fr, e),
    }
}

// Calls with `mut` arguments or receivers, builtins with `mut self`, decode.
fn ev_calls(it: mut Interp, fr: mut List[ival.Val], e: icode.Node) -> Result[ival.Val, Ctl] {
    match e {
        NDecode(t, args, sp, site) => {
            if site { it.site = sp }
            var av: List[ival.Val] = []
            for a in args { av.push(ev(mut it, mut fr, a)?) }
            Ok(icodec.decode(mut it, t, av[0].s))
        }
        NCallMut(fi, args, sp, site) => {
            if site { it.site = sp }
            var av: List[ival.Val] = []
            var taken: List[Taken] = []
            args_mut(mut it, mut fr, args, mut av, mut taken)?
            let r = call_fn(mut it, fi, mut av, sp)?
            put_back(mut it, mut fr, taken, av, sp)?
            Ok(r)
        }
        NMethodMut(fi, recv, args, sp, site) => {
            if site { it.site = sp }
            let rv = ev(mut it, mut fr, recv)?
            var av: List[ival.Val] = [rv]
            var taken: List[Taken] = []
            args_mut(mut it, mut fr, args, mut av, mut taken)?
            let r = call_fn(mut it, fi, mut av, sp)?
            put_back(mut it, mut fr, taken, av, sp)?
            Ok(r)
        }
        NMutSelf(fi, pl, args, sp, site) => {
            if site { it.site = sp }
            let steps = eval_steps(mut it, mut fr, pl.steps)?
            var av: List[ival.Val] = [ival.unit()]
            var taken: List[Taken] = []
            args_mut(mut it, mut fr, args, mut av, mut taken)?
            av[0] = nk(mut it, nav(mut fr[pl.root], steps, 0, false, MTake, pl.sp, it.names, it.ix))?
            let r = call_fn(mut it, fi, mut av, sp)?
            let _ = nk(mut it, nav(mut fr[pl.root], steps, 0, false, MSet(av[0]), pl.sp, it.names, it.ix))?
            put_back(mut it, mut fr, taken, av, sp)?
            Ok(r)
        }
        NExtMut(id, pl, args, sp, site) => {
            if site { it.site = sp }
            let steps = eval_steps(mut it, mut fr, pl.steps)?
            var av: List[ival.Val] = []
            for a in args { av.push(ev(mut it, mut fr, a)?) }
            // sort_by keys are computed first, element by element
            var keys: List[ival.Val] = []
            if id < 0 { panic("interp: missing builtin") }
            let op = it.mbis[id]
            if op == BmSortBy or op == BmSortByDesc {
                let cur = nk(mut it, nav(mut fr[pl.root], steps, 0, false, MGet, pl.sp, it.names, it.ix))?
                for x in cur.xs { keys.push(apply(mut it, av[0], [x], sp)?) }
            } else if not steps.is_empty() {
                let _ = nk(mut it, nav(mut fr[pl.root], steps, 0, false, MCheck, pl.sp, it.names, it.ix))?
            }
            nk(mut it, nav(mut fr[pl.root], steps, 0, false, MExt(op, av, keys), sp, it.names, it.ix))
        }
        NScope(ss, mine) => scope(mut it, mut fr, ss, mine),
        NTemp(s, x) => {
            let v = ev(mut it, mut fr, x)?
            fr[s] = v
            Ok(v)
        }
        NOwnMatch(s, arms) => {
            let v = ev(mut it, mut fr, s)?
            for a in arms {
                if bind(mut fr, a.pat, v) {
                    let go = match a.guard {
                        Some(g) => ev(mut it, mut fr, g)?.i == 1,
                        None => true,
                    }
                    if go {
                        // the arm's slots hold what its pattern binds; the rest of the value ends here
                        release(mut it, fr, [v], [])
                        return ev(mut it, mut fr, a.body)
                    }
                }
            }
            trap("interp: no match arm", ckast.Span { file: 0, line: 0, col: 0 })
        }
        _ => panic("interp: unexpected node"),
    }
}

fn ev_match(it: mut Interp, fr: mut List[ival.Val], s: icode.Node, arms: List[icode.IArm]) -> Result[ival.Val, Ctl] {
    let v = ev(mut it, mut fr, s)?
    for a in arms {
        if bind(mut fr, a.pat, v) {
            let go = match a.guard {
                Some(g) => ev(mut it, mut fr, g)?.i == 1,
                None => true,
            }
            if go { return ev(mut it, mut fr, a.body) }
        }
    }
    trap("interp: no match arm", ckast.Span { file: 0, line: 0, col: 0 })
}

fn index(b: ival.Val, i: ival.Val, sp: ckast.Span, names: ival.Names) -> Result[ival.Val, Ctl] {
    if b.k == ival.K_LIST {
        if i.i < 0 or i.i >= b.xs.len() { return trap_oob(i.i, b.xs.len(), sp) }
        return Ok(b.xs[i.i])
    }
    match b.m.get(ival.to_key(i)) {
        Some(v) => Ok(v),
        None => trap("key not found: " + ival.show_nested(i, names), sp),
    }
}

pub fn binop(op: Int, a: ival.Val, b: ival.Val, sp: ckast.Span) -> Result[ival.Val, Ctl] {
    let k = a.k
    if k == ival.K_INT {
        let x = a.i
        let y = b.i
        if op == icode.OP_LT { return Ok(ival.vbool(x < y)) }
        if op == icode.OP_EQ { return Ok(ival.vbool(x == y)) }
        if op >= icode.OP_NE {
            return Ok(ival.vbool(if op == icode.OP_NE { x != y } else if op == icode.OP_LE { x <= y } else if op == icode.OP_GT { x > y } else { x >= y }))
        }
        if op == icode.OP_ADD {
            return match x.checked_add(y) {
                Some(r) => Ok(ival.vint(r)),
                None => trap("integer overflow", sp),
            }
        }
        if op == icode.OP_SUB {
            return match x.checked_sub(y) {
                Some(r) => Ok(ival.vint(r)),
                None => trap("integer overflow", sp),
            }
        }
        if op == icode.OP_MUL {
            return match x.checked_mul(y) {
                Some(r) => Ok(ival.vint(r)),
                None => trap("integer overflow", sp),
            }
        }
        if y == 0 { return trap("division by zero", sp) }
        if x == INT_MIN and y == -1 { return trap("integer overflow", sp) }
        return Ok(ival.vint(if op == icode.OP_DIV { x / y } else { x % y }))
    }
    if op == icode.OP_EQ { return Ok(ival.vbool(ival.eq(a, b))) }
    if op == icode.OP_NE { return Ok(ival.vbool(not ival.eq(a, b))) }
    if op >= icode.OP_LT {
        let c = match ival.cmp(a, b) {
            Ok(c) => c,
            Err(m) => return trap(m, sp),
        }
        if k == ival.K_FLOAT {
            let x = a.f
            let y = b.f
            return Ok(ival.vbool(if op == icode.OP_LT { x < y } else if op == icode.OP_LE { x <= y } else if op == icode.OP_GT { x > y } else { x >= y }))
        }
        return Ok(ival.vbool(if op == icode.OP_LT { c < 0 } else if op == icode.OP_LE { c <= 0 } else if op == icode.OP_GT { c > 0 } else { c >= 0 }))
    }
    if k == ival.K_FLOAT {
        let x = a.f
        let y = b.f
        return Ok(ival.vfloat(if op == icode.OP_ADD { x + y } else if op == icode.OP_SUB { x - y } else if op == icode.OP_MUL { x * y } else if op == icode.OP_DIV { x / y } else { x % y }))
    }
    if k == ival.K_STR { return Ok(ival.vstr(a.s + b.s)) }
    Ok(ival.vlist(a.xs + b.xs))
}
