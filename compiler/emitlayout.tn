// module
// Self-hosted C backend, part 2: type definitions in dependency order, the
// per-type helpers (retain, release, eq, cmp, hash, show, constructors), the
// strict decoders, the `main` wrapper and the assembly of the C file.
// A port of the corresponding parts of seed/src/emit_c.rs.

import cktypes
import emit
import emittrait

// By-value dependencies (types that must be complete before t).
fn value_deps(m: mut emit.Em, t: cktypes.Ty) -> List[cktypes.Ty] {
    let v = match t {
        Tup(ts) => ts,
        Con(n, _) if n == "List" or n == "Map" => [],
        Con(_, _) => match m.struct_fields(t) {
            Some(fs) => fs.map(fn(f) => f.1),
            None => match m.enum_variants(t) {
                Some(vs) => {
                    var out: List[cktypes.Ty] = []
                    for x in vs { out.extend(x.1) }
                    out
                }
                None => [],
            },
        },
        _ => [],
    }
    var out: List[cktypes.Ty] = []
    for x in v {
        match m.tnames.get(x) {
            Some(n) if not n.starts_with("tn_") => out.push(x),
            _ => {}
        }
    }
    out
}

pub fn fields_of(m: mut emit.Em, t: cktypes.Ty) -> List[(Str, cktypes.Ty)] {
    match t {
        Tup(ts) => {
            var out: List[(Str, cktypes.Ty)] = []
            for i in 0..ts.len() { out.push(("f{i}", ts[i])) }
            out
        }
        _ => m.struct_fields(t).unwrap().map(fn(f) => ("f_" + f.0, f.1)),
    }
}

// The variants' payloads: a union; under `tenon build` (Em.build), for a
// by-value enum, TN_PAYLOADS, which runtime/tenon.h makes a struct for GCC
// (the payloads side by side). GCC does not split a value that contains a
// union into scalars (SRA), so it copies such a value through memory:
// written field by field and read back 16 bytes at a time, a failed
// store-to-load forward on every copy; bench/calc, whose evaluator returns a
// Result[Int, Str] per node, took 4x as long as with clang (Linux, gcc 13).
// The struct takes the sum of the payloads instead of the largest (the same
// with one payload, as Option), so only enums with at most two payloads (as
// Result) get it: with all of them the interpreter's values grew enough that
// `tenon test` took 40 s instead of 22 (Linux). Heap nodes of boxed enums
// keep the union.
fn union_def(m: mut emit.Em, vs: List[(Str, List[cktypes.Ty])], boxed: Bool) -> Str {
    var s = ""
    let payloads = vs.filter(fn(v) => not v.1.is_empty()).len()
    if payloads > 0 {
        s += if boxed or not m.build or payloads > 2 { " union \{" } else { " TN_PAYLOADS \{" }
        for i in 0..vs.len() {
            let fs = vs[i].1
            if fs.is_empty() { continue }
            s += " struct \{"
            for j in 0..fs.len() {
                let ct = m.cty(fs[j])
                s += " " + ct + " f{j};"
            }
            s += " } v{i};"
        }
        s += " } u;"
    }
    s
}

// ---- assembly ----

// Everything before the program's own functions (emit.CParts.head).
pub fn assemble(m: mut emit.Em, runtime: Str) -> Str {
    var out = "/* generated by tenon; do not edit */\n"
    if m.mt { out += "#define TN_MT 1\n" }
    out += runtime
    out += "\n"
    let types = m.tlist
    // 1. forward declarations
    for t in types {
        let n = m.tnames[t]
        if m.is_ptr_kind(t) { out += "typedef struct " + n + "_s *" + n + ";\n" } else { out += "typedef struct " + n + " " + n + ";\n" }
    }
    // 2. by-value definitions in dependency order
    var done: Map[cktypes.Ty, Bool] = [:]
    for t in types { define_value(mut m, t, mut done, mut out) }
    // 3. heap layouts
    for t in types {
        let n = m.tnames[t]
        match t {
            Con(k, a) if k == "List" => {
                let e = m.cty(a[0])
                out += "TN_LIST_TYPE(" + n + ", " + e + ")\n"
            }
            Con(k, a) if k == "Map" => {
                let kk = m.cty(a[0])
                let vv = m.cty(a[1])
                out += "TN_MAP_TYPE(" + n + ", " + kk + ", " + vv + ")\n"
            }
            _ => {
                if m.is_ptr_kind(t) {
                    let vs = m.enum_variants(t).unwrap()
                    let u = union_def(mut m, vs, true)
                    out += "struct " + n + "_s \{ int64_t rc; int32_t tag;" + u + " };\n"
                }
            }
        }
    }
    // 4. helper prototypes, 5. container functions, 6. helper bodies
    var protos = ""
    var bodies = ""
    for t in types {
        match t {
            Con(k, _) if k == "List" or k == "Map" => {}
            _ => helpers_for(mut m, t, mut protos, mut bodies),
        }
    }
    out += protos
    for t in types {
        let n = m.tnames[t]
        match t {
            Con(k, a) if k == "List" => {
                let e = m.cty(a[0])
                out += "TN_LIST_FUNCS(" + n + ", " + e + ")\n"
                if m.mt { out += "TN_LIST_COPY(" + n + ", " + e + ")\n" }
            }
            Con(k, a) if k == "Map" => {
                let kk = m.cty(a[0])
                let vv = m.cty(a[1])
                out += (if emittrait.user_keyed(m, a[0]) { "TN_MAP_FUNCS_U(" } else { "TN_MAP_FUNCS(" }) + n + ", " + kk + ", " + vv + ")\n"
                if m.mt { out += "TN_MAP_COPY(" + n + ", " + kk + ", " + vv + ")\n" }
            }
            _ => {}
        }
    }
    out += bodies
    out
}

fn define_value(m: mut emit.Em, t: cktypes.Ty, done: mut Map[cktypes.Ty, Bool], out: mut Str) {
    if done.contains(t) or m.is_ptr_kind(t) { return }
    done[t] = true
    for d in value_deps(mut m, t) { define_value(mut m, d, mut done, mut out) }
    let n = m.tnames[t]
    if emittrait.is_dyn(t) {
        out += emittrait.dyn_value_def(n)
        return
    }
    match m.enum_variants(t) {
        Some(vs) => {
            let u = union_def(mut m, vs, false)
            out += "struct " + n + " \{ int32_t tag;" + u + " };\n"
            return
        }
        None => {}
    }
    let fs = fields_of(mut m, t)
    var s = "struct " + n + " \{"
    for f in fs {
        let ct = m.cty(f.1)
        s += " " + ct + " " + f.0 + ";"
    }
    if fs.is_empty() { s += " char _empty;" }
    s += " };\n"
    out += s
}

// seed/src/interp.rs `shown_fields`: the fields formatting shows, up to
// the first one private to another module.
fn shown_count(m: mut emit.Em, t: cktypes.Ty) -> Int {
    match t {
        Con(n, _) => {
            let s = m.c.env.structs[m.c.env.struct_idx(n).unwrap()]
            for i in 0..s.fields.len() {
                if s.file > 1 and not s.pub_fields[i] { return i }
            }
            -1
        }
        _ => -1,
    }
}

// Under `tenon build` (Em.build) retain and release are TN_RC_INLINE, which
// runtime/tenon.h makes `inline` for GCC, so that at -O2 it inlines them as
// clang does (bench/calc released each Result[Int, Str] of its evaluator
// through a call: 10% of its time, Linux, gcc 13).
fn inline_kw(m: emit.Em) -> Str { if m.build { "TN_RC_INLINE " } else { "" } }

fn helpers_for(m: mut emit.Em, t: cktypes.Ty, protos: mut Str, b: mut Str) {
    let n = m.tnames[t]
    let inl = inline_kw(m)
    protos += "static {inl}TN_UNUSED {n} {n}_retain({n} x); static {inl}TN_UNUSED void {n}_release({n} x); " +
        "static TN_UNUSED bool {n}_eq({n} a, {n} b); static TN_UNUSED int {n}_cmp({n} a, {n} b); " +
        "static TN_UNUSED uint64_t {n}_hash({n} x); static TN_UNUSED void {n}_show(tn_buf *b, {n} x, int mode); " +
        "static inline TN_UNUSED bool {n}_same({n} a, {n} b) \{ (void)a; (void)b; return false; } " +
        "static TN_UNUSED bool {n}_dec(tn_dec *d, {n} *out);\n"
    if m.mt { protos += "static TN_UNUSED {n} {n}_copy({n} x);\n" }
    if emittrait.is_dyn(t) {
        emittrait.dyn_helpers(mut m, t, n, mut b)
        return
    }
    protos += emittrait.show_proto(mut m, t)
    protos += emittrait.cmp_protos(mut m, t)
    decoder_for(mut m, t, n, mut b)
    match m.enum_variants(t) {
        Some(vs) => {
            enum_helpers(mut m, t, n, vs, mut protos, mut b)
            return
        }
        None => {}
    }
    struct_helpers(mut m, t, n, mut b)
}

// The helpers of a struct or tuple type t (C name n).
fn struct_helpers(m: mut emit.Em, t: cktypes.Ty, n: Str, b: mut Str) {
    let inl = inline_kw(m)
    let fs = fields_of(mut m, t)
    var rc = ""
    var rl = ""
    var eq = "true"
    var cm = ""
    var hs = ""
    var sh = ""
    let is_tuple = match t {
        Tup(_) => true,
        _ => false,
    }
    let tname = match t {
        Con(x, _) => emit.display(x),
        _ => "",
    }
    sh += emittrait.show_prefix(mut m, t)
    if is_tuple {
        sh += "tn_buf_add(b, \"(\", 1); "
    } else if fs.is_empty() {
        sh += "tn_buf_cstr(b, " + emit.c_string(tname + " \{}") + "); "
    } else {
        sh += "tn_buf_cstr(b, " + emit.c_string(tname + " \{ ") + "); "
    }
    let hidden_at = shown_count(mut m, t)
    var hidden = false
    for k in 0..fs.len() {
        let f = fs[k].0
        let tn = m.cty(fs[k].1)
        rc += "{tn}_retain(x.{f}); "
        rl += "{tn}_release(x.{f}); "
        eq += " && {tn}_eq(a.{f}, b.{f})"
        cm += "if ((c = {tn}_cmp(a.{f}, b.{f}))) return c; "
        hs += "h = tn_mix(h * 31 + {tn}_hash(x.{f})); "
        if k > 0 { sh += "tn_buf_add(b, \", \", 2); " }
        if not is_tuple and k == hidden_at {
            // private to another module: hidden unless encoding
            sh += "if (!(mode & TN_FULL)) \{ tn_buf_cstr(b, \"..\"); goto end; } "
            hidden = true
        }
        if not is_tuple { sh += "tn_buf_cstr(b, " + emit.c_string(f.slice(2, f.len()) + ": ") + "); " }
        sh += "{tn}_show(b, x.{f}, mode & TN_FULL); "
    }
    if hidden { sh += "end: " }
    if is_tuple {
        sh += "tn_buf_add(b, \")\", 1); "
    } else if not fs.is_empty() {
        sh += "tn_buf_cstr(b, \" }\"); "
    }
    b += "static {inl}TN_UNUSED {n} {n}_retain({n} x) \{ {rc}return x; }\n"
    b += "static {inl}TN_UNUSED void {n}_release({n} x) \{ {rl}(void)x; }\n"
    let (pe, pc, ph) = (emittrait.cmp_prefix(mut m, t, 0), emittrait.cmp_prefix(mut m, t, 1), emittrait.cmp_prefix(mut m, t, 2))
    b += "static TN_UNUSED bool {n}_eq({n} a, {n} b) \{ {pe}(void)a; (void)b; return {eq}; }\n"
    b += "static TN_UNUSED int {n}_cmp({n} a, {n} b) \{ {pc}int c; (void)a; (void)b; (void)c; {cm}return 0; }\n"
    b += "static TN_UNUSED uint64_t {n}_hash({n} x) \{ {ph}uint64_t h = 3; {hs}(void)x; return h; }\n"
    b += "static TN_UNUSED void {n}_show(tn_buf *b, {n} x, int mode) \{ (void)mode; (void)x; {sh}}\n"
    if m.mt {
        var cp = ""
        for k in 0..fs.len() {
            if not m.trivial(fs[k].1) {
                let tn = m.cty(fs[k].1)
                cp += "y.{fs[k].0} = {tn}_copy(x.{fs[k].0}); "
            }
        }
        b += "static TN_UNUSED {n} {n}_copy({n} x) \{ {n} y = x; {cp}return y; }\n"
    }
}

// One `case` per variant with fields; `kind` picks the statement per field.
fn each(m: mut emit.Em, vs: List[(Str, List[cktypes.Ty])], acc: Str, kind: Int) -> Str {
    var s = ""
    for i in 0..vs.len() {
        let fs = vs[i].1
        if fs.is_empty() { continue }
        s += "case {i}: "
        for j in 0..fs.len() {
            let tn = m.cty(fs[j])
            let f = "{acc}u.v{i}.f{j}"
            s += match kind {
                0 => "{tn}_retain(x{f}); ",
                1 => "{tn}_release(x{f}); ",
                2 => "if (!{tn}_eq(a{f}, b{f})) return false; ",
                3 => "if ((c = {tn}_cmp(a{f}, b{f}))) return c; ",
                _ => "h = tn_mix(h * 31 + {tn}_hash(x{f})); ",
            }
        }
        s += "break; "
    }
    s
}

fn enum_helpers(m: mut emit.Em, t: cktypes.Ty, n: Str, vs: List[(Str, List[cktypes.Ty])], protos: mut Str, b: mut Str) {
    let inl = inline_kw(m)
    let boxed = m.is_boxed(t)
    let acc = if boxed { "->" } else { "." }
    // (with workers the allocator's free lists, which are per thread, do this)
    let pool = boxed and not m.mt
    if pool { protos += "static {n} {n}_pool; static int64_t {n}_pool_n;\n" }
    // constructors
    for i in 0..vs.len() {
        let fs = vs[i].1
        var params: List[Str] = []
        for j in 0..fs.len() {
            let ct = m.cty(fs[j])
            params.push(ct + " a{j}")
        }
        let ps = params.join(", ")
        protos += "static TN_UNUSED {n} {n}_mk{i}({ps});\n"
        if boxed and fs.is_empty() {
            // Nullary variants of boxed enums are shared immortal objects.
            b += "static struct {n}_s {n}_null{i} = \{ .rc = INT64_MAX / 2, .tag = {i} };\n"
            b += "static TN_UNUSED {n} {n}_mk{i}(void) \{ return &{n}_null{i}; }\n"
            continue
        }
        b += "static TN_UNUSED {n} {n}_mk{i}({ps}) \{ "
        if pool {
            b += "{n} x = {n}_pool; if (x) \{ {n}_pool = *(void **)x; {n}_pool_n--; } else x = tn_alloc(sizeof(struct {n}_s)); x->rc = 1; "
        } else if boxed {
            b += "{n} x = tn_alloc(sizeof(struct {n}_s)); x->rc = 1; "
        } else {
            b += "{n} x; "
        }
        b += "x{acc}tag = {i}; "
        for j in 0..fs.len() { b += "x{acc}u.v{i}.f{j} = a{j}; " }
        b += "return x; }\n"
    }
    let rc = each(mut m, vs, acc, 0)
    let rl = each(mut m, vs, acc, 1)
    let eq = each(mut m, vs, acc, 2)
    let cm = each(mut m, vs, acc, 3)
    let hs = each(mut m, vs, acc, 4)
    if boxed {
        // with workers the shared nullary nodes keep their counts (TN_RC_STATIC)
        let st = if m.mt { "if (x->rc < TN_RC_STATIC) " } else { "" }
        b += "static {inl}TN_UNUSED {n} {n}_retain({n} x) \{ {st}x->rc++; return x; }\n"
        // freed nodes are kept on a small per-type list and reused by the constructors
        let put = if pool { "if ({n}_pool_n < TN_POOL_MAX) \{ *(void **)x = {n}_pool; {n}_pool = x; {n}_pool_n++; } else tn_free(x); " } else { "tn_free(x); " }
        b += "static void {n}_free(void *p) \{ {n} x = p; tn_rel_depth++; switch (x->tag) \{ {rl}} " + put + "tn_rel_depth--; }\n"
        let st2 = if m.mt { "x->rc >= TN_RC_STATIC || " } else { "" }
        b += "static {inl}TN_UNUSED void {n}_release({n} x) \{ if (!x || {st2}--x->rc) return; " +
            "if (tn_rel_depth > 1000) \{ tn_defer(x, {n}_free); return; } {n}_free(x); if (tn_rel_depth == 0) tn_drain(); }\n"
    } else {
        b += "static {inl}TN_UNUSED {n} {n}_retain({n} x) \{ switch (x.tag) \{ {rc}} return x; }\n"
        b += "static {inl}TN_UNUSED void {n}_release({n} x) \{ switch (x.tag) \{ {rl}} }\n"
    }
    let (pe, pc, ph) = (emittrait.cmp_prefix(mut m, t, 0), emittrait.cmp_prefix(mut m, t, 1), emittrait.cmp_prefix(mut m, t, 2))
    b += "static TN_UNUSED bool {n}_eq({n} a, {n} b) \{ {pe}if (a{acc}tag != b{acc}tag) return false; switch (a{acc}tag) \{ {eq}} return true; }\n"
    b += "static TN_UNUSED int {n}_cmp({n} a, {n} b) \{ {pc}int c = 0; if (a{acc}tag != b{acc}tag) return a{acc}tag < b{acc}tag ? -1 : 1; switch (a{acc}tag) \{ {cm}} return c; }\n"
    b += "static TN_UNUSED uint64_t {n}_hash({n} x) \{ {ph}uint64_t h = (uint64_t)x{acc}tag + 1; switch (x{acc}tag) \{ {hs}} return h; }\n"
    var sh = ""
    for i in 0..vs.len() {
        let fs = vs[i].1
        sh += "case {i}: tn_buf_cstr(b, " + emit.c_string(vs[i].0) + "); "
        if not fs.is_empty() {
            sh += "tn_buf_add(b, \"(\", 1); "
            for j in 0..fs.len() {
                let tn = m.cty(fs[j])
                if j > 0 { sh += "tn_buf_add(b, \", \", 2); " }
                sh += "{tn}_show(b, x{acc}u.v{i}.f{j}, mode & TN_FULL); "
            }
            sh += "tn_buf_add(b, \")\", 1); "
        }
        sh += "break; "
    }
    let pre = emittrait.show_prefix(mut m, t)
    b += "static TN_UNUSED void {n}_show(tn_buf *b, {n} x, int mode) \{ (void)mode; {pre}switch (x{acc}tag) \{ {sh}} }\n"
    if m.mt { b += enum_copy(mut m, n, vs, boxed) }
}

// A deep copy, for sending to another worker (runtime/tenon.h, TN_MT).
fn enum_copy(m: mut emit.Em, n: Str, vs: List[(Str, List[cktypes.Ty])], boxed: Bool) -> Str {
    var cs = ""
    for i in 0..vs.len() {
        let fs = vs[i].1
        if fs.is_empty() { continue }
        if boxed {
            var args: List[Str] = []
            for j in 0..fs.len() {
                let tn = m.cty(fs[j])
                args.push("{tn}_copy(x->u.v{i}.f{j})")
            }
            cs += "case {i}: return {n}_mk{i}(" + args.join(", ") + "); "
        } else {
            cs += "case {i}: "
            for j in 0..fs.len() {
                if not m.trivial(fs[j]) {
                    let tn = m.cty(fs[j])
                    cs += "y.u.v{i}.f{j} = {tn}_copy(x.u.v{i}.f{j}); "
                }
            }
            cs += "break; "
        }
    }
    if boxed { return "static TN_UNUSED {n} {n}_copy({n} x) \{ if (x->rc >= TN_RC_STATIC) return x; switch (x->tag) \{ {cs}} return x; }\n" }
    "static TN_UNUSED {n} {n}_copy({n} x) \{ {n} y = x; switch (x.tag) \{ {cs}} return y; }\n"
}

fn ex(l: Str) -> Str { "if (!tn_dec_expect(d, " + emit.c_string(l) + ")) goto fail; " }

fn rel_args(m: mut emit.Em, fs: List[cktypes.Ty], upto: Int) -> Str {
    var s = ""
    for j in 0..upto {
        let tn = m.cty(fs[j])
        s += "{tn}_release(a{j}); "
    }
    s
}

fn rel_fields(m: mut emit.Em, fs: List[(Str, cktypes.Ty)], upto: Int) -> Str {
    var s = ""
    for k in 0..upto {
        let tn = m.cty(fs[k].1)
        s += tn + "_release(x." + fs[k].0 + "); "
    }
    s
}

// Strict decoder, step for step the same as seed/src/codec.rs (so failure offsets agree).
fn decoder_for(m: mut emit.Em, t: cktypes.Ty, n: Str, b: mut Str) {
    var body = ""
    match m.enum_variants(t) {
        Some(vs) => {
            body += "int64_t st = d->pos; tn_Str nm = tn_dec_run(d, 2); "
            for i in 0..vs.len() {
                let fs = vs[i].1
                body += "if (tn_str_eq_c(nm, " + emit.c_string(vs[i].0) + ")) \{ "
                var args: List[Str] = []
                if not fs.is_empty() {
                    body += ex("(")
                    for j in 0..fs.len() {
                        let tn = m.cty(fs[j])
                        body += "{tn} a{j}; "
                        if j > 0 { body += "if (!tn_dec_expect(d, \", \")) \{ " + rel_args(mut m, fs, j) + "goto fail; } " }
                        body += "if (!{tn}_dec(d, &a{j})) \{ " + rel_args(mut m, fs, j) + "goto fail; } "
                        args.push("a{j}")
                    }
                    body += "if (!tn_dec_expect(d, \")\")) \{ " + rel_args(mut m, fs, fs.len()) + "goto fail; } "
                }
                body += "*out = {n}_mk{i}(" + args.join(", ") + "); return true; } "
            }
            body += "tn_dec_fail(d, st); "
        }
        None => {
            let fs = fields_of(mut m, t)
            let is_tuple = match t {
                Tup(_) => true,
                _ => false,
            }
            body += "{n} x; "
            if is_tuple {
                body += ex("(")
            } else {
                let disp = match t {
                    Con(tn, _) => emit.display(tn),
                    _ => "",
                }
                body += ex(disp)
                body += ex(if fs.is_empty() { " \{}" } else { " \{ " })
            }
            for k in 0..fs.len() {
                let f = fs[k].0
                let tn = m.cty(fs[k].1)
                let rel = rel_fields(mut m, fs, k)
                if k > 0 { body += "if (!tn_dec_expect(d, \", \")) \{ {rel}goto fail; } " }
                if not is_tuple {
                    body += "if (!tn_dec_expect(d, " + emit.c_string(f.slice(2, f.len())) + ")) \{ {rel}goto fail; } "
                    body += "if (!tn_dec_expect(d, \": \")) \{ {rel}goto fail; } "
                }
                body += "if (!{tn}_dec(d, &x.{f})) \{ {rel}goto fail; } "
            }
            let rel = rel_fields(mut m, fs, fs.len())
            let close = if is_tuple { ")" } else if fs.is_empty() { "" } else { " }" }
            if close != "" { body += "if (!tn_dec_expect(d, " + emit.c_string(close) + ")) \{ {rel}goto fail; } " }
            body += "*out = x; return true; "
        }
    }
    b += "static TN_UNUSED bool {n}_dec(tn_dec *d, {n} *out) \{ {body}fail: return false; }\n"
}

// ---- main ----

pub fn main_wrapper(m: mut emit.Em, main_name: Str) -> Str {
    let body = main_body(mut m, main_name)
    body + "int main(int argc, char **argv) \{\n    tn_init(argc, argv);\n    tn_run_main(tn_main_body);\n    tn_exit(0);\n}\n"
}

fn main_body(m: mut emit.Em, main_name: Str) -> Str {
    let f = m.c.env.fns[m.c.main]
    var s = "static void tn_main_body(void) \{\n"
    var args = ""
    if not f.params.is_empty() {
        let n = m.cty(cktypes.con0("Sys"))
        s += "    {n} sys = \{ .f_console = 0, .f_fs = tn_fs_make(tn_str_lit(\"\", 0), false, true), .f_clock = 0, .f_net = 0, .f_proc = 0, .f_args = tn_args() };\n"
        args = "sys"
    }
    let ret = f.ret
    if ret.is("Int") {
        let loc = emit.c_string("{m.names[f.sp.file]}:{f.sp.line}:{f.sp.col}")
        s += "    tn_Int code = {main_name}({args});\n    if (code < 0 || code > 255 || code == 70 || code == 71 || code == 72 || code == 74)\n        " +
            "tn_trapf({loc}, \"exit status %lld is out of range or reserved\", (long long)code);\n    tn_exit((int)code);\n"
        s += "}\n"
        return s
    }
    if ret.is("Result") {
        let rn = m.cty(ret)
        let en = m.cty(ret.args()[1])
        s += "    {rn} r = {main_name}({args});\n"
        let p = m.payload(ret, "r", 1, 0)
        s += "    if (r.tag == 1) \{ tn_buf b = tn_buf_new(); tn_buf_cstr(&b, \"error: \"); {en}_show(&b, {p}, true); " +
            "tn_buf_add(&b, \"\\n\", 1); tn_flush(); tn_write_fd(2, b.p + sizeof(tn_rc), (size_t)b.len, false); tn_exit(TN_EXIT_ERR); }\n"
    } else {
        s += "    {main_name}({args});\n"
    }
    s += "    tn_exit(0);\n}\n"
    s
}
