// module
// Capability builtins (seed/src/builtins.rs `fs_op`, `net_op`,
// `poller_op`, `proc_run`, ...), done with the interpreter's own capabilities:
//
// - An interpreted `Fs` is one of the host's `Fs` values (Interp.fss, indexed
//   by the value's `j`); `within` and `read_only` make new ones, so the path,
//   jail and read-only rules are the host runtime's, which agree with the
//   bootstrap's.
// - Interpreted pollers each get a host `Poller` of their own (at most four;
//   ids and events are then exactly the host's).
// - `Listener` and `Conn` (blocking) are sockets of one more host poller: a
//   blocking call waits on it, keeping new connections and data per socket.
//   A dropped Listener or Conn is closed (close_sock) where the C backend
//   releases it: an interpreted value has no destructor, so the evaluator
//   drops values explicitly (ieval.release, at the nodes icode emits where a
//   type may hold a socket).
// - `Proc` and `Clock` are the host's.
import ckast
import ival
import ieval
import ibuiltin

pub enum FsOp {
    BfRead, BfWrite, BfAppend, BfReadBytes, BfWriteBytes, BfAppendBytes, BfTruncate, BfExists, BfRemove, BfList, BfMkdir,
    BfMkdirOne, BfRename, BfIsDir, BfWithin, BfReadOnly,
}

pub enum NetOp { BnListen, BnConnect, BnPort, BnAccept, BnReadLine, BnRead, BnWrite }

pub enum PollOp { BpNew, BpListen, BpConnect, BpPort, BpWait, BpSend, BpClose }

pub enum SysOp { BkNowMs, BkMonoNs, BkSleepMs, BkRun, BkEnv, BkRunCapture, BkExit }

// The capability builtins, by name (ibuiltin.table).
pub fn table() -> List[(Str, ibuiltin.Bi)] {
    [
        ("Fs.read", BFs(BfRead)), ("Fs.write", BFs(BfWrite)), ("Fs.append", BFs(BfAppend)),
        ("Fs.read_bytes", BFs(BfReadBytes)), ("Fs.write_bytes", BFs(BfWriteBytes)), ("Fs.append_bytes", BFs(BfAppendBytes)),
        ("Fs.truncate", BFs(BfTruncate)), ("Fs.exists", BFs(BfExists)), ("Fs.remove", BFs(BfRemove)), ("Fs.list", BFs(BfList)),
        ("Fs.mkdir", BFs(BfMkdir)), ("Fs.mkdir_one", BFs(BfMkdirOne)), ("Fs.rename", BFs(BfRename)),
        ("Fs.is_dir", BFs(BfIsDir)), ("Fs.within", BFs(BfWithin)), ("Fs.read_only", BFs(BfReadOnly)),
        ("Net.listen", BNet(BnListen)), ("Net.connect", BNet(BnConnect)), ("Listener.port", BNet(BnPort)),
        ("Listener.accept", BNet(BnAccept)), ("Conn.read_line", BNet(BnReadLine)), ("Conn.read", BNet(BnRead)),
        ("Conn.write", BNet(BnWrite)),
        ("Net.poller", BPoll(BpNew)), ("Poller.listen", BPoll(BpListen)), ("Poller.connect", BPoll(BpConnect)),
        ("Poller.port", BPoll(BpPort)), ("Poller.wait", BPoll(BpWait)), ("Poller.send", BPoll(BpSend)),
        ("Poller.close", BPoll(BpClose)),
        ("Clock.now_ms", BSys(BkNowMs)), ("Clock.mono_ns", BSys(BkMonoNs)), ("Clock.sleep_ms", BSys(BkSleepMs)),
        ("Proc.run", BSys(BkRun)), ("Proc.env", BSys(BkEnv)), ("Proc.run_capture", BSys(BkRunCapture)),
        ("Proc.exit", BSys(BkExit)),
    ]
}

// Blocking sockets: accepted connections not yet taken, per listener; bytes
// received and not yet read, and end of stream, per connection; the sockets
// the program holds (open: while it is empty, dropping a value has nothing to do).
pub struct NetState {
    pub accq: Map[Int, List[Int]], pub buf: Map[Int, List[Int]], pub eof: Map[Int, Bool], pub npollers: Int,
    pub open: Map[Int, Bool],
}

pub fn new_net_state() -> NetState { NetState { accq: [:], buf: [:], eof: [:], npollers: 0, open: [:] } }

// Close a dropped Listener or Conn (a listener with the connections it has
// accepted that the program never took); closing twice does nothing.
pub fn close_sock(it: mut ieval.Interp, id: Int) {
    if not it.net_state.open.contains(id) { return }
    let _ = it.net_state.open.remove(id)
    it.bp.close(id)
    for c in it.net_state.accq.get(id).unwrap_or([]) {
        it.bp.close(c)
        let _ = it.net_state.buf.remove(c)
        let _ = it.net_state.eof.remove(c)
    }
    let _ = it.net_state.accq.remove(id)
    let _ = it.net_state.buf.remove(id)
    let _ = it.net_state.eof.remove(id)
}

fn ioerr(ix: ieval.Ix, e: IoError) -> ival.Val {
    match e {
        NotFound(s) => ival.venum(ix.io, 0, [ival.vstr(s)]),
        Denied(s) => ival.venum(ix.io, 1, [ival.vstr(s)]),
        Failed(s) => ival.venum(ix.io, 2, [ival.vstr(s)]),
    }
}

fn res_unit(ix: ieval.Ix, r: Result[Unit, IoError]) -> ival.Val {
    match r {
        Ok(_) => ieval.ok(ix, ival.unit()),
        Err(e) => ieval.err(ix, ioerr(ix, e)),
    }
}

fn res_int(ix: ieval.Ix, r: Result[Int, IoError]) -> ival.Val {
    match r {
        Ok(x) => ieval.ok(ix, ival.vint(x)),
        Err(e) => ieval.err(ix, ioerr(ix, e)),
    }
}

fn res_bytes(ix: ieval.Ix, r: Result[List[Int], IoError]) -> ival.Val {
    match r {
        Ok(b) => ieval.ok(ix, ival.bytes_val(b)),
        Err(e) => ieval.err(ix, ioerr(ix, e)),
    }
}

fn new_fs(it: mut ieval.Interp, f: Fs) -> ival.Val {
    it.fss.push(f)
    ival.vcap(ival.CAP_FS, it.fss.len() - 1)
}

pub fn sys_op(it: mut ieval.Interp, op: SysOp, a: List[ival.Val], sp: ckast.Span) -> Result[ival.Val, ieval.Ctl] {
    let ix = it.ix
    match op {
        BkNowMs => Ok(ival.vint(it.clock.now_ms())),
        BkMonoNs => Ok(ival.vint(it.clock.mono_ns())),
        BkSleepMs => {
            it.clock.sleep_ms(a[1].i)
            Ok(ival.unit())
        }
        BkRun => Ok(res_int(ix, it.proc.run(a[1].s, ibuiltin.str_list(a[2])))),
        BkEnv => match it.proc.env(a[1].s) {
            Some(v) => Ok(ieval.some(ix, ival.vstr(v))),
            None => Ok(ieval.none(ix)),
        },
        BkRunCapture => {
            let input = ibuiltin.list_bytes(a[4], sp)?
            Ok(res_bytes(ix, it.proc.run_capture(a[1].s, ibuiltin.str_list(a[2]), a[3].s, input, a[5].i)))
        }
        BkExit => {
            let code = a[1].i
            if code < 0 or code > 255 { return ieval.trap("exit status {code} is out of range", sp) }
            it.con.flush()
            Err(CExit(code))
        }
    }
}

pub fn fs_op(it: mut ieval.Interp, op: FsOp, a: List[ival.Val], sp: ckast.Span) -> Result[ival.Val, ieval.Ctl] {
    let f = it.fss[a[0].j]
    let ix = it.ix
    let p = if a.len() > 1 { a[1].s } else { "" } // read_only has no path
    match op {
        BfReadOnly => Ok(new_fs(mut it, f.read_only())),
        BfRead => match f.read(p) {
            Ok(s) => Ok(ieval.ok(ix, ival.vstr(s))),
            Err(e) => Ok(ieval.err(ix, ioerr(ix, e))),
        },
        BfWrite => Ok(res_unit(ix, f.write(p, a[2].s))),
        BfAppend => Ok(res_unit(ix, f.append(p, a[2].s))),
        BfReadBytes => Ok(res_bytes(ix, f.read_bytes(p))),
        BfWriteBytes => {
            let b = ibuiltin.list_bytes(a[2], sp)?
            Ok(res_unit(ix, f.write_bytes(p, b)))
        }
        BfAppendBytes => {
            let b = ibuiltin.list_bytes(a[2], sp)?
            Ok(res_unit(ix, f.append_bytes(p, b)))
        }
        BfTruncate => Ok(res_unit(ix, f.truncate(p, a[2].i))),
        BfExists => Ok(ival.vbool(f.exists(p))),
        BfRemove => Ok(res_unit(ix, f.remove(p))),
        BfList => match f.list(p) {
            Ok(ns) => {
                var out: List[ival.Val] = []
                for n in ns { out.push(ival.vstr(n)) }
                Ok(ieval.ok(ix, ival.vlist(out)))
            }
            Err(e) => Ok(ieval.err(ix, ioerr(ix, e))),
        },
        BfMkdir => Ok(res_unit(ix, f.mkdir(p))),
        BfMkdirOne => Ok(res_unit(ix, f.mkdir_one(p))),
        BfRename => Ok(res_unit(ix, f.rename(p, a[2].s))),
        BfIsDir => Ok(ival.vbool(f.is_dir(p))),
        BfWithin => Ok(new_fs(mut it, f.within(p))),
    }
}

// ---- blocking sockets on the interpreter's own poller ----

fn pump(it: mut ieval.Interp) {
    let evs = it.bp.wait(-1)
    for e in evs {
        match e {
            Accepted(l, c) => {
                var q = it.net_state.accq.get(l).unwrap_or([])
                q.push(c)
                it.net_state.accq[l] = q
            }
            Data(c, s) => {
                var b = it.net_state.buf.get(c).unwrap_or([])
                b.extend(s.bytes())
                it.net_state.buf[c] = b
            }
            Closed(c) => it.net_state.eof[c] = true,
            Timeout => {}
        }
    }
}

fn buffered(it: mut ieval.Interp, c: Int) -> List[Int] { it.net_state.buf.get(c).unwrap_or([]) }
fn at_eof(it: mut ieval.Interp, c: Int) -> Bool { it.net_state.eof.get(c).unwrap_or(false) }

fn conn_val(it: mut ieval.Interp, r: Result[Int, IoError]) -> ival.Val {
    match r {
        Ok(c) => {
            it.net_state.open[c] = true
            ieval.ok(it.ix, ival.vcap(ival.CAP_CONN, c))
        }
        Err(e) => ieval.err(it.ix, ioerr(it.ix, e)),
    }
}

pub fn net_op(it: mut ieval.Interp, op: NetOp, a: List[ival.Val]) -> ival.Val {
    let ix = it.ix
    match op {
        BnListen => match it.bp.listen(a[1].i) {
            Ok(l) => {
                it.net_state.open[l] = true
                ieval.ok(ix, ival.vcap(ival.CAP_LISTENER, l))
            }
            Err(e) => ieval.err(ix, ioerr(ix, e)),
        },
        BnConnect => {
            let r = it.bp.connect(a[1].s, a[2].i)
            conn_val(mut it, r)
        }
        BnPort => ival.vint(it.bp.port(a[0].j)),
        BnAccept => {
            let l = a[0].j
            while it.net_state.accq.get(l).unwrap_or([]).is_empty() { pump(mut it) }
            var q = it.net_state.accq[l]
            let c = q.remove(0)
            it.net_state.accq[l] = q
            conn_val(mut it, Ok(c))
        }
        BnReadLine => {
            let c = a[0].j
            while true {
                let b = buffered(mut it, c)
                match b.index_of(10) {
                    Some(i) => {
                        it.net_state.buf[c] = b.slice(i + 1, b.len())
                        return ieval.ok(ix, ieval.some(ix, ival.vstr(line_text(b.slice(0, i)))))
                    }
                    None => {}
                }
                if at_eof(mut it, c) {
                    if b.is_empty() { return ieval.ok(ix, ieval.none(ix)) }
                    it.net_state.buf[c] = []
                    return ieval.ok(ix, ieval.some(ix, ival.vstr(line_text(b))))
                }
                pump(mut it)
            }
            ival.unit()
        }
        BnRead => {
            let c = a[0].j
            let n = a[1].i.max(0)
            while buffered(mut it, c).len() < n and not at_eof(mut it, c) { pump(mut it) }
            let b = buffered(mut it, c)
            let k = n.min(b.len())
            it.net_state.buf[c] = b.slice(k, b.len())
            ieval.ok(ix, ival.vstr(Str.from_utf8_lossy(b.slice(0, k))))
        }
        BnWrite => match it.bp.send(a[0].j, a[1].s) {
            Ok(_) => ieval.ok(ix, ival.unit()),
            Err(Failed(m)) => {
                let msg = if m.starts_with("send: ") { "write: " + m.slice(6, m.len()) } else { m }
                ieval.err(ix, ioerr(ix, Failed(msg)))
            }
            Err(e) => ieval.err(ix, ioerr(ix, e)),
        },
    }
}

// A line as Conn.read_line returns it: one trailing "\r" removed, invalid UTF-8 replaced.
fn line_text(b: List[Int]) -> Str {
    let n = b.len()
    if n > 0 and b[n - 1] == 13 { Str.from_utf8_lossy(b.slice(0, n - 1)) } else { Str.from_utf8_lossy(b) }
}

// ---- pollers ----

fn event(ix: ieval.Ix, e: NetEvent) -> ival.Val {
    match e {
        Accepted(l, c) => ival.venum(ix.ev, 0, [ival.vint(l), ival.vint(c)]),
        Data(c, s) => ival.venum(ix.ev, 1, [ival.vint(c), ival.vstr(s)]),
        Closed(c) => ival.venum(ix.ev, 2, [ival.vint(c)]),
        Timeout => ival.venum(ix.ev, 3, []),
    }
}

pub fn poller_op(it: mut ieval.Interp, op: PollOp, a: List[ival.Val], sp: ckast.Span) -> Result[ival.Val, ieval.Ctl] {
    let ix = it.ix
    let w = a[0].j // the poller (the Net capability for BpNew)
    match op {
        BpNew => {
            let k = it.net_state.npollers
            if k == 0 { it.pp0 = it.net.poller() }
            else if k == 1 { it.pp1 = it.net.poller() }
            else if k == 2 { it.pp2 = it.net.poller() }
            else if k == 3 { it.pp3 = it.net.poller() }
            else { return ieval.trap("interp: a program may create at most 4 pollers", sp) }
            it.net_state.npollers += 1
            Ok(ival.vcap(ival.CAP_POLLER, k))
        }
        BpListen => Ok(res_int(ix, if w == 0 { it.pp0.listen(a[1].i) } else if w == 1 { it.pp1.listen(a[1].i) } else if w == 2 { it.pp2.listen(a[1].i) } else { it.pp3.listen(a[1].i) })),
        BpConnect => {
            let h = a[1].s
            let port = a[2].i
            Ok(res_int(ix, if w == 0 { it.pp0.connect(h, port) } else if w == 1 { it.pp1.connect(h, port) } else if w == 2 { it.pp2.connect(h, port) } else { it.pp3.connect(h, port) }))
        }
        BpPort => Ok(ival.vint(if w == 0 { it.pp0.port(a[1].i) } else if w == 1 { it.pp1.port(a[1].i) } else if w == 2 { it.pp2.port(a[1].i) } else { it.pp3.port(a[1].i) })),
        BpWait => {
            let t = a[1].i
            let evs = if w == 0 { it.pp0.wait(t) } else if w == 1 { it.pp1.wait(t) } else if w == 2 { it.pp2.wait(t) } else { it.pp3.wait(t) }
            var out: List[ival.Val] = []
            for e in evs { out.push(event(ix, e)) }
            Ok(ival.vlist(out))
        }
        BpSend => {
            let c = a[1].i
            let d = a[2].s
            Ok(res_unit(ix, if w == 0 { it.pp0.send(c, d) } else if w == 1 { it.pp1.send(c, d) } else if w == 2 { it.pp2.send(c, d) } else { it.pp3.send(c, d) }))
        }
        BpClose => {
            let c = a[1].i
            if w == 0 { it.pp0.close(c) } else if w == 1 { it.pp1.close(c) } else if w == 2 { it.pp2.close(c) } else { it.pp3.close(c) }
            Ok(ival.unit())
        }
    }
}
