// [1-9][0-9]{0,3}(,[1-9][0-9]{0,3})*, strictly increasing
fn parse_stops(s: Str) -> Option[List[Int]] {
    var stops: List[Int] = []
    for part in s.split(",") {
        if part.len() < 1 or part.len() > 4 or not part.is_digits() or part.byte(0) == '0' { return None }
        let n = part.to_int()?
        if let Some(last) = stops.last() {
            if n <= last { return None }
        }
        stops.push(n)
    }
    Some(stops)
}

// The number of spaces that replace a tab at column c.
fn tab_width(stops: List[Int], c: Int) -> Int {
    if stops.len() == 1 { return stops[0] - c % stops[0] }
    for s in stops {
        if s > c { return s - c }
    }
    1
}

fn expand(text: Str, stops: List[Int], leading_only: Bool) -> Str {
    var out = ""
    var col = 0
    var leading = true // only spaces and tabs so far on this line
    var copied = 0 // text[copied..i] is still to be copied
    for i in 0..text.len() {
        let b = text.byte(i)
        if b == '\n' {
            col = 0
            leading = true
        } else if b == '\t' {
            if leading or not leading_only {
                out += text.slice(copied, i)
                let n = tab_width(stops, col)
                out += " ".repeat(n)
                col += n
                copied = i + 1
            } else {
                col += 1
            }
        } else {
            if b != ' ' { leading = false }
            // a UTF-8 continuation byte (10xxxxxx) does not start a new column
            if b < 128 or b >= 192 { col += 1 }
        }
    }
    out += text.slice(copied, text.len())
    out
}

fn main(sys: Sys) -> Int {
    let con = sys.console
    var stops = [8]
    var leading_only = false
    var files: List[Str] = []
    let args = sys.args
    var i = 0
    while i < args.len() {
        let a = args[i]
        if a == "-t" {
            if i + 1 >= args.len() {
                con.eprintln("detab: -t needs a value")
                return 2
            }
            let Some(st) = parse_stops(args[i + 1]) else {
                con.eprintln("detab: bad tab stops '{args[i + 1]}'")
                return 2
            }
            stops = st
            i += 2
        } else if a == "-i" {
            leading_only = true
            i += 1
        } else if a.starts_with("-") {
            con.eprintln("detab: unknown option '{a}'")
            return 2
        } else {
            files.push(a)
            i += 1
        }
    }
    var status = 0
    var text = ""
    if files.is_empty() {
        text = con.read_all()
    } else {
        for f in files {
            match sys.fs.read(f) {
                Ok(t) => text += t,
                Err(e) => {
                    con.eprintln("detab: cannot read {f}: {e}")
                    status = 1
                }
            }
        }
    }
    con.print(expand(text, stops, leading_only))
    status
}
