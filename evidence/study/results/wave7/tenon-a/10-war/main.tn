const RANKS: Str = "23456789TJQKA"

fn parse_deck(line: Str) -> Option[List[Int]] {
    if line.is_empty() or line.len() > 52 { return None }
    var deck: List[Int] = []
    for i in 0..line.len() {
        let rank = RANKS.find(line.byte(i).char())?
        deck.push(rank)
    }
    Some(deck)
}

fn card(rank: Int) -> Str { RANKS.byte(rank).char() }

fn draw(deck: mut List[Int]) -> Int { deck.remove(0) }

fn main(sys: Sys) -> Int {
    let con = sys.console
    let args = sys.args
    var max = 1000
    var quiet = false
    var i = 0
    while i < args.len() {
        if args[i] == "-q" {
            quiet = true
            i += 1
        } else if args[i] == "-n" {
            let v = args.get(i + 1).unwrap_or("")
            if v.is_empty() or v.len() > 6 or not v.is_digits() or v.byte(0) == '0' {
                con.eprintln("war: -n needs a number from 1 to 999999")
                return 2
            }
            max = v.to_int().unwrap()
            i += 2
        } else {
            con.eprintln("usage: war [-n MAX] [-q]")
            return 2
        }
    }
    var lines: List[Str] = []
    while let Some(line) = con.read_line() { lines.push(line) }
    if lines.len() != 2 {
        con.eprintln("war: expected exactly two lines, got {lines.len()}")
        return 1
    }
    let Some(deck_a) = parse_deck(lines[0]) else {
        con.eprintln("war: invalid deck for A: '{lines[0]}'")
        return 1
    }
    let Some(deck_b) = parse_deck(lines[1]) else {
        con.eprintln("war: invalid deck for B: '{lines[1]}'")
        return 1
    }
    var a = deck_a
    var b = deck_b
    var round = 0
    while true {
        if round == max {
            con.println("stopped at round {max}")
            return 0
        }
        round += 1
        var pile: List[Int] = []
        var up_a: List[Int] = []
        var up_b: List[Int] = []
        let ca = draw(mut a)
        let cb = draw(mut b)
        pile.push(ca)
        pile.push(cb)
        up_a.push(ca)
        up_b.push(cb)
        var incomplete = false
        while up_a.last().unwrap() == up_b.last().unwrap() {
            if a.len() < 4 or b.len() < 4 {
                incomplete = true
                break
            }
            for _ in 0..4 { pile.push(draw(mut a)) }
            for _ in 0..4 { pile.push(draw(mut b)) }
            up_a.push(pile[pile.len() - 5])
            up_b.push(pile[pile.len() - 1])
        }
        let winner = if incomplete { "-" } else if up_a.last().unwrap() > up_b.last().unwrap() {
            a.extend(pile)
            "A"
        } else {
            b.extend(pile)
            "B"
        }
        if not quiet {
            con.println("{round} {up_a.map(card).join("/")} {up_b.map(card).join("/")} {winner} {a.len()} {b.len()}")
        }
        if incomplete {
            if a.len() > b.len() { con.println("A wins in round {round}") }
            else if b.len() > a.len() { con.println("B wins in round {round}") }
            else { con.println("draw in round {round}") }
            return 0
        }
        if a.is_empty() {
            con.println("B wins in round {round}")
            return 0
        }
        if b.is_empty() {
            con.println("A wins in round {round}")
            return 0
        }
    }
}
