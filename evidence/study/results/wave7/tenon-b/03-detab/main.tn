// `[1-9][0-9]{0,3}`
fn parse_stop(s: Str) -> Option[Int] {
    if s.len() < 1 or s.len() > 4 or not s.is_digits() or s.byte(0) == '0' { return None }
    s.to_int()
}

// STOPS: one or more strictly increasing positive numbers separated by commas
fn parse_stops(s: Str) -> Option[List[Int]] {
    var stops: List[Int] = []
    for piece in s.split(",") {
        let n = parse_stop(piece)?
        if not stops.is_empty() and n <= stops[stops.len() - 1] { return None }
        stops.push(n)
    }
    Some(stops)
}

// Number of spaces that replace a tab at column `col`.
fn tab_width(stops: List[Int], col: Int) -> Int {
    if stops.len() == 1 { return stops[0] - col % stops[0] }
    for s in stops {
        if s > col { return s - col }
    }
    1
}

fn expand(text: Str, stops: List[Int], leading_only: Bool) -> Str {
    var out = ""
    var start = 0        // start of the pending, unchanged part of text
    var col = 0
    var leading = true   // only spaces and tabs so far on this line
    for i in 0..text.len() {
        let b = text.byte(i)
        if b == '\n' {
            col = 0
            leading = true
        } else if b == '\t' {
            if leading or not leading_only {
                out += text.slice(start, i)
                let w = tab_width(stops, col)
                out += " ".repeat(w)
                col += w
                start = i + 1
            } else {
                col += 1
            }
        } else if b < 128 or b >= 192 {
            // the first byte of a character
            col += 1
            if b != ' ' { leading = false }
        }
    }
    out += text.slice(start, text.len())
    out
}

fn main(sys: Sys) -> Int {
    let con = sys.console
    var stops = [8]
    var leading_only = false
    var files: List[Str] = []
    var i = 0
    let args = sys.args
    while i < args.len() {
        let a = args[i]
        i += 1
        if a == "-t" {
            if i >= args.len() {
                con.eprintln("detab: -t needs a value")
                return 2
            }
            let Some(s) = parse_stops(args[i]) else {
                con.eprintln("detab: bad tab stops '{args[i]}'")
                return 2
            }
            stops = s
            i += 1
        } else if a == "-i" {
            leading_only = true
        } else if a.starts_with("-") {
            con.eprintln("detab: unknown option '{a}'")
            return 2
        } else {
            files.push(a)
        }
    }
    var text = ""
    var status = 0
    if files.is_empty() {
        text = con.read_all()
    } else {
        for f in files {
            match sys.fs.read_bytes(f) {
                Ok(bs) => text += Str.from_utf8_lossy(bs),
                Err(e) => {
                    con.eprintln("detab: {f}: {e}")
                    status = 1
                }
            }
        }
    }
    con.print(expand(text, stops, leading_only))
    status
}
