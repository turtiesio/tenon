fn size(s: Str) -> Option[Int] {
    if s.len() < 1 or s.len() > 16 or not s.is_digits() { return None }
    s.to_int()
}
fn human(v: Int, si: Bool, places: Int) -> Str {
    let base = if si { 1000 } else { 1024 }
    let units = if si { ["B", "kB", "MB", "GB", "TB", "PB"] } else { ["B", "KiB", "MiB", "GiB", "TiB", "PiB"] }
    if v < base { return "{v} B" }
    var k = 1
    var divisor = base
    while k < 5 and v >= divisor * base { divisor *= base; k += 1 }
    let scale = if places == 0 { 1 } else if places == 1 { 10 } else { 100 }
    var rounded = (2 * v * scale + divisor) / (2 * divisor)
    while rounded >= base * scale and k < 5 {
        k += 1
        divisor *= base
        rounded = (2 * v * scale + divisor) / (2 * divisor)
    }
    let fraction = if places == 0 { "" } else { "." + (rounded % scale).to_str().pad_left(places, "0") }
    "{rounded / scale}{fraction} {units[k]}"
}
fn main(sys: Sys) -> Int {
    var si = false
    var places = 1
    var values: List[Int] = []
    var i = 0
    while i < sys.args.len() {
        let arg = sys.args[i]
        if arg == "-s" { si = true }
        else if arg == "-p" {
            i += 1
            if i >= sys.args.len() { sys.console.eprintln("missing precision"); return 2 }
            let p = sys.args[i]
            if p != "0" and p != "1" and p != "2" { sys.console.eprintln("invalid precision"); return 2 }
            places = p.to_int().unwrap()
        } else {
            let Some(v) = size(arg) else { sys.console.eprintln("invalid size: {arg}"); return 2 }
            values.push(v)
        }
        i += 1
    }
    var status = 0
    if values.is_empty() {
        while let Some(line) = sys.console.read_line() {
            match size(line) {
                Some(n) => sys.console.println(human(n, si, places)),
                None => { sys.console.println("?"); status = 1 }
            }
        }
    } else {
        for value in values { sys.console.println(human(value, si, places)) }
    }
    status
}
