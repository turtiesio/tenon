fn key(s: Str, fold: Bool, trim: Bool) -> Str {
    var end = s.len()
    if trim { while end > 0 and (s.byte(end - 1) == 32 or s.byte(end - 1) == 9) { end -= 1 } }
    let text = s.slice(0, end)
    if fold { text.lower() } else { text }
}
fn main(sys: Sys) -> Int {
    var paths: List[Str] = []
    var fold = false
    var trim = false
    var quiet = false
    var summary = false
    for arg in sys.args {
        match arg {
            "-i" => fold = true,
            "-b" => trim = true,
            "-q" => quiet = true,
            "-s" => summary = true,
            _ => { if arg.starts_with("-") { return 2 }; paths.push(arg) },
        }
    }
    if paths.len() != 2 or (quiet and summary) { return 2 }
    let Ok(at) = sys.fs.read(paths[0]) else { return 2 }
    let Ok(bt) = sys.fs.read(paths[1]) else { return 2 }
    let a = at.lines()
    let b = bt.lines()
    let ak = a.map(fn(s) => key(s, fold, trim))
    let bk = b.map(fn(s) => key(s, fold, trim))
    let n = a.len()
    let m = b.len()
    var table: List[List[Int]] = []
    for _ in 0..(n + 1) {
        var row: List[Int] = []
        for _ in 0..(m + 1) { row.push(0) }
        table.push(row)
    }
    var ri = n - 1
    while ri >= 0 {
        var rj = m - 1
        while rj >= 0 {
            table[ri][rj] = if ak[ri] == bk[rj] { 1 + table[ri + 1][rj + 1] } else { table[ri + 1][rj].max(table[ri][rj + 1]) }
            rj -= 1
        }
        ri -= 1
    }
    var i = 0
    var j = 0
    var inserted = 0
    var deleted = 0
    var common = 0
    while i < n or j < m {
        if i < n and j < m and ak[i] == bk[j] {
            if not quiet and not summary { sys.console.println("  {a[i]}") }
            common += 1
            i += 1
            j += 1
        } else if i < n and (j == m or table[i + 1][j] >= table[i][j + 1]) {
            if not quiet and not summary { sys.console.println("- {a[i]}") }
            deleted += 1
            i += 1
        } else {
            if not quiet and not summary { sys.console.println("+ {b[j]}") }
            inserted += 1
            j += 1
        }
    }
    if summary { sys.console.println("+{inserted} -{deleted} ={common}") }
    if inserted + deleted > 0 { 1 } else { 0 }
}
