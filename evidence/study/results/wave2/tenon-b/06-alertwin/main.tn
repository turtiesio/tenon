// alertwin: sliding-window error alerting with per-service cooldown.

struct Svc {
    errors: Int,
    warns: Int,
    alerts: Int,
    peak: Int,
    times: List[Int],       // timestamps of accepted ERROR events, ascending
    head: Int,              // times[head..] are inside the current window
    last_alert: Option[Int],
}

struct Event { ts: Int, service: Str, level: Str }

fn all_digits(s: Str) -> Bool {
    for i in 0..s.len() {
        if not s.byte(i).is_digit() { return false }
    }
    true
}

fn only_spaces(s: Str) -> Bool {
    for i in 0..s.len() {
        if s.byte(i) != ' ' { return false }
    }
    true
}

// [a-z][a-z0-9-]{0,31}
fn valid_service(s: Str) -> Bool {
    if s.len() < 1 or s.len() > 32 or not s.byte(0).is_lower() { return false }
    for i in 1..s.len() {
        let c = s.byte(i)
        if not (c.is_lower() or c.is_digit() or c == '-') { return false }
    }
    true
}

fn parse_event(line: Str) -> Option[Event] {
    let f = line.split(" ")
    if f.len() != 3 { return None }
    if f[0].len() < 1 or f[0].len() > 12 or not all_digits(f[0]) { return None }
    if not valid_service(f[1]) { return None }
    if f[2] != "INFO" and f[2] != "WARN" and f[2] != "ERROR" { return None }
    Some(Event { ts: f[0].to_int()?, service: f[1], level: f[2] })
}

// An option value: [0-9]{1,9} within lo..=hi.
fn parse_option(s: Str, lo: Int, hi: Int) -> Option[Int] {
    if s.len() < 1 or s.len() > 9 or not all_digits(s) { return None }
    let v = s.to_int()?
    if v < lo or v > hi { return None }
    Some(v)
}

fn main(sys: Sys) -> Int {
    let con = sys.console
    let args = sys.args
    var window = 60
    var threshold = 3
    var cooldown = 300
    var i = 0
    while i < args.len() {
        if i + 1 >= args.len() {
            con.eprintln("alertwin: bad or incomplete option {args[i]}")
            return 2
        }
        let value = args[i + 1]
        match args[i] {
            "-w" => {
                let Some(v) = parse_option(value, 1, 999999999) else { return 2 }
                window = v
            },
            "-t" => {
                let Some(v) = parse_option(value, 1, 999999999) else { return 2 }
                threshold = v
            },
            "-c" => {
                let Some(v) = parse_option(value, 0, 999999999) else { return 2 }
                cooldown = v
            },
            _ => {
                con.eprintln("alertwin: unknown argument {args[i]}")
                return 2
            },
        }
        i += 2
    }

    var svcs: Map[Str, Svc] = [:]
    var skipped = 0
    var last_ts = -1
    for raw in con.read_all().lines() {
        let line = if raw.ends_with("\r") { raw.slice(0, raw.len() - 1) } else { raw }
        if only_spaces(line) { continue }
        let Some(ev) = parse_event(line) else {
            skipped += 1
            continue
        }
        if ev.ts < last_ts {
            skipped += 1
            continue
        }
        last_ts = ev.ts
        if not svcs.contains(ev.service) {
            svcs[ev.service] = Svc { errors: 0, warns: 0, alerts: 0, peak: 0, times: [], head: 0, last_alert: None }
        }
        if ev.level == "WARN" {
            svcs[ev.service].warns += 1
        } else if ev.level == "ERROR" {
            let t = ev.ts
            svcs[ev.service].errors += 1
            svcs[ev.service].times.push(t)
            while svcs[ev.service].times[svcs[ev.service].head] <= t - window {
                svcs[ev.service].head += 1
            }
            let count = svcs[ev.service].times.len() - svcs[ev.service].head
            if count > svcs[ev.service].peak { svcs[ev.service].peak = count }
            if count >= threshold {
                let in_cooldown = match svcs[ev.service].last_alert {
                    Some(a) => t - a < cooldown,
                    None => false,
                }
                if not in_cooldown {
                    svcs[ev.service].alerts += 1
                    svcs[ev.service].last_alert = Some(t)
                    con.println("ALERT {t} {ev.service} {count}")
                }
            }
        }
    }

    for name in svcs.keys().sorted() {
        let s = svcs[name]
        con.println("{name} errors={s.errors} warns={s.warns} alerts={s.alerts} peak={s.peak}")
    }
    con.println("skipped={skipped}")
    0
}
