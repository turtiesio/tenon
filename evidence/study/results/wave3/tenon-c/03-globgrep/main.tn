enum Token { Star, Any, Literal(Int), Class(Bool, List[(Int, Int)]) }
fn character(p: Str, i: mut Int) -> Option[Int] {
    if i >= p.len() { return None }
    var c = p.byte(i)
    i += 1
    if c == '\\' {
        if i >= p.len() { return None }
        c = p.byte(i)
        i += 1
    }
    Some(c)
}
fn parse(p: Str) -> Option[List[Token]] {
    var out: List[Token] = []
    var i = 0
    while i < p.len() {
        let c = p.byte(i)
        i += 1
        if c == '*' { out.push(Star) } else if c == '?' { out.push(Any) } else if c == '\\' {
            if i >= p.len() { return None }
            out.push(Literal(p.byte(i)))
            i += 1
        } else if c == '[' {
            var neg = false
            if i < p.len() and p.byte(i) == '!' { neg = true; i += 1 }
            var ranges: List[(Int, Int)] = []
            var first = true
            while true {
                if i >= p.len() { return None }
                if p.byte(i) == ']' and not first { i += 1; break }
                let lo = character(p, mut i)?
                first = false
                var hi = lo
                if i + 1 < p.len() and p.byte(i) == '-' and p.byte(i + 1) != ']' {
                    i += 1
                    hi = character(p, mut i)?
                    if lo > hi { return None }
                }
                ranges.push((lo, hi))
            }
            out.push(Class(neg, ranges))
        } else { out.push(Literal(c)) }
    }
    Some(out)
}
fn accepts(t: Token, c: Int, insensitive: Bool) -> Bool {
    let lower = if c.is_upper() { c + 32 } else { c }
    let upper = if c.is_lower() { c - 32 } else { c }
    match t {
        Star | Any => true,
        Literal(v) => if insensitive { (if v.is_upper() { v + 32 } else { v }) == lower } else { v == c },
        Class(neg, ranges) => {
            var found = false
            for (lo, hi) in ranges {
                if (c >= lo and c <= hi) or (insensitive and ((lower >= lo and lower <= hi) or (upper >= lo and upper <= hi))) { found = true }
            }
            found != neg
        }
    }
}
fn matches(tokens: List[Token], line: Str, insensitive: Bool) -> Bool {
    var previous = List.filled(line.len() + 1, false)
    previous[0] = true
    for token in tokens {
        var next = List.filled(line.len() + 1, false)
        match token {
            Star => {
                next[0] = previous[0]
                for j in 1..(line.len() + 1) { next[j] = previous[j] or next[j - 1] }
            }
            _ => {
                for j in 1..(line.len() + 1) { next[j] = previous[j - 1] and accepts(token, line.byte(j - 1), insensitive) }
            }
        }
        previous = next
    }
    previous[line.len()]
}
fn main(sys: Sys) -> Int {
    var insensitive = false
    var invert = false
    var count_only = false
    var literal_next = false
    var pattern: Option[Str] = None
    for arg in sys.args {
        if pattern.is_some() { sys.console.eprintln("extra argument"); return 2 }
        if literal_next { pattern = Some(arg) } else {
            match arg {
                "-i" => insensitive = true,
                "-v" => invert = true,
                "-c" => count_only = true,
                "--" => literal_next = true,
                _ => {
                    if arg.starts_with("-") { sys.console.eprintln("bad option"); return 2 }
                    pattern = Some(arg)
                }
            }
        }
    }
    let Some(p) = pattern else { sys.console.eprintln("missing pattern"); return 2 }
    let Some(tokens) = parse(p) else { sys.console.eprintln("invalid pattern"); return 2 }
    var count = 0
    for raw in sys.console.read_all().lines() {
        let line = raw.strip_suffix("\r").unwrap_or(raw)
        if matches(tokens, line, insensitive) != invert {
            count += 1
            if not count_only { sys.console.println(line) }
        }
    }
    if count_only { sys.console.println("{count}") }
    if count > 0 { 0 } else { 1 }
}
