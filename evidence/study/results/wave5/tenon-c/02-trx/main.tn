fn parse_set(s: Str) -> Option[List[Int]] {
    var tokens: List[(Int, Bool)] = []
    var i = 0
    while i < s.len() {
        var c = s.byte(i)
        var escaped = false
        if c == '\\' {
            i += 1
            if i == s.len() { return None }
            c = s.byte(i)
            escaped = true
            if c == 'n' { c = '\n' }
            else if c == 't' { c = '\t' }
            else if c != '\\' and c != '-' { return None }
        }
        tokens.push((c, escaped))
        i += 1
    }
    var out: List[Int] = []
    var j = 0
    while j < tokens.len() {
        if j + 2 < tokens.len() and tokens[j + 1] == ('-', false) {
            let start = tokens[j].0
            let end = tokens[j + 2].0
            if start > end { return None }
            for code in start..end + 1 { out.push(code) }
            j += 3
        } else { out.push(tokens[j].0); j += 1 }
    }
    Some(out)
}
struct Config { delete: Bool, squeeze: Bool, translate: Bool, first: List[Int], second: List[Int] }
fn config(args: List[Str]) -> Option[Config] {
    var d = false
    var s = false
    var i = 0
    while i < args.len() {
        let arg = args[i]
        if arg == "-d" { d = true }
        else if arg == "-s" { s = true }
        else if arg == "--" { i += 1; break }
        else {
            if arg.starts_with("-") and arg.len() >= 2 { return None }
            break
        }
        i += 1
    }
    let count = args.len() - i
    let required = if d { if s { 2 } else { 1 } } else { if s and count == 1 { 1 } else { 2 } }
    if count != required { return None }
    let first = parse_set(args[i])?
    let second = if count == 2 { parse_set(args[i + 1])? } else { first }
    if not d and count == 2 and second.is_empty() { return None }
    Some(Config { delete: d, squeeze: s, translate: not d and count == 2, first, second })
}
fn main(sys: Sys) -> Int {
    let Some(cfg) = config(sys.args) else { sys.console.eprintln("invalid arguments"); return 2 }
    var mapping: Map[Int, Int] = [:]
    for (idx, ch) in cfg.first.enumerate() {
        mapping[ch] = if not cfg.translate { ch } else { cfg.second[idx.min(cfg.second.len() - 1)] }
    }
    let squeeze_set = cfg.second
    var out: List[Int] = []
    var previous = -1
    for byte in sys.console.read_all_bytes() {
        if cfg.delete and mapping.contains(byte) { continue }
        let translated = if cfg.delete { byte } else { mapping.get_or(byte, byte) }
        if cfg.squeeze and translated == previous and squeeze_set.contains(translated) { continue }
        out.push(translated)
        previous = translated
    }
    sys.console.write_bytes(out)
    0
}
