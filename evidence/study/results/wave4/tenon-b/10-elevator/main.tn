// elevator FLOORS: single-elevator simulation

struct Req { time: Int, from: Int, to: Int }

enum Dir { Up, Down, Idle }

fn parse_num(s: Str, max_digits: Int) -> Option[Int] {
    if s.len() > max_digits or not s.is_digits() { return None }
    s.to_int()
}

// Err(reason) if the input breaks the format.
fn parse_requests(text: Str, floors: Int) -> Result[List[Req], Str] {
    var reqs: List[Req] = []
    var prev = 0
    for (ln, raw) in text.lines().enumerate() {
        let line = raw.strip_suffix("\r").unwrap_or(raw)
        if line.trim_chars(" ").is_empty() { continue }
        let t = line.split(" ")
        if t.len() != 3 { return Err("line {ln + 1}: expected '<time> <from> <to>'") }
        let Some(time) = parse_num(t[0], 6) else { return Err("line {ln + 1}: bad time") }
        let Some(from) = parse_num(t[1], 3) else { return Err("line {ln + 1}: bad from floor") }
        let Some(to) = parse_num(t[2], 3) else { return Err("line {ln + 1}: bad to floor") }
        if from >= floors or to >= floors { return Err("line {ln + 1}: floor out of range") }
        if from == to { return Err("line {ln + 1}: from equals to") }
        if time < prev { return Err("line {ln + 1}: time goes backwards") }
        prev = time
        reqs.push(Req { time: time, from: from, to: to })
    }
    Ok(reqs)
}

fn main(sys: Sys) -> Int {
    let con = sys.console
    if sys.args.len() != 1 {
        con.eprintln("usage: elevator FLOORS")
        return 2
    }
    let Some(floors) = parse_num(sys.args[0], 3) else {
        con.eprintln("elevator: bad FLOORS '{sys.args[0]}'")
        return 2
    }
    if floors < 2 or floors > 100 {
        con.eprintln("elevator: FLOORS must be 2..100")
        return 2
    }
    let reqs = match parse_requests(con.read_all(), floors) {
        Ok(r) => r,
        Err(msg) => {
            con.eprintln("elevator: {msg}")
            return 1
        }
    }
    let n = reqs.len()
    // waiting[f]: passengers waiting on floor f; riding[f]: passengers on board bound for f
    var waiting: List[List[Int]] = List.filled(floors, [])
    var riding: List[List[Int]] = List.filled(floors, [])
    var board = List.filled(n, 0)
    var arrive = List.filled(n, 0)
    var floor = 0
    var dir = Idle
    var moves = 0
    var stops = 0
    var finish = 0
    var arrived = 0
    var next = 0
    var t = 0
    while arrived < n {
        while next < n and reqs[next].time == t {
            waiting[reqs[next].from].push(next)
            next += 1
        }
        if not riding[floor].is_empty() or not waiting[floor].is_empty() {
            stops += 1
            for p in riding[floor] {
                arrive[p] = t
                arrived += 1
            }
            riding[floor] = []
            for p in waiting[floor] {
                board[p] = t
                riding[reqs[p].to].push(p)
            }
            waiting[floor] = []
            finish = t
        } else {
            // nearest target above and below the current floor
            var above = -1
            var below = -1
            for f in floor + 1..floors {
                if not riding[f].is_empty() or not waiting[f].is_empty() {
                    above = f
                    break
                }
            }
            var f = floor - 1
            while f >= 0 {
                if not riding[f].is_empty() or not waiting[f].is_empty() {
                    below = f
                    break
                }
                f -= 1
            }
            if above < 0 and below < 0 {
                dir = Idle
            } else {
                dir = match dir {
                    Up => if above >= 0 { Up } else { Down },
                    Down => if below >= 0 { Down } else { Up },
                    Idle => if above >= 0 and (below < 0 or above - floor <= floor - below) { Up } else { Down },
                }
                if dir == Up { floor += 1 } else { floor -= 1 }
                moves += 1
            }
        }
        t += 1
    }
    var total_wait = 0
    var out = ""
    for i in 0..n {
        out += "{i + 1} board={board[i]} arrive={arrive[i]}\n"
        total_wait += board[i] - reqs[i].time
    }
    out += "moves={moves} stops={stops} finish={finish} total_wait={total_wait}\n"
    con.print(out)
    0
}
