import fple
import fixture

fn main(sys: Sys) {
    var domain = fixture.new()
    let _ = fixture.apply(mut domain, "buyer", "order", fixture.checkout("order", 3, 1000, None))
    fixture.pay(mut domain, "order")
    let input = fple.ClaimInput { id: "cancel", order: "order", sku: "sku", kind: Cancel, quantity: 1 }
    let _ = fixture.apply(mut domain, "buyer", "claim", RequestClaim(input))
    fixture.expect(fple.allow(domain, "buyer", "approve", MoveClaim("cancel", Processing), 100) == Err(Forbidden), "customer approved claim")
    fixture.expect(fple.allow(domain, "seller", "skip", MoveClaim("cancel", Completed), 100).is_err(), "claim skipped stage")
    fixture.expect(fple.allow(domain, "seller", "assign", AssignShipment("order"), 100).is_err(), "open claim ignored")
    let _ = fixture.apply(mut domain, "seller", "reject", MoveClaim("cancel", Rejected))
    let _ = fixture.apply(mut domain, "buyer", "reopen", MoveClaim("cancel", Requested))
    let _ = fixture.apply(mut domain, "seller", "process", MoveClaim("cancel", Processing))
    let _ = fixture.apply(mut domain, "seller", "complete", MoveClaim("cancel", Completed))
    let first = fple.claim(domain, "buyer", "cancel").unwrap()
    fixture.expect(first.cash == 9667 and first.points == 333, "first cumulative refund slice")
    fixture.delivered(mut domain, "order")
    fixture.claim(mut domain, "exchange", "order", Exchange, 1)
    fixture.expect(fple.claim(domain, "buyer", "exchange").unwrap().cash == 0, "exchange refunded cash")
    fixture.claim(mut domain, "return", "order", Return, 2)
    let second = fple.claim(domain, "buyer", "return").unwrap()
    fixture.expect(second.cash == 19_333 and second.points == 667, "last cumulative refund slice")
    fixture.expect(fple.customer(domain, "buyer", "shop", "buyer").unwrap().points == 1000, "partial refunds lost points")
    fixture.expect(fple.sku(domain, "buyer", "sku").unwrap().stock == 10, "return did not restock exactly once")
    fixture.expect(fple.allow(domain, "buyer", "confirm", Confirm("order"), 100).is_err(), "fully returned order confirmed")
    fixture.expect(fple.allow(domain, "seller", "repeat", MoveClaim("return", Completed), 100).is_err(), "claim completed twice")
    let refund = fixture.apply(mut domain, "seller", "refund", PrepareRefund("cancel", "refund"))
    fixture.expect(refund.effects == [Refund("refund", "order", 9667)], "refund intent")
    let _ = fixture.apply(mut domain, "service", "refund-unknown", ObserveAttempt("refund", Unknown))
    fixture.expect(fple.allow(domain, "seller", "refund-again", PrepareRefund("cancel", "again"), 100).is_err(), "unknown refund retried")
    let _ = fixture.apply(mut domain, "service", "refunded", ObserveAttempt("refund", Approved("refund-tid")))
    let partial = fple.settlement(domain, "seller", "order").unwrap()
    fixture.expect(partial.processor_fee == 677 and partial.platform_fee == 387 and partial.net == 18_269, "partial fee return lost cumulative rounding")
    let _ = fixture.apply(mut domain, "seller", "refund-rest", PrepareRefund("return", "refund-rest"))
    let _ = fixture.apply(mut domain, "service", "rest-refunded", ObserveAttempt("refund-rest", Approved("rest-tid")))
    fixture.expect(fple.settlement(domain, "seller", "order").unwrap().net == 0, "full item refunds did not conserve cash")
    sys.console.println("claims: type-specific stages, exchange, cumulative cash/points, restock, refund reservations")
}
