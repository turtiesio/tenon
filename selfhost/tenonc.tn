// tenonc: the self-hosted Tenon compiler (compare: the bootstrap's `tenon`).
//
//   tenonc check FILE [ROOT]                 type-check; prints `ok` or the first
//                                            diagnostic (as selfhost/check.tn)
//   tenonc emit FILE                         print the C program (= `tenon emit FILE`)
//   tenonc build FILE [-o OUT] [-O0]         compile to a native executable via C
//
// The prelude, the standard library and the C runtime are read from the
// repository ROOT at compile time (ROOT/lib/prelude.tn, ROOT/lib/std/,
// ROOT/runtime/tenon.h): `--root DIR` (any subcommand but `check`), else
// $TENON_ROOT, else the current directory. The bootstrap embeds the same files.
// `build` runs $CC (default `cc`) the way the bootstrap does, keeping OUT.c
// only when $TENON_KEEP_C is set; unlike the bootstrap it keeps no build cache.
import front
import emit

fn usage(con: Console) -> Int {
    con.eprintln("usage:\n  tenonc check FILE [ROOT]\n  tenonc emit FILE [--root DIR]\n  tenonc build FILE [-o OUT] [-O0] [--root DIR]")
    2
}

// The value after flag `name`, if given.
fn flag(args: List[Str], name: Str) -> Option[Str] {
    for i in 0..args.len() - 1 {
        if args[i] == name { return Some(args[i + 1]) }
    }
    None
}

fn root_of(p: Proc, args: List[Str]) -> Str {
    match flag(args, "--root") {
        Some(r) => r,
        None => p.env("TENON_ROOT").unwrap_or("."),
    }
}

fn fail(con: Console, f: front.Failure) -> Int {
    if f.fatal {
        con.eprintln("tenonc: " + f.msg)
        return 2
    }
    con.eprintln(f.render())
    1
}

// The C program for FILE, or the exit status after reporting why there is none.
fn emit_c(sys: Sys, file: Str, root: Str) -> Result[Str, Int] {
    let con = sys.console
    let fr = match front.load(sys.fs, root, file) {
        Ok(x) => x,
        Err(f) => return Err(fail(con, f)),
    }
    let runtime = match sys.fs.read(front.join(root, "runtime/tenon.h")) {
        Ok(s) => s,
        Err(e) => {
            con.eprintln("tenonc: cannot read the C runtime: {e}")
            return Err(2)
        }
    }
    match emit.emit(fr.checked, fr.files.map(fn(f) => f.0), runtime) {
        Ok(c) => Ok(c),
        Err(msg) => {
            con.eprintln("tenonc: " + msg)
            Err(1)
        }
    }
}

fn check(sys: Sys, args: List[Str]) -> Int {
    let con = sys.console
    if args.len() < 1 or args.len() > 2 { return usage(con) }
    let root = if args.len() == 2 { args[1] } else { "." }
    match front.load(sys.fs, root, args[0]) {
        Ok(_) => {
            con.println("ok")
            0
        }
        Err(f) if f.fatal => {
            con.eprintln("tenonc: " + f.msg)
            2
        }
        Err(f) => {
            con.println(f.line_text())
            1
        }
    }
}

fn build(sys: Sys, file: Str, args: List[Str]) -> Int {
    let con = sys.console
    let code = match emit_c(sys, file, root_of(sys.proc, args)) {
        Ok(c) => c,
        Err(status) => return status,
    }
    var dflt = file
    while dflt.ends_with(".tn") { dflt = dflt.slice(0, dflt.len() - 3) }
    let out = flag(args, "-o").unwrap_or(dflt)
    let opt = if args.contains("-O0") { "-O0" } else { "-O2" }
    let cc = sys.proc.env("CC").unwrap_or("cc")
    let cpath = out + ".c"
    match sys.fs.write(cpath, code) {
        Ok(_) => {}
        Err(e) => {
            con.eprintln("tenonc: cannot write {cpath}: {e}")
            return 1
        }
    }
    match sys.proc.run(cc, [opt, "-w", "-std=gnu11", "-pthread", "-o", out, cpath, "-lm"]) {
        Ok(0) => {}
        Ok(_) => {
            con.eprintln("tenonc: C compiler failed on {cpath}")
            return 1
        }
        Err(e) => {
            con.eprintln("tenonc: cannot run {cc}: {e}")
            return 1
        }
    }
    if sys.proc.env("TENON_KEEP_C").is_none() { let _ = sys.fs.remove(cpath) }
    0
}

fn main(sys: Sys) -> Int {
    let con = sys.console
    let args = sys.args
    if args.len() < 2 { return usage(con) }
    let rest = args.slice(1, args.len())
    match args[0] {
        "check" => check(sys, rest),
        "emit" => match emit_c(sys, args[1], root_of(sys.proc, rest)) {
            Ok(c) => {
                con.print(c)
                0
            }
            Err(status) => status,
        },
        "build" => build(sys, args[1], rest),
        _ => usage(con),
    }
}
