// tenonc: the self-hosted Tenon compiler and interpreter, a complete
// replacement for the bootstrap's `tenon` command line:
//
//   tenonc run [--root DIR] FILE [ARGS...]    interpret (reference semantics)
//   tenonc build FILE [-o OUT] [-O0] [--root DIR]
//                                            compile to a native executable via C
//   tenonc emit FILE [--root DIR]            print the generated C
//   tenonc check FILE [--root DIR]           type-check only
//   tenonc test DIR... [--bless] [--root DIR]
//                                            run the differential test corpus
//   tenonc tokens FILE, tenonc ast FILE      the lexer's and the parser's dumps
//
// Each prints, and exits with, what the same `tenon` subcommand does, except
// that its own messages start with `tenonc:`. The prelude, the standard
// library and the C runtime are read from the repository ROOT at compile time
// (ROOT/lib/prelude.tn, ROOT/lib/std/, ROOT/runtime/tenon.h): `--root DIR`
// (for `run`, before FILE), else $TENON_ROOT, else the current directory. The
// bootstrap embeds the same files. `check FILE ROOT` is also accepted.
//
// `build` runs $CC (default `cc`) the way the bootstrap does and keeps the
// same kind of build cache: an entry is the executable plus its C source, a
// hit requires the source to match exactly; $TENON_CACHE names the directory
// (default $TMPDIR/tenon-cache), `off` disables it, and $TENON_KEEP_C keeps
// OUT.c next to the output (and bypasses the cache).
import front
import emit
import interp
import lexer
import astdump
import testrun

fn usage(con: Console) -> Int {
    con.eprintln(
        "usage:\n  tenonc run [--root DIR] FILE.tn [ARGS...]     interpret (reference semantics)\n  tenonc build FILE.tn [-o OUT] [-O0]           compile to a native executable via C\n  tenonc emit FILE.tn                           print the generated C\n  tenonc check FILE.tn                          type-check only\n  tenonc test DIR... [--bless]                  run the differential test corpus\n  tenonc tokens FILE.tn, tenonc ast FILE.tn     the lexer's and the parser's dumps\n(every subcommand but run also takes --root DIR)",
    )
    2
}

// The value after flag `name`, if given.
fn flag(args: List[Str], name: Str) -> Option[Str] {
    for i in 0..args.len() - 1 {
        if args[i] == name { return Some(args[i + 1]) }
    }
    None
}

fn root_of(p: Proc, args: List[Str]) -> Str {
    match flag(args, "--root") {
        Some(r) => r,
        None => p.env("TENON_ROOT").unwrap_or("."),
    }
}

fn fail(con: Console, f: front.Failure) -> Int {
    if f.fatal {
        con.eprintln("tenonc: " + f.msg)
        return 2
    }
    con.eprintln(f.render())
    1
}

// The C program for FILE, or the exit status after reporting why there is none.
fn emit_c(sys: Sys, file: Str, root: Str) -> Result[Str, Int] {
    let con = sys.console
    let fr = match front.load(sys.fs, root, file) {
        Ok(x) => x,
        Err(f) => return Err(fail(con, f)),
    }
    let runtime = match sys.fs.read(front.join(root, "runtime/tenon.h")) {
        Ok(s) => s,
        Err(e) => {
            con.eprintln("tenonc: cannot read the C runtime: {e}")
            return Err(2)
        }
    }
    match emit.emit(fr.checked, fr.files.map(fn(f) => f.0), runtime) {
        Ok(c) => Ok(c),
        Err(msg) => {
            con.eprintln("tenonc: " + msg)
            Err(1)
        }
    }
}

// check FILE [ROOT]: silent when the program is accepted, else the diagnostic
// (exit status 1), like `tenon check`.
fn check(sys: Sys, args: List[Str]) -> Int {
    if args.is_empty() { return usage(sys.console) }
    let root = if args.len() == 2 { args[1] } else { root_of(sys.proc, args) }
    match front.load(sys.fs, root, args[0]) {
        Ok(_) => 0,
        Err(f) => fail(sys.console, f),
    }
}

// A content hash for build cache names: two polynomial hashes modulo primes
// below 2^31 (Int arithmetic must not overflow), as 16 hex digits. A hit is
// verified against the whole C text, so the hash only spreads names.
pub fn hash_hex(s: Str) -> Str {
    var a = 0
    var b = 7
    for i in 0..s.len() {
        let c = s.byte(i) + 1
        a = (a * 31 + c) % 2147483629
        b = (b * 37 + c) % 2147483587
    }
    "{a:08x}{b:08x}"
}

// The cache entry for this C text, compiler and flags, if the cache is on.
fn cache_entry(p: Proc, code: Str, cc: Str, opt: Str) -> Option[Str] {
    if p.env("TENON_KEEP_C").is_some() { return None }
    let dir = match p.env("TENON_CACHE") {
        Some(d) => if d == "off" { return None } else { d },
        None => path_join(p.env("TMPDIR").unwrap_or("/tmp"), "tenon-cache"),
    }
    Some(path_join(dir, "t" + hash_hex(code + "|" + cc + "|" + opt) + "-{code.len()}"))
}

fn compile(sys: Sys, code: Str, cc: Str, out: Str, opt: Str) -> Result[Unit, Str] {
    let cpath = out + ".c"
    match sys.fs.write(cpath, code) {
        Ok(_) => {}
        Err(e) => return Err("cannot write {cpath}: {e}"),
    }
    match sys.proc.run(cc, [opt, "-w", "-std=gnu11", "-pthread", "-o", out, cpath, "-lm"]) {
        Ok(0) => {}
        Ok(_) => return Err("C compiler failed on {cpath}"),
        Err(e) => return Err("cannot run {cc}: {e}"),
    }
    if sys.proc.env("TENON_KEEP_C").is_none() { let _ = sys.fs.remove(cpath) }
    Ok(())
}

fn build(sys: Sys, file: Str, args: List[Str]) -> Int {
    let con = sys.console
    let code = match emit_c(sys, file, root_of(sys.proc, args)) {
        Ok(c) => c,
        Err(status) => return status,
    }
    var dflt = file
    while dflt.ends_with(".tn") { dflt = dflt.slice(0, dflt.len() - 3) }
    let out = flag(args, "-o").unwrap_or(dflt)
    let opt = if args.contains("-O0") { "-O0" } else { "-O2" }
    let cc = sys.proc.env("CC").unwrap_or("cc")
    let entry = cache_entry(sys.proc, code, cc, opt)
    match entry {
        Some(e) => {
            let same = match sys.fs.read(e + ".c") {
                Ok(c) => c == code,
                Err(_) => false,
            }
            if same and sys.proc.run("cp", [e, out]) == Ok(0) { return 0 }
        }
        None => {}
    }
    match compile(sys, code, cc, out, opt) {
        Ok(_) => {}
        Err(msg) => {
            con.eprintln("tenonc: " + msg)
            return 1
        }
    }
    match entry {
        // the executable first, then its source (written atomically), so an
        // entry whose source is present is complete
        Some(e) => {
            let tmp = e + ".x{sys.clock.mono_ns()}"
            if sys.fs.mkdir(path_parent(e)).is_ok() and sys.proc.run("cp", [out, tmp]) == Ok(0) {
                if sys.fs.rename(tmp, e).is_ok() { let _ = sys.fs.write(e + ".c", code) } else { let _ = sys.fs.remove(tmp) }
            }
        }
        None => {}
    }
    0
}

// run [--root DIR] FILE [ARGS...]: interpret FILE with ARGS as its arguments,
// ending with the program's own exit status (also a trap's 70 or 72).
fn run(sys: Sys, args: List[Str]) -> Int {
    var i = 0
    var root = sys.proc.env("TENON_ROOT").unwrap_or(".")
    if args.len() >= 2 and args[0] == "--root" {
        root = args[1]
        i = 2
    }
    if i >= args.len() { return usage(sys.console) }
    match front.load(sys.fs, root, args[i]) {
        Ok(fr) => {
            let status = interp.run(sys, fr, args.slice(i + 1, args.len()))
            sys.proc.exit(status)
            status
        }
        Err(f) => fail(sys.console, f),
    }
}

// tokens FILE / ast FILE: print the dump of the source text.
fn dump(sys: Sys, file: Str, ast: Bool) -> Int {
    match sys.fs.read(file) {
        Ok(src) => {
            sys.console.print(if ast { astdump.dump_src(src) } else { lexer.dump(src) })
            0
        }
        Err(e) => {
            sys.console.eprintln("tenonc: cannot read {file}: {e}")
            2
        }
    }
}

fn main(sys: Sys) -> Int {
    let con = sys.console
    let args = sys.args
    if args.len() < 2 { return usage(con) }
    let rest = args.slice(1, args.len())
    match args[0] {
        "check" => check(sys, rest),
        "emit" => match emit_c(sys, args[1], root_of(sys.proc, rest)) {
            Ok(c) => {
                con.print(c)
                0
            }
            Err(status) => status,
        },
        "build" => build(sys, args[1], rest),
        "run" => run(sys, rest),
        "test" => testrun.main(sys, rest, root_of(sys.proc, rest)),
        "tokens" => dump(sys, args[1], false),
        "ast" => dump(sys, args[1], true),
        _ => usage(con),
    }
}
