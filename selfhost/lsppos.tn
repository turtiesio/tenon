// module
// Positions in source text. The checker reports 1-based lines and 1-based
// byte columns; the Language Server Protocol counts lines from 0 and
// characters in UTF-16 code units. Also file URIs and identifier scanning.
import lexer

// Byte offset of the start of every line (line 1 is element 0).
pub fn line_starts(text: Str) -> List[Int] {
    var out = [0]
    for i in 0..text.len() {
        if text.byte(i) == '\n' { out.push(i + 1) }
    }
    out
}

// The text of line `line` (1-based) without its "\n" (and a "\r" before it); "" if there is none.
pub fn line_text(text: Str, starts: List[Int], line: Int) -> Str {
    if line < 1 or line > starts.len() { return "" }
    let a = starts[line - 1]
    var b = if line < starts.len() { starts[line] - 1 } else { text.len() }
    if b > a and text.byte(b - 1) == '\r' { b -= 1 }
    text.slice(a, b)
}

// Byte offset of (line, col), both 1-based, clamped to the line.
pub fn offset(text: Str, starts: List[Int], line: Int, col: Int) -> Int {
    if line < 1 { return 0 }
    if line > starts.len() { return text.len() }
    let a = starts[line - 1]
    let len = line_text(text, starts, line).len()
    a + (col - 1).max(0).min(len)
}

// UTF-16 code units in the first `bytes` bytes of `s` (a line).
pub fn utf16_len(s: Str, bytes: Int) -> Int {
    var n = 0
    var i = 0
    let end = bytes.min(s.len())
    while i < end {
        let c = s.byte(i)
        if c < 0x80 {
            i += 1
            n += 1
        } else if c < 0xE0 {
            i += 2
            n += 1
        } else if c < 0xF0 {
            i += 3
            n += 1
        } else {
            i += 4
            n += 2
        }
    }
    n
}

// The byte offset in line `s` of UTF-16 character `ch` (clamped to the line).
pub fn utf16_to_byte(s: Str, ch: Int) -> Int {
    var n = 0
    var i = 0
    while i < s.len() and n < ch {
        let c = s.byte(i)
        if c < 0x80 {
            i += 1
            n += 1
        } else if c < 0xE0 {
            i += 2
            n += 1
        } else if c < 0xF0 {
            i += 3
            n += 1
        } else {
            i += 4
            n += 2
        }
    }
    i.min(s.len())
}

// A protocol position (0-based line, UTF-16 character) as a checker position (1-based line and byte column).
pub fn from_lsp(text: Str, starts: List[Int], line: Int, ch: Int) -> (Int, Int) {
    let l = line + 1
    (l, utf16_to_byte(line_text(text, starts, l), ch) + 1)
}

// A checker position as a protocol position.
pub fn to_lsp(text: Str, starts: List[Int], line: Int, col: Int) -> (Int, Int) {
    if line < 1 { return (0, 0) }
    ((line - 1), utf16_len(line_text(text, starts, line), col - 1))
}

pub fn is_ident_byte(c: Int) -> Bool { c.is_alnum() or c == '_' }

// The identifier at byte offset `at` (also when `at` is just after its end): its start and end offsets.
pub fn ident_at(text: Str, at: Int) -> Option[(Int, Int)] {
    var a = at.min(text.len())
    while a > 0 and is_ident_byte(text.byte(a - 1)) { a -= 1 }
    var b = at.min(text.len())
    while b < text.len() and is_ident_byte(text.byte(b)) { b += 1 }
    if a == b or text.byte(a).is_digit() { None } else { Some((a, b)) }
}

// The end offset of the token starting at `at`: an identifier or number, else one character.
pub fn token_end(text: Str, at: Int) -> Int {
    if at >= text.len() { return at }
    var b = at
    while b < text.len() and is_ident_byte(text.byte(b)) { b += 1 }
    if b > at { return b }
    b = at + 1
    while b < text.len() and text.byte(b) >= 0x80 and text.byte(b) < 0xC0 { b += 1 }
    b
}

// The first whole-word occurrence of `word` at or after offset `from`,
// outside `//` comments (a field's name may also appear in the comment above it).
pub fn find_word(text: Str, word: Str, from: Int) -> Option[Int] {
    var i = from.max(0)
    while true {
        let Some(j) = text.find_from(word, i) else { return None }
        match text.find_from("//", i) {
            Some(c) if c < j => {
                i = text.find_from("\n", c).map_or(text.len(), fn(n) => n + 1)
                continue
            }
            _ => {}
        }
        let left = j == 0 or not is_ident_byte(text.byte(j - 1))
        let right = j + word.len() >= text.len() or not is_ident_byte(text.byte(j + word.len()))
        if left and right { return Some(j) }
        i = j + 1
    }
    None
}

// (line, col) of a byte offset, both 1-based.
pub fn line_col(starts: List[Int], off: Int) -> (Int, Int) {
    let line = match starts.binary_search(off) {
        Ok(i) => i + 1,
        Err(i) => i,
    }
    (line, off - starts[line - 1] + 1)
}

// ---- file URIs ----

// The path of a `file:` URI (percent-decoded); None for other schemes.
pub fn uri_path(uri: Str) -> Option[Str] {
    let rest = uri.strip_prefix("file://")?
    var bytes: List[Int] = []
    var i = 0
    while i < rest.len() {
        let c = rest.byte(i)
        let h = if i + 2 < rest.len() { lexer.digit_value(rest.byte(i + 1)) } else { 99 }
        let l = if i + 2 < rest.len() { lexer.digit_value(rest.byte(i + 2)) } else { 99 }
        if c == '%' and h < 16 and l < 16 {
            bytes.push(h * 16 + l)
            i += 3
        } else {
            bytes.push(c)
            i += 1
        }
    }
    Str.from_utf8(bytes)
}

// The `file:` URI of an absolute path, percent-encoding what RFC 3986 does not allow in a path.
pub fn path_uri(path: Str) -> Str {
    var out = "file://"
    for i in 0..path.len() {
        let c = path.byte(i)
        if c.is_alnum() or c == '/' or c == '-' or c == '.' or c == '_' or c == '~' {
            out += c.char()
        } else {
            out += "%" + c.to_str_radix(16).upper().pad_left(2, "0")
        }
    }
    out
}
