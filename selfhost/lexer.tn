// module
// Self-hosted lexer: a second, independent implementation of bootstrap/src/lexer.rs.
// `lexer FILE` must print exactly what `tenon tokens FILE` prints, for every
// file in the corpus (checked by tools/selfhost.sh).

pub enum Tok { Ident(Str), Kw(Str), Sym(Str), IntTok(Int), FloatTok(Float), StrTok(List[Part]), Eof }

// `{tokens}` or `{tokens:SPEC}` (the spec's raw text and position)
pub enum Part { Lit(Str), Interp(List[Token], Option[SpecText]) }

pub struct SpecText { pub text: Str, pub line: Int, pub col: Int }

pub struct Token { pub tok: Tok, pub line: Int, pub col: Int }

pub struct LexError { pub line: Int, pub col: Int, pub msg: Str }

struct Lx { src: Str, pos: Int, line: Int, col: Int }

pub fn keywords() -> List[Str] {
    ["fn", "let", "var", "if", "else", "while", "for", "in", "match", "return", "break",
        "continue", "struct", "enum", "true", "false", "and", "or", "not", "mut", "self", "linear",
        "unique", "import", "extern", "pub", "ref", "const", "trait", "impl", "dyn"]
}

// Longest first so that greedy matching works.
fn symbols() -> List[Str] {
    ["..", "==", "!=", "<=", ">=", "->", "=>", "+=", "-=", "*=", "/=", "%=", "+", "-", "*", "/",
        "%", "<", ">", "=", "(", ")", "[", "]", "\{", "}", ",", ":", ";", ".", "?", "|", "_"]
}

fn is_digit(c: Int) -> Bool { c >= 48 and c <= 57 }
fn is_alpha(c: Int) -> Bool { (c >= 65 and c <= 90) or (c >= 97 and c <= 122) }
fn is_ident_char(c: Int) -> Bool { is_alpha(c) or is_digit(c) or c == 95 }

fn Lx.peek(self, off: Int) -> Int {
    if self.pos + off < self.src.len() { self.src.byte(self.pos + off) } else { 0 }
}

fn Lx.bump(mut self) -> Int {
    let c = self.peek(0)
    self.pos += 1
    if c == 10 {
        self.line += 1
        self.col = 1
    } else {
        self.col += 1
    }
    c
}

fn Lx.fail(self, line: Int, col: Int, msg: Str) -> LexError { LexError { line, col, msg } }

// Lex until EOF, or (inside string interpolation) until the unmatched `}`
// or a `:` outside any ( ) [ ] { }, which starts a format spec.
fn Lx.tokens(mut self, in_interp: Bool) -> Result[List[Token], LexError] {
    var out: List[Token] = []
    var depth = 0
    var nest = 0 // open ( [ {
    while true {
        // whitespace and comments
        while true {
            let c = self.peek(0)
            if c == 10 {
                out.push(Token { tok: Sym("\n"), line: self.line, col: self.col })
                let _ = self.bump()
            } else if c == 32 or c == 9 or c == 13 {
                let _ = self.bump()
            } else if c == 47 and self.peek(1) == 47 {
                while self.peek(0) != 10 and self.pos < self.src.len() { let _ = self.bump() }
            } else {
                break
            }
        }
        let (line, col) = (self.line, self.col)
        if self.pos >= self.src.len() {
            if in_interp { return Err(self.fail(line, col, "unterminated interpolation in string")) }
            out.push(Token { tok: Eof, line, col })
            return Ok(out)
        }
        let c = self.peek(0)
        if in_interp and c == 125 and depth == 0 {
            let _ = self.bump()
            return Ok(out)
        }
        if in_interp and c == 58 and nest == 0 {
            let _ = self.bump()
            return Ok(out)
        }
        let tok = if is_digit(c) {
            // after `.`, digits are a tuple index: `t.0.1` is t . 0 . 1
            let after_dot = match out.last() {
                Some(t) => t.tok == Sym("."),
                None => false,
            }
            self.number(after_dot)?
        } else if is_alpha(c) or (c == 95 and is_ident_char(self.peek(1))) {
            let start = self.pos
            while is_ident_char(self.peek(0)) { let _ = self.bump() }
            let s = self.src.slice(start, self.pos)
            // `r"..."` is a raw string; `r` directly followed by `"` is
            // never valid code otherwise (a name followed by a string).
            if s == "r" and self.peek(0) == 34 {
                self.raw_string(line, col)?
            } else if keywords().contains(s) { Kw(s) } else { Ident(s) }
        } else if c == 39 {
            self.char_lit()?
        } else if c == 34 {
            self.string()?
        } else {
            let rest = self.src.slice(self.pos, self.src.len())
            if rest.starts_with("||") { return Err(self.fail(line, col, "unexpected '||' (write 'or')")) }
            match symbols().filter(fn(s) => rest.starts_with(s)).first() {
                Some(s) => {
                    for _ in 0..s.len() { let _ = self.bump() }
                    if s == "\{" { depth += 1 } else if s == "}" { depth = (depth - 1).max(0) }
                    if s == "(" or s == "[" or s == "\{" { nest += 1 } else if s == ")" or s == "]" or s == "}" { nest = (nest - 1).max(0) }
                    Sym(s)
                }
                None => {
                    var n = 1
                    while n < rest.len() and rest.byte(n) >= 128 and rest.byte(n) < 192 { n += 1 }
                    let ch = rest.slice(0, n)
                    let hint = if ch == "!" { " (write 'not' for negation)" } else if ch == "&" { " (write 'and')" } else { "" }
                    return Err(self.fail(line, col, "unexpected character '{ch}'{hint}"))
                }
            }
        }
        out.push(Token { tok, line, col })
    }
    Ok(out)
}

fn Lx.number(mut self, int_only: Bool) -> Result[Tok, LexError] {
    let (line, col) = (self.line, self.col)
    if not int_only and self.peek(0) == '0' and "xboXBO".contains(self.peek(1).char()) {
        return self.radix_number()
    }
    let start = self.pos
    while is_digit(self.peek(0)) or self.peek(0) == 95 { let _ = self.bump() }
    if int_only {
        return match self.src.slice(start, self.pos).replace("_", "").to_int() {
            Some(i) => Ok(IntTok(i)),
            None => Err(self.fail(line, col, "integer literal does not fit in Int (64-bit, INT_MIN to INT_MAX)")),
        }
    }
    var is_float = false
    if self.peek(0) == 46 and is_digit(self.peek(1)) {
        is_float = true
        let _ = self.bump()
        while is_digit(self.peek(0)) or self.peek(0) == 95 { let _ = self.bump() }
    }
    if self.peek(0) == 101 or self.peek(0) == 69 {
        let save = (self.pos, self.line, self.col)
        let _ = self.bump()
        if self.peek(0) == 45 or self.peek(0) == 43 { let _ = self.bump() }
        if is_digit(self.peek(0)) {
            is_float = true
            while is_digit(self.peek(0)) { let _ = self.bump() }
        } else {
            self.pos = save.0
            self.line = save.1
            self.col = save.2
        }
    }
    let text = self.src.slice(start, self.pos).replace("_", "")
    if is_float {
        match text.to_float() {
            Some(f) => Ok(FloatTok(f)),
            None => Err(self.fail(line, col, "invalid float literal")),
        }
    } else {
        match text.to_int() {
            Some(i) => Ok(IntTok(i)),
            None => Err(self.fail(line, col, "integer literal does not fit in Int (64-bit, INT_MIN to INT_MAX)")),
        }
    }
}

// The value of an ASCII digit or letter as a digit (`a`/`A` is 10), or 99.
fn digit_value(c: Int) -> Int {
    if is_digit(c) { c - '0' } else if c >= 'a' and c <= 'z' { c - 'a' + 10 } else if c >= 'A' and c <= 'Z' { c - 'A' + 10 } else { 99 }
}

// `0xFF`, `0b1010`, `0o17`, with `_` separators anywhere after the prefix.
// Every letter and digit after the prefix belongs to the literal.
fn Lx.radix_number(mut self) -> Result[Tok, LexError] {
    let (line, col) = (self.line, self.col)
    let _ = self.bump()
    let p = self.bump()
    let (radix, name) = match p {
        'x' => (16, "hex"),
        'b' => (2, "binary"),
        'o' => (8, "octal"),
        _ => return Err(self.fail(line, col, "write the number prefix in lowercase: '0{(p + 32).char()}'")),
    }
    let start = self.pos
    while is_ident_char(self.peek(0)) { let _ = self.bump() }
    let digits = self.src.slice(start, self.pos).replace("_", "")
    if digits.is_empty() or digit_value(digits.byte(0)) >= radix {
        return Err(self.fail(line, col, "expected {name} digits after '0{p.char()}'"))
    }
    for i in 0..digits.len() {
        if digit_value(digits.byte(i)) >= radix { return Err(self.fail(line, col, "'{digits.slice(i, i + 1)}' is not a {name} digit")) }
    }
    var v = 0
    for i in 0..digits.len() {
        let d = digit_value(digits.byte(i))
        v = match v.checked_mul(radix).and_then(fn(x) => x.checked_add(d)) {
            Some(x) => x,
            None => return Err(self.fail(line, col, "integer literal does not fit in Int (64-bit, INT_MIN to INT_MAX)")),
        }
    }
    Ok(IntTok(v))
}

// 'a', '\n', 'é': the character's code point, as an Int.
fn Lx.char_lit(mut self) -> Result[Tok, LexError] {
    let (line, col) = (self.line, self.col)
    let bad = self.fail(line, col, "a character literal is one character in single quotes, like 'a' or '\\n'")
    let _ = self.bump()
    let c = self.peek(0)
    var code = 0
    if c == '\\' {
        let _ = self.bump()
        let e = self.bump()
        code = match e {
            'n' => '\n',
            't' => '\t',
            'r' => '\r',
            '0' => 0,
            '\\' => '\\',
            '\'' => '\'',
            '"' => '"',
            _ => return Err(self.fail(self.line, self.col, "unknown escape '\\{e.char()}'")),
        }
    } else if c == '\'' or c == '\n' or c == 0 {
        return Err(bad)
    } else {
        // decode one UTF-8 character
        let n = if c < 128 { 1 } else if c < 224 { 2 } else if c < 240 { 3 } else { 4 }
        code = if n == 1 { c } else if n == 2 { c % 32 } else if n == 3 { c % 16 } else { c % 8 }
        let _ = self.bump()
        for _ in 1..n { code = code * 64 + self.bump() % 64 }
    }
    if self.peek(0) != '\'' { return Err(bad) }
    let _ = self.bump()
    Ok(IntTok(code))
}

fn escape(e: Int) -> Option[Str] {
    match e {
        110 => Some("\n"),
        116 => Some("\t"),
        114 => Some("\r"),
        48 => Some("\0"),
        92 => Some("\\"),
        34 => Some("\""),
        123 => Some("\{"),
        125 => Some("\}"),
        _ => None,
    }
}

// r"...": no escapes, no interpolation; ends at the next `"` on the same
// line (a raw string cannot contain `"` or a newline).
fn Lx.raw_string(mut self, line: Int, col: Int) -> Result[Tok, LexError] {
    let _ = self.bump()
    let start = self.pos
    while true {
        if self.pos >= self.src.len() { return Err(self.fail(line, col, "unterminated raw string")) }
        let c = self.peek(0)
        if c == 34 { break }
        if c == 10 { return Err(self.fail(line, col, "unterminated raw string (newline in raw string)")) }
        let _ = self.bump()
    }
    let lit = self.src.slice(start, self.pos)
    let _ = self.bump()
    Ok(StrTok([Lit(lit)]))
}

fn Lx.string(mut self) -> Result[Tok, LexError] {
    let (line, col) = (self.line, self.col)
    let _ = self.bump()
    var parts: List[Part] = []
    var lit = ""
    var run = self.pos // start of the pending run of plain bytes
    while true {
        if self.pos >= self.src.len() { return Err(self.fail(line, col, "unterminated string")) }
        let at = self.pos
        let c = self.bump()
        if c == 34 {
            lit = lit + self.src.slice(run, at)
            break
        } else if c == 10 {
            return Err(self.fail(line, col, "unterminated string (newline in string)"))
        } else if c == 92 {
            lit = lit + self.src.slice(run, at)
            let e = self.bump()
            match escape(e) {
                Some(s) => lit = lit + s,
                None => return Err(self.fail(self.line, self.col, "unknown escape '\\{e.char()}'")),
            }
            run = self.pos
        } else if c == 123 {
            lit = lit + self.src.slice(run, at)
            if lit != "" {
                parts.push(Lit(lit))
                lit = ""
            }
            let (iline, icol) = (self.line, self.col)
            let toks = self.tokens(true)?.filter(fn(t) => t.tok != Sym("\n"))
            if toks.is_empty() {
                return Err(self.fail(iline, icol, "empty interpolation '\{\}' (write \\\{ for a brace)"))
            }
            var spec: Option[SpecText] = None
            if self.src.byte(self.pos - 1) == 58 {
                // the format spec: raw text up to the next `}`
                let (sline, scol) = (self.line, self.col)
                let start = self.pos
                while self.peek(0) != 125 {
                    if self.pos >= self.src.len() or self.peek(0) == 10 or self.peek(0) == 34 {
                        return Err(self.fail(sline, scol, "unterminated format spec in interpolation (expected '}')"))
                    }
                    let _ = self.bump()
                }
                spec = Some(SpecText { text: self.src.slice(start, self.pos), line: sline, col: scol })
                let _ = self.bump()
            }
            var all = toks
            all.push(Token { tok: Eof, line: self.line, col: self.col })
            parts.push(Interp(all, spec))
            run = self.pos
        }
    }
    if lit != "" or parts.is_empty() { parts.push(Lit(lit)) }
    Ok(StrTok(parts))
}

fn is_ender(t: Tok) -> Bool {
    match t {
        Ident(_) | IntTok(_) | FloatTok(_) | StrTok(_) => true,
        Sym(s) => [")", "]", "}", "?", "_"].contains(s),
        Kw(k) => ["return", "break", "continue", "true", "false", "self"].contains(k),
        Eof => false,
    }
}

fn continues(t: Tok) -> Bool {
    match t {
        Sym(s) => [".", "+", "*", "/", "%", "==", "!=", "<", "<=", ">", ">="].contains(s),
        Kw(k) => k == "else" or k == "and" or k == "or",
        _ => false,
    }
}

// Newlines end statements, except before `.`/`else` and inside ( ) and [ ].
fn insert_semis(raw: List[Token]) -> List[Token] {
    var out: List[Token] = []
    var stack: List[Str] = []
    for i in 0..raw.len() {
        let t = raw[i]
        match t.tok {
            Sym("\n") => {
                let top = stack.last()
                let in_braces = top == None or top == Some("\{")
                let prev_ends = match out.last() {
                    Some(p) => is_ender(p.tok),
                    None => false,
                }
                var j = i + 1
                while j < raw.len() and raw[j].tok == Sym("\n") { j += 1 }
                // A line continues the previous one when it starts with `.`, `else`
                // or a binary operator other than `-` (which may be a negation).
                let next_continues = j < raw.len() and continues(raw[j].tok)
                if in_braces and prev_ends and not next_continues {
                    out.push(Token { tok: Sym(";"), line: t.line, col: t.col })
                }
                continue
            }
            Sym(s) if s == "(" or s == "[" or s == "\{" => stack.push(s),
            Sym(s) if s == ")" or s == "]" or s == "}" => { let _ = stack.pop() }
            _ => {}
        }
        out.push(t)
    }
    out
}

pub fn lex(src: Str) -> Result[List[Token], LexError] {
    var lx = Lx { src, pos: 0, line: 1, col: 1 }
    Ok(insert_semis(lx.tokens(false)?))
}

fn quoted(s: Str) -> Str {
    let q = [s].to_str()
    q.slice(1, q.len() - 1)
}

fn dump_into(toks: List[Token], depth: Int, out: List[Str]) -> List[Str] {
    var o = out
    let pad = "  ".repeat(depth)
    for t in toks {
        let (k, v) = match t.tok {
            Ident(s) => ("ident", s),
            Kw(s) => ("kw", s),
            Sym(s) => ("sym", s),
            IntTok(i) => ("int", i.to_str()),
            FloatTok(f) => ("float", f.to_str()),
            StrTok(_) => ("str", ""),
            Eof => ("eof", ""),
        }
        o.push("{pad}{t.line}:{t.col} {k} {v}")
        match t.tok {
            StrTok(parts) => {
                for p in parts {
                    match p {
                        Lit(l) => o.push("{pad}  lit {quoted(l)}"),
                        Interp(ts, spec) => {
                            o.push("{pad}  expr")
                            o = dump_into(ts, depth + 2, o)
                            match spec {
                                Some(sp) => o.push("{pad}  spec {sp.line}:{sp.col} {quoted(sp.text)}"),
                                None => {}
                            }
                        }
                    }
                }
            }
            _ => {}
        }
    }
    o
}

pub fn dump(src: Str) -> Str {
    match lex(src) {
        Ok(toks) => dump_into(toks, 0, []).join("\n") + "\n",
        Err(e) => "error {e.line}:{e.col} {e.msg}\n",
    }
}
