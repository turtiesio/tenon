// module
// Self-hosted type checker: a second, independent implementation of
// bootstrap/src/check.rs, bootstrap/src/check_expr.rs, bootstrap/src/exhaust.rs and bootstrap/src/linear.rs.
// `check FILE` must report the same first diagnostic as `tenon-seed check FILE`
// for every file in the corpus (tools/selfhost.sh).
//
//   ckast    syntax tree with ids, conversion from the parser, fix_paths
//   cktypes  types, substitution, unification
//   ckenv    declarations and type resolution across modules
//   ckinfer  function bodies: inference, methods, places, patterns
//   ckexh    match exhaustiveness and reachability
//   cklin    linear and unique types, codec restrictions

import ckast
import ckenv
import ckinfer
import cklin
import cktypes

// What the backend needs (bootstrap/src/check.rs `Checked`): the program, the
// declarations, and the side tables keyed by node id.
pub struct Checked {
    pub prog: ckast.Program,
    pub env: ckenv.Env,
    pub types: Map[Int, cktypes.Ty],
    pub res: Map[Int, ckenv.Res],
    pub captures: Map[Int, List[(Str, cktypes.Ty)]],
    pub main: Int,
}

// Check a whole program (prelude, main file and modules, already merged).
pub fn check(prog: ckast.Program) -> Result[Checked, ckast.Diag] {
    let env = ckenv.declare(prog)?
    var ck = ckinfer.new_ck(env)
    for i in 0..prog.fns.len() { ck.check_fn(prog.fns[i], i)? }
    var main = -1
    for i in 0..prog.fns.len() {
        if main < 0 and prog.fns[i].name == "main" and prog.fns[i].owner.is_none() { main = i }
    }
    if main < 0 { return ckast.fail(ckast.Span { file: 1, line: 1, col: 1 }, "program has no 'fn main'") }
    ck.env.check_main(main)?
    const_cycles(prog, ck.res)?
    cklin.check_all(ck.env, prog.fns, ck.types, ck.res, ck.captures)?
    Ok(Checked { prog, env: ck.env, types: ck.types, res: ck.res, captures: ck.captures, main })
}

// `check` for tools (the language server): the same first diagnostic, but a
// failing function does not stop the others from being checked, so the side
// tables cover every function (the failing one up to its error). No tables if
// the declarations fail.
pub fn check_lenient(prog: ckast.Program) -> (Option[ckast.Diag], Option[Checked]) {
    let env = match ckenv.declare(prog) {
        Ok(e) => e,
        Err(d) => return (Some(d), None),
    }
    var ck = ckinfer.new_ck(env)
    var first: Option[ckast.Diag] = None
    for i in 0..prog.fns.len() {
        match ck.check_fn(prog.fns[i], i) {
            Ok(_) => {}
            Err(d) => {
                ck.keep_pending()
                if first.is_none() { first = Some(d) }
            }
        }
    }
    var main = -1
    for i in 0..prog.fns.len() {
        if main < 0 and prog.fns[i].name == "main" and prog.fns[i].owner.is_none() { main = i }
    }
    if first.is_none() {
        let rest = if main < 0 {
            ckast.fail(ckast.Span { file: 1, line: 1, col: 1 }, "program has no 'fn main'")
        } else {
            ck.env.check_main(main)
                .and_then(fn(_) => const_cycles(prog, ck.res))
                .and_then(fn(_) => cklin.check_all(ck.env, prog.fns, ck.types, ck.res, ck.captures))
        }
        match rest {
            Ok(_) => {}
            Err(d) => first = Some(d),
        }
    }
    (first, Some(Checked { prog, env: ck.env, types: ck.types, res: ck.res, captures: ck.captures, main }))
}

// The constants referenced anywhere in an expression, in traversal order.
fn const_refs(e: ckast.Expr, res: Map[Int, ckenv.Res]) -> List[Int] {
    var out: List[Int] = []
    match res.get(e.id) {
        Some(RConst(j)) => out.push(j),
        _ => {}
    }
    for c in ckast.children(e) { out.extend(const_refs(c, res)) }
    out
}

fn deps(prog: ckast.Program, res: Map[Int, ckenv.Res], fi: Int) -> List[Int] {
    var out: List[Int] = []
    match prog.fns[fi].body {
        Some(b) => {
            for s in b.stmts {
                for e in ckast.stmt_exprs(s) { out.extend(const_refs(e, res)) }
            }
        }
        None => {}
    }
    out
}

// A constant may not depend on itself through other constants.
fn const_cycles(prog: ckast.Program, res: Map[Int, ckenv.Res]) -> Result[Unit, ckast.Diag] {
    for start in 0..prog.fns.len() {
        if prog.fns[start].is_const {
            var stack: List[(Int, List[Int])] = [(start, [start])]
            var seen: List[Bool] = prog.fns.map(fn(f) => false)
            while not stack.is_empty() {
                let (fi, path) = stack.pop().unwrap()
                for d in deps(prog, res, fi) {
                    if d == start {
                        let names = (path + [start]).map(fn(i) => prog.fns[i].name)
                        return ckast.fail(prog.fns[start].sp, "constant '" + prog.fns[start].name + "' depends on itself (" + names.join(" -> ") + ")")
                    }
                    if not seen[d] {
                        seen[d] = true
                        stack.push((d, path + [d]))
                    }
                }
            }
        }
    }
    Ok(())
}
