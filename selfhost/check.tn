// check FILE [ROOT]: the self-hosted checker (compare: tenon check FILE).
// Prints `ok`, or the first diagnostic as `PATH:LINE:COL: error: MESSAGE`.
// ROOT (default `.`) is the repository, where lib/prelude.tn and the
// standard library (lib/std/) are read from. `tenonc check` does the same.
import front

fn main(sys: Sys) -> Int {
    let con = sys.console
    if sys.args.len() < 1 or sys.args.len() > 2 {
        con.eprintln("usage: check FILE [ROOT]")
        return 2
    }
    let root = if sys.args.len() == 2 { sys.args[1] } else { "." }
    match front.load(sys.fs, root, sys.args[0]) {
        Ok(_) => {
            con.println("ok")
            0
        }
        Err(f) if f.fatal => {
            con.eprintln("check: " + f.msg)
            2
        }
        Err(f) => {
            con.println(f.line_text())
            1
        }
    }
}
