// module
// Declarations: the tables of structs, enums and functions, type resolution
// across modules, and the declaration checks of bootstrap/src/check.rs `declare`,
// `check_recursion`, `check_main` and bootstrap/src/linear.rs `check_decls`.

import ckast
import cktypes

pub struct StructInfo {
    pub name: Str, pub tparams: List[Str], pub fields: List[(Str, cktypes.Ty)], pub kind: ckast.Kind,
    pub file: Int, pub public: Bool, pub pub_fields: List[Bool],
}
pub struct EnumInfo {
    pub name: Str, pub tparams: List[Str], pub variants: List[(Str, List[cktypes.Ty])], pub kind: ckast.Kind,
    pub file: Int, pub public: Bool,
}
pub struct FnInfo {
    pub name: Str, pub tparams: List[Str], pub owner: Option[cktypes.Ty], pub params: List[(Str, cktypes.Ty)],
    pub muts: List[Bool], // per explicit (non-self) parameter: `x: mut T`
    pub ret: cktypes.Ty, pub self_kind: ckast.SelfK, pub is_extern: Bool, pub is_const: Bool, pub public: Bool,
    pub sp: ckast.Span,
    pub bounds: List[List[Int]], // per type parameter: the traits it must implement
    pub origin: ckast.Origin,
}

// A trait method's signature; `Self` is Par("Self"). `default`: the function
// of its default body, or -1.
pub struct TMethod {
    pub name: Str, pub tparams: List[Str], pub self_kind: ckast.SelfK, pub params: List[(Str, cktypes.Ty)],
    pub muts: List[Bool], pub ret: cktypes.Ty, pub default: Int, pub sp: ckast.Span,
}
// `unsafe_why`: why `dyn` cannot be used with it ("" when it can).
pub struct TraitInfo {
    pub name: Str, pub file: Int, pub public: Bool, pub methods: List[TMethod], pub unsafe_why: Str, pub sp: ckast.Span,
}
// `fns[m]`: the function implementing method m of the trait (the impl's own or the default).
pub struct ImplInfo {
    pub tr: Int, pub tparams: List[Str], pub bounds: List[List[Int]], pub target: cktypes.Ty, pub file: Int,
    pub fns: List[Int], pub sp: ckast.Span,
}

// What a name, call or pattern resolved to (bootstrap/src/check.rs `Res`).
pub enum Res {
    RLocal(Str),
    RFn(Int, List[cktypes.Ty]),           // function index, type args (all tparams)
    RVariant(Int, Int, List[cktypes.Ty]), // enum, variant, enum type args
    RField(Int),
    RMethod(Int, List[cktypes.Ty]),
    RStruct(Int),
    RConst(Int), // a `const`: evaluate its function
    RToStr,
    RCallValue,
    RTrait(Int, Int, cktypes.Ty, List[cktypes.Ty]), // trait, method, receiver type, the method's own type args
}

pub struct Env {
    pub structs: List[StructInfo], pub enums: List[EnumInfo], pub fns: List[FnInfo],
    pub struct_ix: Map[Str, Int], pub enum_ix: Map[Str, Int], pub fn_ix: Map[Str, Int],
    pub variant_ix: Map[Str, List[(Int, Int)]], // variant name -> (enum, variant), in declaration order
    pub modules: List[Str], pub imports: List[List[Str]],
    pub cur: Int,                      // file (module) being checked
    pub prelude_items: Map[Str, Bool], // top-level names the prelude declares (hidden by the main file's own)
    pub traits: List[TraitInfo], pub trait_ix: Map[Str, Int], pub impls: List[ImplInfo],
    pub self_ty: Option[cktypes.Ty], // what `Self` means in the function being declared or checked (an impl's type)
}

fn span0() -> ckast.Span { ckast.Span { file: 0, line: 0, col: 0 } }

// Type parameters are `T`, `K`, `V2`, ...; type names are longer.
pub fn is_tparam_name(s: Str) -> Bool {
    if s.len() == 0 or not ckast.upper(s) { return false }
    for i in 1..s.len() {
        let c = s.byte(i)
        if c < 48 or c > 57 { return false }
    }
    true
}

pub fn Env.struct_idx(self, n: Str) -> Option[Int] { self.struct_ix.get(n) }
pub fn Env.enum_idx(self, n: Str) -> Option[Int] { self.enum_ix.get(n) }
pub fn Env.find_fn(self, full: Str) -> Option[Int] { self.fn_ix.get(full) }

// Internal name of item `n` declared in `file`: modules prefix their items.
// The main file's items keep their plain names, except those that hide a
// prelude item: they become `<main>.n`.
pub fn Env.internal(self, file: Int, n: Str) -> Str {
    if file < self.modules.len() and self.modules[file] != "" { return self.modules[file] + "." + n }
    if file == 1 and self.prelude_items.contains(n) { return "<main>." + n }
    n
}

pub fn Env.imported(self, m: Str) -> Bool { self.cur < self.imports.len() and self.imports[self.cur].contains(m) }

pub fn Env.type_decl(self, n: Str) -> Option[(Int, Bool)] {
    match self.struct_idx(n) {
        Some(i) => return Some((self.structs[i].file, self.structs[i].public)),
        None => {}
    }
    match self.enum_idx(n) {
        Some(i) => Some((self.enums[i].file, self.enums[i].public)),
        None => None,
    }
}

// Resolve a type name as written in the current module to its internal name.
pub fn Env.resolve_type(self, n: Str, sp: ckast.Span) -> Result[Str, ckast.Diag] {
    if cktypes.is_builtin(n) { return Ok(n) }
    match n.find(".") {
        Some(i) => {
            let m = n.slice(0, i)
            if not self.imported(m) { return ckast.fail(sp, "unknown module '{m}'; add 'import {m}'") }
            return match self.type_decl(n) {
                Some((_, true)) => Ok(n),
                Some(_) => ckast.fail(sp, "type '{n}' is private to module '{m}'"),
                None => ckast.fail(sp, "module '{m}' has no type '{n.slice(i + 1, n.len())}'"),
            }
        }
        None => {}
    }
    let own = self.internal(self.cur, n)
    if self.type_decl(own).is_some() { return Ok(own) }
    match self.type_decl(n) {
        Some((0, _)) => Ok(n),
        _ => ckast.fail(sp, "unknown type '{n}'"),
    }
}

pub fn Env.arity(self, n: Str) -> Int {
    let b = cktypes.builtin_arity(n)
    if b >= 0 { return b }
    match self.struct_idx(n) {
        Some(i) => return self.structs[i].tparams.len(),
        None => {}
    }
    match self.enum_idx(n) {
        Some(i) => self.enums[i].tparams.len(),
        None => 0,
    }
}

pub fn Env.lower_type(self, t: ckast.TExpr, params: List[Str]) -> Result[cktypes.Ty, ckast.Diag] {
    match t.k {
        TNamed(n0, args) => {
            if params.contains(n0) {
                if not args.is_empty() { return ckast.fail(t.sp, "type parameter '{n0}' takes no arguments") }
                return Ok(Par(n0))
            }
            if n0 == "Self" and args.is_empty() {
                match self.self_ty {
                    Some(st) => return Ok(st),
                    None => return ckast.fail(t.sp, "'Self' is only defined inside a trait or an impl"),
                }
            }
            match n0.strip_prefix("dyn ") {
                Some(tn) => {
                    let ti = self.resolve_trait(tn, t.sp)?
                    self.object_safe(ti, t.sp)?
                    return Ok(Con("dyn " + self.traits[ti].name, []))
                }
                None => {}
            }
            let n = self.resolve_type(n0, t.sp)?
            let ar = self.arity(n)
            if ar != args.len() {
                return ckast.fail(t.sp, "type '{n}' expects {ar} type argument(s), found {args.len()}")
            }
            Ok(Con(n, self.lower_list(args, params)?))
        }
        TFn(a, r) => {
            let args = self.lower_list(a, params)?
            Ok(Fun(args, self.lower_type(r, params)?))
        }
        TTuple(a) => Ok(Tup(self.lower_list(a, params)?)),
    }
}

pub fn Env.lower_list(self, ts: List[ckast.TExpr], params: List[Str]) -> Result[List[cktypes.Ty], ckast.Diag] {
    var out: List[cktypes.Ty] = []
    for t in ts { out.push(self.lower_type(t, params)?) }
    Ok(out)
}

// Linear (must be consumed exactly once) or unique (never copied), including
// any type that contains such a value.
pub fn Env.kind_of(self, t: cktypes.Ty) -> ckast.Kind {
    self.kind_walk(t, Plain, []).0
}

fn note(k: ckast.Kind, d: ckast.Kind) -> ckast.Kind {
    if d == Linear or (d == Unique and k == Plain) { d } else { k }
}

fn Env.kind_walk(self, t: cktypes.Ty, k0: ckast.Kind, seen0: List[cktypes.Ty]) -> (ckast.Kind, List[cktypes.Ty]) {
    if seen0.contains(t) or k0 == Linear { return (k0, seen0) }
    var seen = seen0
    seen.push(t)
    var k = k0
    match t {
        Tup(ts) => {
            for x in ts {
                let r = self.kind_walk(x, k, seen)
                k = r.0
                seen = r.1
            }
        }
        Con(n, _) if cktypes.is_shared_handle(n) => {}
        Con(n, args) => {
            for x in args {
                let r = self.kind_walk(x, k, seen)
                k = r.0
                seen = r.1
            }
            if cktypes.is_unique_builtin(n) {
                k = note(k, Unique)
            } else {
                match self.struct_idx(n) {
                    Some(i) => k = note(k, self.structs[i].kind),
                    None => match self.enum_idx(n) {
                        Some(i) => k = note(k, self.enums[i].kind),
                        None => {}
                    },
                }
            }
        }
        _ => {}
    }
    (k, seen)
}

pub fn Env.struct_fields(self, t: cktypes.Ty) -> Option[List[(Str, cktypes.Ty)]] {
    match t {
        Con(n, args) => match self.struct_idx(n) {
            Some(i) => {
                let s = self.structs[i]
                Some(s.fields.map(fn(f) => (f.0, f.1.subst(s.tparams, args))))
            }
            None => None,
        },
        _ => None,
    }
}

pub fn Env.enum_variants(self, t: cktypes.Ty) -> Option[List[(Str, List[cktypes.Ty])]] {
    match t {
        Con(n, args) => match self.enum_idx(n) {
            Some(i) => {
                let e = self.enums[i]
                Some(e.variants.map(fn(v) => (v.0, v.1.map(fn(x) => x.subst(e.tparams, args)))))
            }
            None => None,
        },
        _ => None,
    }
}

// Why values of t cannot go to another worker (the derived trait Send), or
// None if they can. Sent values are copied into the receiving worker's heap
// (unique ones are moved), so every type is sendable except linear types (a
// channel or a worker that is never joined could drop the obligation) and
// the socket handles (Poller, Listener, Conn: their sockets belong to the
// worker that opened them; send a Net and open them there).
pub fn Env.unsendable_part(self, t: cktypes.Ty) -> Option[Str] { self.unsendable_walk(t, []).0 }

fn Env.unsendable_walk(self, t: cktypes.Ty, seen0: List[cktypes.Ty]) -> (Option[Str], List[cktypes.Ty]) {
    if seen0.contains(t) { return (None, seen0) }
    var seen = seen0
    seen.push(t)
    match t {
        Con(n, _) if cktypes.is_unique_builtin(n) => return (Some(n + " belongs to the worker that opened it (send a Net and open it there)"), seen),
        Con(n, _) if cktypes.is_shared_handle(n) => return (None, seen),
        _ => {}
    }
    if self.kind_of(t) == Linear { return (Some("the linear type " + t.show() + " could be dropped by a channel or a worker that is never joined"), seen) }
    var parts: List[cktypes.Ty] = []
    match t {
        Tup(ts) => parts = ts,
        Con(_, args) => {
            match self.struct_fields(t) {
                Some(fs) => parts = fs.map(fn(f) => f.1),
                None => match self.enum_variants(t) {
                    Some(vs) => {
                        for v in vs { parts.extend(v.1) }
                    }
                    None => {}
                },
            }
            parts.extend(args)
        }
        _ => {}
    }
    for x in parts {
        let r = self.unsendable_walk(x, seen)
        if r.0.is_some() { return r }
        seen = r.1
    }
    (None, seen)
}

// The first part of t that derived equality cannot handle exactly: functions
// and capabilities (and, for map keys, Float, since NaN != NaN). Looks through
// struct fields and enum payloads (bootstrap/src/check_expr.rs `incomparable_part`).
pub fn Env.incomparable_part(self, t: cktypes.Ty, key: Bool) -> Option[Str] {
    self.incomparable_walk(t, key, []).0
}

fn Env.incomparable_walk(self, t: cktypes.Ty, key: Bool, seen0: List[cktypes.Ty]) -> (Option[Str], List[cktypes.Ty]) {
    if seen0.contains(t) { return (None, seen0) }
    var seen = seen0
    seen.push(t)
    match t {
        Fun(_, _) => return (Some("the function type " + t.show()), seen),
        Con(n, _) if cktypes.is_capability(n) => return (Some("the capability " + n), seen),
        Con(n, _) if key and n == "Float" => return (Some("Float (NaN is not equal to itself)"), seen),
        Con(n, _) if is_dyn(n) => return (Some("the trait object type " + n), seen),
        Tup(ts) => return self.incomparable_list(ts, key, seen),
        Con(_, args) => {
            match self.struct_fields(t) {
                Some(fs) => {
                    let r = self.incomparable_list(fs.map(fn(f) => f.1), key, seen)
                    if r.0.is_some() { return r }
                    seen = r.1
                }
                None => match self.enum_variants(t) {
                    Some(vs) => {
                        var all: List[cktypes.Ty] = []
                        for v in vs { all.extend(v.1) }
                        let r = self.incomparable_list(all, key, seen)
                        if r.0.is_some() { return r }
                        seen = r.1
                    }
                    None => {}
                },
            }
            return self.incomparable_list(args, key, seen)
        }
        _ => {}
    }
    (None, seen)
}

fn Env.incomparable_list(self, ts: List[cktypes.Ty], key: Bool, seen0: List[cktypes.Ty]) -> (Option[Str], List[cktypes.Ty]) {
    var seen = seen0
    for x in ts {
        let r = self.incomparable_walk(x, key, seen)
        if r.0.is_some() { return r }
        seen = r.1
    }
    (None, seen)
}

// A free function visible by its plain name: the current module's, else the prelude's.
pub fn Env.lookup_fn(self, n: Str) -> Option[Int] {
    match self.find_fn(self.internal(self.cur, n)) {
        Some(i) => Some(i),
        None => match self.find_fn(n) {
            Some(i) if self.fns[i].sp.file == 0 => Some(i),
            _ => None,
        },
    }
}

pub fn is_dyn(n: Str) -> Bool { n.starts_with("dyn ") }

// The trait of a `dyn` type, if it is one.
pub fn Env.dyn_trait(self, t: cktypes.Ty) -> Option[Int] {
    match t {
        Con(n, a) if a.is_empty() and is_dyn(n) => self.trait_ix.get(n.slice(4, n.len())),
        _ => None,
    }
}

// ---- traits ----

// The derived traits: satisfied structurally; only Show may be implemented (to override formatting).
pub fn builtin_trait_name(n: Str) -> Bool { n == "Eq" or n == "Ord" or n == "Hash" or n == "Show" or n == "Send" }
pub fn Env.is_builtin_trait(self, ti: Int) -> Bool { self.traits[ti].file == 0 and builtin_trait_name(self.traits[ti].name) }
pub fn Env.is_show(self, ti: Int) -> Bool { self.traits[ti].file == 0 and self.traits[ti].name == "Show" }

// Internal name of trait `n` declared in `file` (traits are a namespace of their own).
fn Env.trait_internal(self, file: Int, n: Str) -> Str {
    if file < self.modules.len() and self.modules[file] != "" { return self.modules[file] + "." + n }
    if file == 1 and self.trait_ix.get(n).map_or(false, fn(i) => self.traits[i].file == 0) { return "<main>." + n }
    n
}

// Resolve a trait name as written in the current module.
pub fn Env.resolve_trait(self, n: Str, sp: ckast.Span) -> Result[Int, ckast.Diag] {
    match n.find(".") {
        Some(i) => {
            let m = n.slice(0, i)
            if not self.imported(m) { return ckast.fail(sp, "unknown module '{m}'; add 'import {m}'") }
            return match self.trait_ix.get(n) {
                Some(ti) if self.traits[ti].public => Ok(ti),
                Some(_) => ckast.fail(sp, "trait '{n}' is private to module '{m}'"),
                None => ckast.fail(sp, "module '{m}' has no trait '{n.slice(i + 1, n.len())}'"),
            }
        }
        None => {}
    }
    let own = if self.cur == 1 { "<main>." + n } else { self.trait_internal(self.cur, n) }
    match self.trait_ix.get(own) {
        Some(ti) if self.traits[ti].file == self.cur => return Ok(ti),
        _ => {}
    }
    match self.trait_ix.get(n) {
        Some(ti) if self.traits[ti].file == self.cur or self.traits[ti].file == 0 => Ok(ti),
        _ => {
            let hint = if self.type_decl(self.internal(self.cur, n)).is_some() or cktypes.is_builtin(n) { " ('" + n + "' is a type, not a trait)" } else { "" }
            ckast.fail(sp, "unknown trait '{n}'" + hint)
        }
    }
}

pub fn Env.object_safe(self, ti: Int, sp: ckast.Span) -> Result[Unit, ckast.Diag] {
    let why = self.traits[ti].unsafe_why
    if why == "" { return Ok(()) }
    ckast.fail(sp, "trait {self.traits[ti].name} cannot be used with 'dyn': " + why +
        " (a dyn trait's methods take 'self' by value, are not generic and do not mention Self)")
}

// Bounds of the type parameters in scope, by name.
pub fn Env.bound_map(self, fi: Int) -> Map[Str, List[Int]] {
    var out: Map[Str, List[Int]] = [:]
    if fi < 0 { return out }
    let f = self.fns[fi]
    for i in 0..f.tparams.len().min(f.bounds.len()) { out[f.tparams[i]] = f.bounds[i] }
    out
}

// Match an impl's target (with type parameters ps) against t: the parameters' types.
pub fn match_ty(pat: cktypes.Ty, ps: List[Str], t: cktypes.Ty) -> Option[List[cktypes.Ty]] {
    var b: Map[Str, cktypes.Ty] = [:]
    if not match_into(pat, ps, t, mut b) { return None }
    var out: List[cktypes.Ty] = []
    for p in ps { out.push(b.get(p).unwrap_or(cktypes.t_unit())) }
    Some(out)
}

fn match_into(pat: cktypes.Ty, ps: List[Str], t: cktypes.Ty, b: mut Map[Str, cktypes.Ty]) -> Bool {
    match pat {
        Par(p) if ps.contains(p) => match b.get(p) {
            Some(x) => x == t,
            None => {
                b[p] = t
                true
            }
        },
        Con(n, a) => match t {
            Con(m, c) => n == m and a.len() == c.len() and match_all(a, ps, c, mut b),
            _ => false,
        },
        Tup(a) => match t {
            Tup(c) => a.len() == c.len() and match_all(a, ps, c, mut b),
            _ => false,
        },
        Fun(a, r) => match t {
            Fun(c, s) => a.len() == c.len() and match_all(a, ps, c, mut b) and match_into(r, ps, s, mut b),
            _ => false,
        },
        _ => pat == t,
    }
}

fn match_all(a: List[cktypes.Ty], ps: List[Str], c: List[cktypes.Ty], b: mut Map[Str, cktypes.Ty]) -> Bool {
    for i in 0..a.len() {
        if not match_into(a[i], ps, c[i], mut b) { return false }
    }
    true
}

// The impl of trait tr for type t, and its type arguments.
pub fn Env.find_impl(self, tr: Int, t: cktypes.Ty) -> Option[(Int, List[cktypes.Ty])] {
    for ii in 0..self.impls.len() {
        let im = self.impls[ii]
        if im.tr == tr {
            match match_ty(im.target, im.tparams, t) {
                Some(ts) => return Some((ii, ts)),
                None => {}
            }
        }
    }
    None
}

// Does t implement trait tr? `pb`: the bounds of the type parameters in scope.
pub fn Env.implements(self, t: cktypes.Ty, tr: Int, pb: Map[Str, List[Int]]) -> Bool {
    match t {
        Par(p) => return pb.get(p).map_or(false, fn(bs) => bs.contains(tr)),
        _ => {}
    }
    if self.is_builtin_trait(tr) {
        let n = self.traits[tr].name
        // every type parameter inside needs the bound itself
        if t.any(fn(x) => match x {
            Par(p) => not pb.get(p).map_or(false, fn(bs) => bs.contains(tr)),
            _ => false,
        }) {
            return false
        }
        if n == "Send" { return self.unsendable_part(t).is_none() }
        if n == "Show" {
            return not t.any(fn(x) => match x {
                Fun(_, _) => true,
                Con(c, _) => cktypes.is_capability(c),
                _ => false,
            })
        }
        if self.incomparable_part(t, n == "Hash").is_some() { return false }
        if n == "Ord" and t.any(fn(x) => x.is("Map")) { return false }
        return true
    }
    match self.dyn_trait(t) {
        Some(d) => return d == tr,
        None => {}
    }
    match self.find_impl(tr, t) {
        Some((ii, ts)) => {
            let im = self.impls[ii]
            for i in 0..ts.len().min(im.bounds.len()) {
                for b in im.bounds[i] {
                    if not self.implements(ts[i], b, pb) { return false }
                }
            }
            true
        }
        None => false,
    }
}

// The function (and its type arguments) that method mi of trait tr is for
// the concrete type t (not a `dyn`): the impl's method, or the default.
pub fn Env.method_for(self, tr: Int, mi: Int, t: cktypes.Ty, mtargs: List[cktypes.Ty]) -> Option[(Int, List[cktypes.Ty])] {
    match self.find_impl(tr, t) {
        Some((ii, ts)) => {
            let fi = self.impls[ii].fns[mi]
            match self.fns[fi].origin {
                ODefault(_, _) => Some((fi, [t] + mtargs)),
                _ => Some((fi, ts + mtargs)),
            }
        }
        None => None,
    }
}

pub fn Env.visible(self, fi: Int, sp: ckast.Span) -> Result[Unit, ckast.Diag] {
    let f = self.fns[fi]
    if f.sp.file != self.cur and f.sp.file != 0 and not f.public {
        return ckast.fail(sp, "'{f.name}' is private to its module")
    }
    Ok(())
}

// ---- declarations ----

pub fn declare(prog: ckast.Program) -> Result[Env, ckast.Diag] {
    var imports: List[List[Str]] = []
    for _ in 0..prog.modules.len() { imports.push([]) }
    for im in prog.imports { imports[im.file].push(im.name) }
    var prelude_items: Map[Str, Bool] = [:]
    for f in prog.fns { if f.sp.file == 0 and f.owner.is_none() { prelude_items[f.name] = true } }
    for s in prog.structs { if s.sp.file == 0 { prelude_items[s.name] = true } }
    for e in prog.enums { if e.sp.file == 0 { prelude_items[e.name] = true } }
    var env = Env {
        structs: [], enums: [], fns: [], struct_ix: [:], enum_ix: [:], fn_ix: [:], variant_ix: [:],
        modules: prog.modules, imports, cur: 1, prelude_items, traits: [], trait_ix: [:], impls: [], self_ty: None,
    }
    env.register_traits(prog)?
    env.declare_types(prog)?
    env.check_recursion()?
    env.check_kinds(prog)?
    env.declare_traits(prog)?
    env.declare_fns(prog)?
    env.declare_impls(prog)?
    Ok(env)
}

fn Env.declare_types(mut self, prog: ckast.Program) -> Result[Unit, ckast.Diag] {
    var names: List[(Str, ckast.Span, List[Str])] = []
    for s in prog.structs { names.push((s.name, s.sp, s.tparams)) }
    for e in prog.enums { names.push((e.name, e.sp, e.tparams)) }
    var seen: Map[Str, Bool] = [:]
    for x in names {
        let (n0, sp, _) = x
        let full = self.internal(sp.file, n0)
        if not ckast.upper(n0) { return ckast.fail(sp, "type names start with an uppercase letter: '{n0}'") }
        if is_tparam_name(n0) {
            return ckast.fail(sp, "'{n0}' is reserved for type parameters (one capital letter, optional digits); use a longer type name")
        }
        if seen.contains(full) or cktypes.is_builtin(full) { return ckast.fail(sp, "type '{full}' is already defined") }
        seen[full] = true
    }
    for x in names {
        let (n, sp, ps) = x
        for p in ps {
            if not is_tparam_name(p) {
                return ckast.fail(sp, "type parameter '{p}' of '{n}' must be one capital letter, optionally followed by digits")
            }
        }
    }
    for s in prog.structs {
        let name = self.internal(s.sp.file, s.name)
        if not self.struct_ix.contains(name) { self.struct_ix[name] = self.structs.len() }
        self.structs.push(StructInfo {
            name, tparams: s.tparams, fields: [], kind: s.kind, file: s.sp.file, public: s.public, pub_fields: s.pub_fields,
        })
    }
    for e in prog.enums {
        let name = self.internal(e.sp.file, e.name)
        if not self.enum_ix.contains(name) { self.enum_ix[name] = self.enums.len() }
        self.enums.push(EnumInfo { name, tparams: e.tparams, variants: [], kind: e.kind, file: e.sp.file, public: e.public })
    }
    for i in 0..prog.structs.len() {
        let s = prog.structs[i]
        self.cur = s.sp.file
        var fields: List[(Str, cktypes.Ty)] = []
        for f in s.fields {
            if fields.any(fn(g) => g.0 == f.0) { return ckast.fail(f.1.sp, "duplicate field '{f.0}'") }
            fields.push((f.0, self.lower_type(f.1, s.tparams)?))
        }
        self.structs[i].fields = fields
    }
    for i in 0..prog.enums.len() {
        let e = prog.enums[i]
        self.cur = e.sp.file
        var vs: List[(Str, List[cktypes.Ty])] = []
        for v in e.variants {
            if not ckast.upper(v.name) { return ckast.fail(v.sp, "variant names start with an uppercase letter: '{v.name}'") }
            if vs.any(fn(w) => w.0 == v.name) { return ckast.fail(v.sp, "duplicate variant '{v.name}'") }
            vs.push((v.name, self.lower_list(v.fields, e.tparams)?))
        }
        self.enums[i].variants = vs
    }
    for ei in 0..self.enums.len() {
        let vs = self.enums[ei].variants
        for vi in 0..vs.len() {
            var l = self.variant_ix.get(vs[vi].0).unwrap_or([])
            l.push((ei, vi))
            self.variant_ix[vs[vi].0] = l
        }
    }
    Ok(())
}

// A struct may not contain itself by value (it would be infinitely large).
fn Env.contains(self, t: cktypes.Ty, target: Str, seen: List[Str]) -> (Bool, List[Str]) {
    match t {
        Con(n, a) => {
            if n == target { return (true, seen) }
            if n == "List" or n == "Map" or seen.contains(n) { return (false, seen) }
            var s2 = seen
            s2.push(n)
            for x in a {
                let r = self.contains(x, target, s2)
                if r.0 { return r }
                s2 = r.1
            }
            match self.struct_idx(n) {
                Some(i) => {
                    for f in self.structs[i].fields {
                        let r = self.contains(f.1, target, s2)
                        if r.0 { return r }
                        s2 = r.1
                    }
                    (false, s2)
                }
                None => (false, s2),
            }
        }
        Tup(a) => {
            var s2 = seen
            for x in a {
                let r = self.contains(x, target, s2)
                if r.0 { return r }
                s2 = r.1
            }
            (false, s2)
        }
        _ => (false, seen),
    }
}

fn Env.check_recursion(self) -> Result[Unit, ckast.Diag] {
    for s in self.structs {
        for f in s.fields {
            if self.contains(f.1, s.name, []).0 {
                return ckast.fail(span0(), "struct '{s.name}' contains itself through field '{f.0}'; use an enum or List to break the cycle")
            }
        }
    }
    Ok(())
}

fn word(k: ckast.Kind) -> Str { if k == Linear { "linear" } else { "unique" } }
pub fn kind_word(k: ckast.Kind) -> Str { word(k) }

fn mixes(k: ckast.Kind, outer: ckast.Kind) -> Bool { (k != Plain and outer == Plain) or (k == Linear and outer == Unique) }

fn Env.check_kinds(self, prog: ckast.Program) -> Result[Unit, ckast.Diag] {
    for si in 0..self.structs.len() {
        let s = self.structs[si]
        for f in s.fields {
            let k = self.kind_of(f.1)
            if mixes(k, s.kind) {
                return ckast.fail(prog.structs[si].sp, "field '{f.0}' of '{s.name}' is {word(k)}; declare '{word(k)} struct {s.name}'")
            }
        }
    }
    for ei in 0..self.enums.len() {
        let e = self.enums[ei]
        for v in e.variants {
            for t in v.1 {
                let k = self.kind_of(t)
                // Option/Result are generic wrappers: they take the kind of their contents.
                if mixes(k, e.kind) and not e.tparams.any(fn(p) => t.any(fn(x) => x == Par(p))) {
                    return ckast.fail(prog.enums[ei].sp, "variant '{v.0}' of '{e.name}' holds a {word(k)} value; declare '{word(k)} enum {e.name}'")
                }
            }
        }
    }
    Ok(())
}

fn Env.declare_fns(mut self, prog: ckast.Program) -> Result[Unit, ckast.Diag] {
    var fseen: Map[Str, Bool] = [:]
    for f in prog.fns {
        self.cur = f.sp.file
        self.self_ty = None
        let derived = f.origin != OFn // impl methods and defaults: the type parameters are given
        let (tparams0, owner) = self.fn_owner(f, derived)?
        let full = match f.origin {
            ODefault(ti, _) => prog.traits[ti].name + "." + f.name,
            _ => match owner {
                Some(Con(on, _)) => on + "." + f.name,
                _ => self.internal(f.sp.file, f.name),
            },
        }
        if not derived {
            if fseen.contains(full) { return ckast.fail(f.sp, "function '{full}' is already defined") }
            fseen[full] = true
        }
        if f.is_const {
            if not (f.name.len() >= 2 and ckast.all_caps(f.name)) {
                return ckast.fail(f.sp, "constant names are written in capitals, like MAX_SIZE: '{f.name}'")
            }
        } else if ckast.upper(f.name) {
            return ckast.fail(f.sp, "function names start with a lowercase letter: '{f.name}'")
        }
        if f.body.is_none() and f.sp.file != 0 { return ckast.fail(f.sp, "'extern' is reserved for the prelude") }
        let (tparams, bounds) = self.fn_tparams(f, derived, tparams0)?
        var params: List[(Str, cktypes.Ty)] = []
        if f.self_kind != NoSelf {
            match owner {
                Some(o) => params.push(("self", o)),
                None => {}
            }
        }
        for p in f.params {
            if params.any(fn(q) => q.0 == p.name) { return ckast.fail(p.sp, "duplicate parameter '{p.name}'") }
            if ckast.upper(p.name) { return ckast.fail(p.sp, "parameter names start with a lowercase letter") }
            params.push((p.name, self.lower_type(p.ty, tparams)?))
        }
        let ret = match f.ret {
            Some(t) => self.lower_type(t, tparams)?,
            None => cktypes.t_unit(),
        }
        if not derived and not self.fn_ix.contains(full) { self.fn_ix[full] = self.fns.len() }
        self.fns.push(FnInfo {
            name: full, tparams, owner, params, muts: f.params.map(fn(p) => p.by_mut), ret, self_kind: f.self_kind,
            is_extern: f.body.is_none(), is_const: f.is_const, public: f.public, sp: f.sp, bounds, origin: f.origin,
        })
    }
    self.self_ty = None
    Ok(())
}

// The type parameters a method gets from its owner type (`fn Pair[A, B].swap`),
// and the owner type itself (None for a plain function).
fn Env.fn_owner(mut self, f: ckast.FnDecl, derived: Bool) -> Result[(List[Str], Option[cktypes.Ty]), ckast.Diag] {
    var tparams: List[Str] = []
    var owner: Option[cktypes.Ty] = None
    if derived {
        tparams = f.tparams
        let o = f.owner.unwrap()
        let ot = self.lower_type(o, tparams)?
        owner = Some(ot)
        match f.origin {
            OImpl(_) => self.self_ty = Some(ot),
            _ => {}
        }
    }
    match f.owner {
        Some(_) if derived => {}
        Some(o) => {
            match o.k {
                TNamed(_, args) => {
                    for a in args {
                        match a.k {
                            TNamed(an, aa) => if aa.is_empty() and is_tparam_name(an) { tparams.push(an) },
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
            let ot = self.lower_type(o, tparams)?
            match ot {
                Con(on, _) => match self.type_decl(on) {
                    Some((file, _)) if file != f.sp.file => {
                        return ckast.fail(o.sp, "methods of '{on}' can only be defined in the module that defines it")
                    }
                    _ => {}
                },
                _ => {}
            }
            owner = Some(ot)
        }
        None => {}
    }
    Ok((tparams, owner))
}

// The function's own type parameters after `tparams0` (checked), and the traits
// each one is bounded by.
fn Env.fn_tparams(mut self, f: ckast.FnDecl, derived: Bool, tparams0: List[Str]) -> Result[(List[Str], List[List[Int]]), ckast.Diag] {
    var tparams = tparams0
    for ti in 0..f.tparams.len() {
        let t = f.tparams[ti]
        if derived and t == "Self" and ti == 0 { continue }
        if not is_tparam_name(t) {
            return ckast.fail(f.sp, "type parameter '{t}' must be one capital letter, optionally followed by digits")
        }
        if derived {
            if f.tparams.slice(0, ti).contains(t) { return ckast.fail(f.sp, "type parameter '{t}' shadows another type") }
            continue
        }
        if tparams.contains(t) { return ckast.fail(f.sp, "type parameter '{t}' shadows another type") }
        tparams.push(t)
    }
    var bounds: List[List[Int]] = tparams.map(fn(_) => [])
    for b in f.bounds {
        var pi = -1
        for i in 0..tparams.len() {
            if tparams[i] == b.param { pi = i }
        }
        if pi < 0 { return ckast.fail(b.sp, "'{b.param}' is not a type parameter of '{f.name}'") }
        for tn in b.traits {
            let tr = self.resolve_trait(tn.0, tn.1)?
            if not bounds[pi].contains(tr) { bounds[pi].push(tr) }
        }
    }
    Ok((tparams, bounds))
}

fn mentions_self(t: ckast.TExpr) -> Bool {
    match t.k {
        TNamed(n, a) => n == "Self" or a.any(mentions_self),
        TFn(a, r) => a.any(mentions_self) or mentions_self(r),
        TTuple(a) => a.any(mentions_self),
    }
}

// Why `dyn` cannot be used with a trait ("" if it can), from its methods' signatures.
fn unsafe_why(t: ckast.TraitDecl) -> Str {
    for m in t.methods {
        if not m.tparams.is_empty() { return "method '{m.name}' is generic" }
        if m.self_kind == MutSelf { return "method '{m.name}' takes 'mut self'" }
        if m.params.any(fn(p) => mentions_self(p.ty)) or m.ret.map_or(false, mentions_self) {
            return "method '{m.name}' mentions Self"
        }
    }
    ""
}

// The trait names (types mention `dyn Trait`), before the types are declared.
fn Env.register_traits(mut self, prog: ckast.Program) -> Result[Unit, ckast.Diag] {
    for t in prog.traits {
        if not ckast.upper(t.name) { return ckast.fail(t.sp, "trait names start with an uppercase letter: '{t.name}'") }
        if is_tparam_name(t.name) { return ckast.fail(t.sp, "'{t.name}' is reserved for type parameters; use a longer trait name") }
        let full = self.trait_internal(t.sp.file, t.name)
        if self.trait_ix.contains(full) { return ckast.fail(t.sp, "trait '{full}' is already defined") }
        self.trait_ix[full] = self.traits.len()
        self.traits.push(TraitInfo { name: full, file: t.sp.file, public: t.public, methods: [], unsafe_why: unsafe_why(t), sp: t.sp })
    }
    Ok(())
}

fn Env.declare_traits(mut self, prog: ckast.Program) -> Result[Unit, ckast.Diag] {
    for t in prog.traits {
        if self.type_decl(self.internal(t.sp.file, t.name)).is_some() or cktypes.is_builtin(t.name) {
            return ckast.fail(t.sp, "'{t.name}' is already defined as a type")
        }
    }
    for ti in 0..prog.traits.len() {
        let t = prog.traits[ti]
        self.cur = t.sp.file
        var ms: List[TMethod] = []
        for mi in 0..t.methods.len() {
            let m = t.methods[mi]
            if ms.any(fn(x) => x.name == m.name) { return ckast.fail(m.sp, "trait {t.name} has two methods named '{m.name}'") }
            if ckast.upper(m.name) { return ckast.fail(m.sp, "function names start with a lowercase letter: '{m.name}'") }
            if m.self_kind == NoSelf { return ckast.fail(m.sp, "trait method '{m.name}' must take 'self' or 'mut self' first") }
            if not m.bounds.is_empty() { return ckast.fail(m.sp, "the type parameters of a trait method cannot have bounds") }
            let tps = ["Self"] + m.tparams
            for p in m.tparams {
                if not is_tparam_name(p) {
                    return ckast.fail(m.sp, "type parameter '{p}' must be one capital letter, optionally followed by digits")
                }
            }
            var params: List[(Str, cktypes.Ty)] = []
            for p in m.params {
                if params.any(fn(q) => q.0 == p.name) or p.name == "self" { return ckast.fail(p.sp, "duplicate parameter '{p.name}'") }
                params.push((p.name, self.lower_type(p.ty, tps)?))
            }
            let ret = match m.ret {
                Some(r) => self.lower_type(r, tps)?,
                None => cktypes.t_unit(),
            }
            ms.push(TMethod {
                name: m.name, tparams: m.tparams, self_kind: m.self_kind, params, muts: m.params.map(fn(p) => p.by_mut), ret,
                default: t.defaults[mi], sp: m.sp,
            })
        }
        self.traits[ti].methods = ms
    }
    Ok(())
}

// `fn(self, Int) -> Str`, for messages.
fn sig_text(self_kind: ckast.SelfK, ps: List[cktypes.Ty], muts: List[Bool], ret: cktypes.Ty) -> Str {
    var parts: List[Str] = []
    if self_kind == ValSelf { parts.push("self") }
    if self_kind == MutSelf { parts.push("mut self") }
    for i in 0..ps.len() { parts.push((if i < muts.len() and muts[i] { "mut " } else { "" }) + ps[i].show()) }
    "fn(" + parts.join(", ") + ") -> " + ret.show()
}

fn Env.declare_impls(mut self, prog: ckast.Program) -> Result[Unit, ckast.Diag] {
    for ii in 0..prog.impls.len() {
        let im = prog.impls[ii]
        self.cur = im.sp.file
        let tr = self.resolve_trait(im.trait_name, im.trait_sp)?
        let tinfo = self.traits[tr]
        let tname = tinfo.name
        if self.is_builtin_trait(tr) and tname != "Show" {
            return ckast.fail(im.trait_sp, "{tname} is derived structurally for every type that supports it and cannot be implemented; only Show can be (to change how a type is formatted)")
        }
        for p in im.tparams {
            if not is_tparam_name(p) {
                return ckast.fail(im.sp, "type parameter '{p}' must be one capital letter, optionally followed by digits")
            }
        }
        let target = self.lower_type(im.target, im.tparams)?
        let tshow = target.show()
        match target {
            Par(p) => return ckast.fail(im.target.sp, "an impl must name a type, not the type parameter '{p}'"),
            _ => {}
        }
        if self.dyn_trait(target).is_some() { return ckast.fail(im.target.sp, "a 'dyn' type implements its trait already; it cannot have impls") }
        for p in im.tparams {
            if not target.any(fn(x) => x == Par(p)) { return ckast.fail(im.sp, "type parameter '{p}' of the impl does not appear in " + tshow) }
        }
        // orphan rule: in the trait's module or the type's
        let type_file = match target {
            Con(n, _) => match self.type_decl(n) {
                Some((file, _)) => file,
                None => -1,
            },
            _ => -1,
        }
        if tinfo.file != im.sp.file and type_file != im.sp.file {
            let where = if type_file < 0 { tshow + " has no module of its own" } else { "it is neither in the module of " + tname + " nor in that of " + tshow }
            return ckast.fail(im.sp, "impl {tname} for {tshow} is not allowed here: {where} (an impl must be in the module of its trait or of its type)")
        }
        var bounds: List[List[Int]] = im.tparams.map(fn(_) => [])
        for b in im.bounds {
            var pi = -1
            for i in 0..im.tparams.len() {
                if im.tparams[i] == b.param { pi = i }
            }
            if pi < 0 { return ckast.fail(b.sp, "'{b.param}' is not a type parameter of the impl") }
            for tn in b.traits {
                let btr = self.resolve_trait(tn.0, tn.1)?
                if self.is_show(tr) and not self.is_builtin_trait(btr) {
                    return ckast.fail(tn.1, "an impl of Show can only bound its type parameters by Eq, Ord, Hash or Show")
                }
                if not bounds[pi].contains(btr) { bounds[pi].push(btr) }
            }
        }
        let fns = self.impl_fns(prog, im, tr, target)?
        // coherence: at most one impl per trait and type
        for jj in 0..self.impls.len() {
            let other = self.impls[jj]
            if other.tr == tr and overlap(other.target, other.tparams, target, im.tparams) {
                let what = if other.target == target { "duplicate impl {tname} for {tshow}" } else { "impl {tname} for {tshow} overlaps impl {tname} for {other.target.show()}" }
                return ckast.fail(im.sp, what + " (line {other.sp.line}); a type can implement a trait only once")
            }
        }
        self.impls.push(ImplInfo { tr, tparams: im.tparams, bounds, target, file: im.sp.file, fns, sp: im.sp })
    }
    Ok(())
}

// The function of each method of trait `tr` in impl `im` for `target` (the
// trait's default where the impl gives none), each with the trait's signature.
fn Env.impl_fns(self, prog: ckast.Program, im: ckast.ImplDecl, tr: Int, target: cktypes.Ty) -> Result[List[Int], ckast.Diag] {
    let tinfo = self.traits[tr]
    let tname = tinfo.name
    let tshow = target.show()
    var fns: List[Int] = tinfo.methods.map(fn(m) => m.default)
    var given: List[Bool] = tinfo.methods.map(fn(_) => false)
    for fi in im.methods {
        let f = self.fns[fi]
        let mname = prog.fns[fi].name
        var mi = -1
        for k in 0..tinfo.methods.len() {
            if tinfo.methods[k].name == mname { mi = k }
        }
        if mi < 0 { return ckast.fail(f.sp, "method '{mname}' is not in trait {tname}") }
        if given[mi] { return ckast.fail(f.sp, "method '{mname}' is defined twice in impl {tname} for {tshow}") }
        given[mi] = true
        fns[mi] = fi
        let tm = tinfo.methods[mi]
        let own = f.tparams.slice(im.tparams.len(), f.tparams.len())
        let want_ps = tm.params.map(fn(p) => p.1.subst(["Self"] + tm.tparams, [target] + own.map(fn(x) => Par(x))))
        let want_ret = tm.ret.subst(["Self"] + tm.tparams, [target] + own.map(fn(x) => Par(x)))
        let have_ps = f.params.slice(if f.self_kind == NoSelf { 0 } else { 1 }, f.params.len()).map(fn(p) => p.1)
        let ok = f.self_kind == tm.self_kind and own.len() == tm.tparams.len() and have_ps == want_ps and f.muts == tm.muts and f.ret == want_ret
        if not ok {
            let want = sig_text(tm.self_kind, want_ps, tm.muts, want_ret)
            let have = sig_text(f.self_kind, have_ps, f.muts, f.ret)
            let gen = if own.len() != tm.tparams.len() { " (type parameters: expected {tm.tparams.len()}, found {own.len()})" } else { "" }
            return ckast.fail(f.sp, "method '{mname}' of impl {tname} for {tshow} has the wrong signature: expected " + want + ", found " + have + gen)
        }
        if not prog.fns[fi].bounds.slice(im.bounds.len(), prog.fns[fi].bounds.len()).is_empty() {
            return ckast.fail(f.sp, "the type parameters of a trait method cannot have bounds")
        }
    }
    for k in 0..tinfo.methods.len() {
        if fns[k] < 0 { return ckast.fail(im.sp, "impl {tname} for {tshow} is missing method '{tinfo.methods[k].name}'") }
    }
    Ok(fns)
}

// Can one type be an instance of both impl targets (their parameters renamed apart)?
fn overlap(a: cktypes.Ty, aps: List[Str], b: cktypes.Ty, bps: List[Str]) -> Bool {
    var s = cktypes.new_subst()
    var av: List[cktypes.Ty] = []
    for _ in aps { av.push(s.fresh()) }
    var bv: List[cktypes.Ty] = []
    for _ in bps { bv.push(s.fresh()) }
    s.unify(a.subst(aps, av), b.subst(bps, bv))
}

pub fn Env.check_main(self, i: Int) -> Result[Unit, ckast.Diag] {
    let f = self.fns[i]
    if not f.tparams.is_empty() { return ckast.fail(f.sp, "'main' cannot be generic") }
    let params_ok = f.params.is_empty() or (f.params.len() == 1 and f.params[0].1.is("Sys"))
    if not params_ok { return ckast.fail(f.sp, "'main' takes no parameters or a single 'Sys'") }
    let ok = f.ret.is("Unit") or f.ret.is("Int") or (f.ret.is("Result") and f.ret.args()[0].is("Unit"))
    if not ok { return ckast.fail(f.sp, "'main' returns Unit, Int (the exit status) or Result[Unit, E]") }
    Ok(())
}
