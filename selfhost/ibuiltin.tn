// module
// Builtins: the prelude's `extern fn`s on numbers, strings, lists, maps,
// Option/Result and the console (bootstrap/src/builtins.rs `call_extern`,
// `extern_mut`). The host's own builtins do the work (they are the C
// runtime's, which agrees with the bootstrap); every precondition whose
// failure is a trap is checked first, so the trap is the interpreted
// program's, with its message and location.
import ckast
import ival
import ieval
import icap
import iwork

// Builtins taking their receiver by value; the number is the position.
pub fn ext_names() -> List[Str] {
    [
        "panic", "assert", "encode", "Int.checked_add", "Int.checked_sub", "Int.checked_mul", "Int.checked_div",
        "Int.to_float", "Int.char", "Float.to_int", "Float.sqrt", "Float.floor", "Float.ceil", "Float.round",
        "Float.to_fixed", "Str.len", "Str.byte", "Str.slice", "Str.find", "Str.find_from", "Str.split", "Str.trim",
        "Str.trim_start", "Str.trim_end", "Str.starts_with", "Str.ends_with", "Str.to_int", "Str.to_float",
        "Str.upper", "Str.lower", "Str.replace", "Str.chars", "Str.char_count", "Str.bytes", "Str.from_utf8",
        "Str.from_utf8_lossy", "Str.lines", "Str.words", "List.len", "List.slice", "List.join", "Map.len",
        "Map.get", "Map.keys", "Map.values", "Option.unwrap", "Option.expect", "Result.unwrap", "Result.expect",
        "Console.print", "Console.println", "Console.eprintln", "Console.read_line", "Console.read_all",
        "Console.read_all_bytes", "Console.write_bytes", "Console.flush", "Console.read_bytes",
    ] + icap.cap_names() + iwork.work_names()
}

pub const FIRST_CAP: Int = 58
// The first builtin with an effect (Console.print; then the capabilities,
// then the workers and channels): a worker logs their results (iwork.tn).
pub const FIRST_EFFECT: Int = 49
pub const FIRST_WORK: Int = 95

// `mut self` builtins.
pub const M_PUSH: Int = 0
pub const M_POP: Int = 1
pub const M_INSERT: Int = 2
pub const M_REMOVE: Int = 3
pub const M_CLEAR: Int = 4
pub const M_REVERSE: Int = 5
pub const M_SORT: Int = 6
pub const M_SORT_BY: Int = 7
pub const M_SORT_BY_DESC: Int = 8
pub const M_MAP_INSERT: Int = 9
pub const M_MAP_REMOVE: Int = 10

pub fn mut_names() -> List[Str] {
    [
        "List.push", "List.pop", "List.insert", "List.remove", "List.clear", "List.reverse", "List.sort",
        "List.sort_by", "List.sort_by_desc", "Map.insert", "Map.remove",
    ]
}

pub fn numbering(names: List[Str]) -> Map[Str, Int] {
    var m: Map[Str, Int] = [:]
    for i in 0..names.len() { m[names[i]] = i }
    m
}

fn strs(xs: List[Str]) -> ival.Val {
    var out: List[ival.Val] = []
    for x in xs { out.push(ival.vstr(x)) }
    ival.vlist(out)
}

fn trap_oob(i: Int, n: Int, sp: ckast.Span) -> Result[ival.Val, ieval.Ctl] {
    ieval.trap("index {i} out of bounds for length {n}", sp)
}

// The bytes of a List[Int] value; an element outside 0..255 traps.
pub fn list_bytes(l: ival.Val, sp: ckast.Span) -> Result[List[Int], ieval.Ctl] {
    var out: List[Int] = []
    for i in 0..l.xs.len() {
        let v = l.xs[i].i
        if v < 0 or v > 255 { return ieval.trap("byte {v} at index {i} is not in 0..255", sp) }
        out.push(v)
    }
    Ok(out)
}

fn int_list(l: ival.Val) -> List[Int] {
    var out: List[Int] = []
    for x in l.xs { out.push(x.i) }
    out
}

pub fn str_list(l: ival.Val) -> List[Str] {
    var out: List[Str] = []
    for x in l.xs { out.push(x.s) }
    out
}

fn boundary(s: Str, i: Int) -> Bool { i == 0 or i == s.len() or s.byte(i) < 128 or s.byte(i) >= 192 }

fn opt_int(ix: ieval.Ix, o: Option[Int]) -> ival.Val {
    match o {
        Some(x) => ieval.some(ix, ival.vint(x)),
        None => ieval.none(ix),
    }
}

// Call builtin `id` (function fi) with arguments a.
pub fn call(it: mut ieval.Interp, id: Int, fi: Int, a: List[ival.Val], sp: ckast.Span) -> Result[ival.Val, ieval.Ctl] {
    if it.wk.cur >= 0 and id >= FIRST_EFFECT { return iwork.logged(mut it, id, fi, a, sp) }
    call_raw(mut it, id, fi, a, sp)
}

pub fn call_raw(it: mut ieval.Interp, id: Int, fi: Int, a: List[ival.Val], sp: ckast.Span) -> Result[ival.Val, ieval.Ctl] {
    if id < 0 { panic("interp: missing builtin {it.fns[fi].name}") }
    if id >= FIRST_WORK { return iwork.call(mut it, id - FIRST_WORK, a, sp) }
    if id >= FIRST_CAP { return icap.call(mut it, id - FIRST_CAP, a, sp) }
    if id >= 15 and id < 38 { return str_op(mut it, id, a, sp) }
    let ix = it.ix
    match id {
        0 => ieval.trap(a[0].s, sp),
        1 => if a[0].i == 0 { ieval.trap("assertion failed", sp) } else { Ok(ival.unit()) },
        2 => {
            var s = ""
            ival.show(mut s, a[0], false, it.names, true)
            Ok(ival.vstr(s))
        }
        3 => Ok(opt_int(ix, a[0].i.checked_add(a[1].i))),
        4 => Ok(opt_int(ix, a[0].i.checked_sub(a[1].i))),
        5 => Ok(opt_int(ix, a[0].i.checked_mul(a[1].i))),
        6 => Ok(opt_int(ix, a[0].i.checked_div(a[1].i))),
        7 => Ok(ival.vfloat(a[0].i.to_float())),
        8 => {
            let c = a[0].i
            if c < 0 or c > 1114111 or (c >= 55296 and c <= 57343) { return ieval.trap("invalid character code {c}", sp) }
            Ok(ival.vstr(c.char()))
        }
        9 => {
            let x = a[0].f
            if not (x >= -9223372036854775808.0 and x < 9223372036854775808.0) {
                return ieval.trap("float to int conversion out of range", sp)
            }
            Ok(ival.vint(x.to_int()))
        }
        10 => Ok(ival.vfloat(a[0].f.sqrt())),
        11 => Ok(ival.vfloat(a[0].f.floor())),
        12 => Ok(ival.vfloat(a[0].f.ceil())),
        13 => Ok(ival.vfloat(a[0].f.round())),
        14 => Ok(ival.vstr(a[0].f.to_fixed(a[1].i))),
        38 => Ok(ival.vint(a[0].xs.len())),
        39 => {
            let n = a[0].xs.len()
            let x = a[1].i
            let y = a[2].i
            if x < 0 or y < x or y > n { return ieval.trap("slice [{x}, {y}) out of bounds for length {n}", sp) }
            Ok(ival.vlist(a[0].xs.slice(x, y)))
        }
        40 => Ok(ival.vstr(str_list(a[0]).join(a[1].s))),
        41 => Ok(ival.vint(a[0].m.len())),
        42 => Ok(ieval.opt(ix, a[0].m.get(ival.to_key(a[1])))),
        43 => {
            var out: List[ival.Val] = []
            for (k, _) in a[0].m { out.push(ival.from_key(k)) }
            Ok(ival.vlist(out))
        }
        44 => {
            var out: List[ival.Val] = []
            for (_, v) in a[0].m { out.push(v) }
            Ok(ival.vlist(out))
        }
        45 | 46 => {
            if a[0].j == 0 { return Ok(a[0].xs[0]) }
            if id == 46 { ieval.trap(a[1].s, sp) } else { ieval.trap("unwrap on None", sp) }
        }
        47 | 48 => {
            if a[0].j == 0 { return Ok(a[0].xs[0]) }
            if id == 48 {
                let p = ieval.prerender(mut it, a[0].xs[0])?
                return ieval.trap(a[1].s + ": " + ival.show_nested(p, it.names), sp)
            }
            let p = ieval.prerender(mut it, a[0])?
            ieval.trap("unwrap on " + ival.show_nested(p, it.names), sp)
        }
        49 => {
            it.con.print(a[1].s)
            Ok(ival.unit())
        }
        50 => {
            it.con.println(a[1].s)
            Ok(ival.unit())
        }
        51 => {
            it.con.eprintln(a[1].s)
            Ok(ival.unit())
        }
        52 => {
            match it.con.read_line() {
                Some(l) => Ok(ieval.some(ix, ival.vstr(l))),
                None => Ok(ieval.none(ix)),
            }
        }
        53 => Ok(ival.vstr(it.con.read_all())),
        54 => Ok(ival.bytes_val(it.con.read_all_bytes())),
        55 => {
            let b = list_bytes(a[1], sp)?
            it.con.write_bytes(b)
            Ok(ival.unit())
        }
        56 => {
            it.con.flush()
            Ok(ival.unit())
        }
        57 => Ok(ival.bytes_val(it.con.read_bytes(a[1].i))),
        _ => panic("interp: missing builtin {it.fns[fi].name}"),
    }
}

fn str_op(it: mut ieval.Interp, id: Int, a: List[ival.Val], sp: ckast.Span) -> Result[ival.Val, ieval.Ctl] {
    let s = a[0].s
    let ix = it.ix
    match id {
        15 => Ok(ival.vint(s.len())),
        16 => {
            let i = a[1].i
            if i < 0 or i >= s.len() { return trap_oob(i, s.len(), sp) }
            Ok(ival.vint(s.byte(i)))
        }
        17 => {
            let x = a[1].i
            let y = a[2].i
            if x < 0 or y < x or y > s.len() { return ieval.trap("slice [{x}, {y}) out of bounds for length {s.len()}", sp) }
            if not boundary(s, x) or not boundary(s, y) { return ieval.trap("slice [{x}, {y}) is not on a character boundary", sp) }
            Ok(ival.vstr(s.slice(x, y)))
        }
        18 => Ok(opt_int(ix, s.find(a[1].s))),
        19 => {
            let from = a[2].i
            if from < 0 or from > s.len() { return trap_oob(from, s.len(), sp) }
            Ok(opt_int(ix, s.find_from(a[1].s, from)))
        }
        20 => {
            if a[1].s.is_empty() { return ieval.trap("split with an empty separator", sp) }
            Ok(strs(s.split(a[1].s)))
        }
        21 => Ok(ival.vstr(s.trim())),
        22 => Ok(ival.vstr(s.trim_start())),
        23 => Ok(ival.vstr(s.trim_end())),
        24 => Ok(ival.vbool(s.starts_with(a[1].s))),
        25 => Ok(ival.vbool(s.ends_with(a[1].s))),
        26 => Ok(opt_int(ix, s.to_int())),
        27 => match s.to_float() {
            Some(f) => Ok(ieval.some(ix, ival.vfloat(f))),
            None => Ok(ieval.none(ix)),
        },
        28 => Ok(ival.vstr(s.upper())),
        29 => Ok(ival.vstr(s.lower())),
        30 => {
            if a[1].s.is_empty() { return ieval.trap("replace with an empty pattern", sp) }
            Ok(ival.vstr(s.replace(a[1].s, a[2].s)))
        }
        31 => Ok(strs(s.chars())),
        32 => Ok(ival.vint(s.char_count())),
        33 => Ok(ival.bytes_val(s.bytes())),
        34 => {
            for x in a[0].xs {
                if x.i < 0 or x.i > 255 { return Ok(ieval.none(ix)) }
            }
            match Str.from_utf8(int_list(a[0])) {
                Some(t) => Ok(ieval.some(ix, ival.vstr(t))),
                None => Ok(ieval.none(ix)),
            }
        }
        35 => Ok(ival.vstr(Str.from_utf8_lossy(list_bytes(a[0], sp)?))),
        36 => Ok(strs(s.lines())),
        _ => Ok(strs(s.words())),
    }
}

// Stable merge sort by the derived ordering of keys[i] (the elements
// themselves for `sort`); a map comparison makes it trap afterwards, as the
// bootstrap's sort does.
fn sorted_order(keys: List[ival.Val], desc: Bool, bad: mut Bool) -> List[Int] {
    let n = keys.len()
    var idx: List[Int] = []
    for i in 0..n { idx.push(i) }
    var width = 1
    while width < n {
        var out: List[Int] = []
        var lo = 0
        while lo < n {
            let mid = (lo + width).min(n)
            let hi = (lo + 2 * width).min(n)
            var i = lo
            var j = mid
            while i < mid or j < hi {
                var take_left = j >= hi
                if not take_left and i < mid {
                    let c = match ival.cmp(keys[idx[j]], keys[idx[i]]) {
                        Ok(c) => c,
                        Err(_) => {
                            bad = true
                            0
                        }
                    }
                    take_left = if desc { c <= 0 } else { c >= 0 }
                }
                if take_left {
                    out.push(idx[i])
                    i += 1
                } else {
                    out.push(idx[j])
                    j += 1
                }
            }
            lo = hi
        }
        idx = out
        width *= 2
    }
    idx
}

// A `mut self` builtin applied to the value at its place.
pub fn mut_op(v: mut ival.Val, id: Int, a: List[ival.Val], keys: List[ival.Val], sp: ckast.Span, ix: ieval.Ix) -> Result[ival.Val, ieval.Ctl] {
    if id == M_PUSH {
        v.xs.push(a[0])
        return Ok(ival.unit())
    }
    if id == M_MAP_INSERT {
        v.m[ival.to_key(a[0])] = a[1]
        return Ok(ival.unit())
    }
    if id == M_POP {
        return match v.xs.pop() {
            Some(x) => Ok(ieval.some(ix, x)),
            None => Ok(ieval.none(ix)),
        }
    }
    if id == M_INSERT {
        let i = a[0].i
        if i < 0 or i > v.xs.len() { return trap_oob(i, v.xs.len(), sp) }
        v.xs.insert(i, a[1])
        return Ok(ival.unit())
    }
    if id == M_REMOVE {
        let i = a[0].i
        if i < 0 or i >= v.xs.len() { return trap_oob(i, v.xs.len(), sp) }
        return Ok(v.xs.remove(i))
    }
    if id == M_CLEAR {
        v.xs.clear()
        return Ok(ival.unit())
    }
    if id == M_REVERSE {
        v.xs.reverse()
        return Ok(ival.unit())
    }
    if id == M_MAP_REMOVE {
        return match v.m.remove(ival.to_key(a[0])) {
            Some(x) => Ok(ieval.some(ix, x)),
            None => Ok(ieval.none(ix)),
        }
    }
    // sorts
    var bad = false
    let ks = if id == M_SORT { v.xs } else { keys }
    let order = sorted_order(ks, id == M_SORT_BY_DESC, mut bad)
    if bad { return ieval.trap("maps are not ordered", sp) }
    var out: List[ival.Val] = []
    for i in order { out.push(v.xs[i]) }
    v.xs = out
    Ok(ival.unit())
}
