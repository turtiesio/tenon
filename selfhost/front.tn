// module
// Loading and checking a program: a port of bootstrap/src/main.rs `front`.
// The prelude and the standard library are read from ROOT (the repository:
// ROOT/lib/prelude.tn, ROOT/lib/std/NAME.tn) instead of being embedded.
import parser
import ckast
import checker
import pkg

// Standard library modules (bootstrap/src/main.rs `STD`).
fn std_modules() -> List[Str] { ["journal", "regex"] }

// A loaded program: every source file (name, text) in load order, as
// bootstrap/src/diag.rs `SourceMap` (file 0 is the prelude, 1 the main file).
pub struct Front { pub files: List[(Str, Str)], pub checked: checker.Checked }

// Why loading or checking failed. `fatal`: an I/O problem (exit status 2),
// otherwise a diagnostic at file:line:col (exit status 1). `text` is the
// source of `file`, for rendering the line (empty if unknown).
pub struct Failure { pub fatal: Bool, pub file: Str, pub line: Int, pub col: Int, pub msg: Str, pub text: Str }

fn io_fail(msg: Str) -> Failure { Failure { fatal: true, file: "", line: 0, col: 0, msg, text: "" } }

fn diag(files: List[(Str, Str)], fi: Int, line: Int, col: Int, msg: Str) -> Failure {
    Failure { fatal: false, file: files[fi].0, line, col, msg, text: files[fi].1 }
}

// The one-line form `PATH:LINE:COL: error: MESSAGE`.
pub fn Failure.line_text(self) -> Str { "{self.file}:{self.line}:{self.col}: error: {self.msg}" }

// The bootstrap's rendering (bootstrap/src/diag.rs `render`): the message, the
// source line and a caret under the column.
pub fn Failure.render(self) -> Str {
    let lines = self.text.lines()
    let i = (self.line - 1).max(0) // line 0 (a declaration without a position) shows the first line
    let src = if i < lines.len() { lines[i] } else { "" }
    let caret = " ".repeat((self.col - 1).max(0))
    self.line_text() + "\n  " + src + "\n  " + caret + "^"
}

// Path::parent, as the bootstrap uses it to find a module next to its importer.
fn parent(p: Str) -> Str {
    var i = p.len() - 1
    while i >= 0 and p.byte(i) != 47 { i -= 1 }
    if i < 0 { "" } else if i == 0 { "/" } else { p.slice(0, i) }
}

pub fn join(dir: Str, name: Str) -> Str {
    if dir == "" { name } else if dir.ends_with("/") { dir + name } else { dir + "/" + name }
}

// Load the program (the prelude, the main file, then every imported module)
// and check it.
pub fn load(fs: Fs, root: Str, path: Str) -> Result[Front, Failure] { load_in(fs, root, path, None) }

// `load` inside a package: `import` also finds the dependencies in `pk`
// (pkg.context, docs/packages.md).
pub fn load_in(fs: Fs, root: Str, path: Str, pk: Option[pkg.Ctx]) -> Result[Front, Failure] {
    let (files, parsed, modules) = gather(fs, root, path, None, pk)?
    match checker.check(ckast.convert(parsed, modules)) {
        Ok(c) => Ok(Front { files, checked: c }),
        Err(d) => Err(diag(files, d.sp.file, d.sp.line, d.sp.col, d.msg)),
    }
}

// An editor buffer, analysed for the language server (selfhost/lsp.tn):
// as `load`, but the main file's text is `src` (imported modules are read
// from disk), and `checked` holds the side tables of every function that
// could be checked even when `failure` (the diagnostic `load` reports) is
// set; it is None only if the declarations themselves fail.
pub struct Analysis { pub files: List[(Str, Str)], pub failure: Option[Failure], pub checked: Option[checker.Checked] }

pub fn analyze_in(fs: Fs, root: Str, path: Str, src: Str, pk: Option[pkg.Ctx]) -> Analysis {
    let (files, parsed, modules) = match gather(fs, root, path, Some(src), pk) {
        Ok(x) => x,
        Err(f) => return Analysis { files: [(path, src)], failure: Some(f), checked: None },
    }
    let (d, checked) = checker.check_lenient(ckast.convert(parsed, modules))
    let failure = match d {
        Some(x) => Some(diag(files, x.sp.file, x.sp.line, x.sp.col, x.msg)),
        None => None,
    }
    Analysis { files, failure, checked }
}

// Read and parse the prelude, the main file (its text `src`, if given) and
// every imported module (from the importing file's directory, else the
// standard library; inside a package `pk`, else a dependency's entry module,
// and a module name must then name one file): the files, their trees and the
// module name of each.
fn gather(fs: Fs, root: Str, path: Str, given: Option[Str], pk: Option[pkg.Ctx]) -> Result[(List[(Str, Str)], List[parser.Program], List[Str]), Failure] {
    let prelude0 = match fs.read(join(root, "lib/prelude.tn")) {
        Ok(s) => s,
        Err(e) => return Err(io_fail("cannot read the prelude: {e}")),
    }
    // lib/v2/prelude.tn (the traits; syntax the bootstrap cannot parse) is part of the prelude
    let prelude = match fs.read(join(root, "lib/v2/prelude.tn")) {
        Ok(s) => prelude0 + "\n" + s,
        Err(_) => prelude0,
    }
    let src = match given {
        Some(t) => t,
        None => match fs.read(path) {
            Ok(s) => s,
            Err(e) => return Err(io_fail("cannot read {path}: {e}")),
        },
    }
    var files: List[(Str, Str)] = [("<prelude>", prelude), (path, src)]
    var modules = ["", ""]
    var parsed: List[parser.Program] = []
    var i = 0
    while i < files.len() {
        let prog = match parser.parse(files[i].1) {
            Ok(p) => p,
            Err(e) => return Err(diag(files, i, e.line, e.col, e.msg)),
        }
        parsed.push(prog)
        for im in prog.imports {
            let name = im.0
            let known = modules.index_of(name)
            if known.is_none() or pk.is_some() {
                let local = join(parent(files[i].0), name + ".tn")
                // A file never imports itself: `regex.tn` doing `import regex` gets the std module.
                let me = files[i].0
                let is_self = me == name + ".tn" or me.ends_with("/" + name + ".tn")
                var at = local
                var found = if is_self { None } else { fs.read(local).ok() }
                if found.is_none() {
                    match pkg.entry(pk, me, name) {
                        Some(e) => {
                            at = e
                            found = Some(fs.read(e).map_err(fn(x) => io_fail("cannot read {e}: {x}"))?)
                        }
                        None => {}
                    }
                }
                let file = match found {
                    Some(text) => (at, text),
                    None => {
                        if not std_modules().contains(name) {
                            let place = if pk.is_some() { local + ", a dependency in tenon.toml" } else { local }
                            return Err(diag(files, i, im.1.line, im.1.col,
                                "cannot find module '{name}' ({place} or the standard library)"))
                        }
                        match fs.read(join(root, "lib/std/" + name + ".tn")) {
                            Ok(text) => ("<std>/" + name + ".tn", text),
                            Err(e) => return Err(io_fail("cannot read the standard library: {e}")),
                        }
                    }
                }
                match known {
                    Some(k) => if files[k].0 != file.0 {
                        return Err(diag(files, i, im.1.line, im.1.col,
                            "module '{name}' is both {files[k].0} and {file.0}; module names must be unique in a program"))
                    },
                    None => {
                        files.push(file)
                        modules.push(name)
                    }
                }
            }
        }
        i += 1
    }
    Ok((files, parsed, modules))
}
