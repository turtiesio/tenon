enum Elem {
    Star,
    Any,
    Lit(Int),
    Class(Bool, List[(Int, Int)]),
}

fn lower(b: Int) -> Int { if b.is_upper() { b + 32 } else { b } }
fn upper(b: Int) -> Int { if b.is_lower() { b - 32 } else { b } }

fn in_set(set: List[(Int, Int)], b: Int) -> Bool {
    for (lo, hi) in set {
        if b >= lo and b <= hi { return true }
    }
    false
}

// Parses one class character at `i` (a plain byte or `\c`); returns the byte and the next index.
fn class_char(pat: Str, i: Int) -> Result[(Int, Int), Str] {
    if i >= pat.len() { return Err("unterminated class") }
    if pat.byte(i) == '\\' {
        if i + 1 >= pat.len() { return Err("trailing backslash") }
        Ok((pat.byte(i + 1), i + 2))
    } else {
        Ok((pat.byte(i), i + 1))
    }
}

fn parse_class(pat: Str, start: Int) -> Result[(Elem, Int), Str] {
    var i = start
    var neg = false
    if i < pat.len() and pat.byte(i) == '!' {
        neg = true
        i += 1
    }
    var items: List[(Int, Int)] = []
    var first = true
    while true {
        if i >= pat.len() { return Err("unterminated class") }
        if pat.byte(i) == ']' and not first { return Ok((Class(neg, items), i + 1)) }
        first = false
        let (x, after) = class_char(pat, i)?
        i = after
        if i + 1 < pat.len() and pat.byte(i) == '-' and pat.byte(i + 1) != ']' {
            let (y, after_y) = class_char(pat, i + 1)?
            if x > y { return Err("range out of order") }
            items.push((x, y))
            i = after_y
        } else {
            items.push((x, x))
        }
    }
    Err("unreachable")
}

fn parse_pattern(pat: Str) -> Result[List[Elem], Str] {
    var elems: List[Elem] = []
    var i = 0
    while i < pat.len() {
        let b = pat.byte(i)
        if b == '*' {
            // consecutive stars are equivalent to one
            if elems.is_empty() or elems[elems.len() - 1] != Star { elems.push(Star) }
            i += 1
        } else if b == '?' {
            elems.push(Any)
            i += 1
        } else if b == '\\' {
            if i + 1 >= pat.len() { return Err("pattern ends with a backslash") }
            elems.push(Lit(pat.byte(i + 1)))
            i += 2
        } else if b == '[' {
            let (e, next) = parse_class(pat, i + 1)?
            elems.push(e)
            i = next
        } else {
            elems.push(Lit(b))
            i += 1
        }
    }
    Ok(elems)
}

fn elem_matches(e: Elem, c: Int, ci: Bool) -> Bool {
    match e {
        Star => true,
        Any => true,
        Lit(x) => if ci { lower(x) == lower(c) } else { x == c },
        Class(neg, set) => {
            var hit = in_set(set, c)
            if ci and not hit { hit = in_set(set, lower(c)) or in_set(set, upper(c)) }
            hit != neg
        }
    }
}

fn close(elems: List[Elem], states: mut List[Bool]) {
    for j in 0..elems.len() {
        if states[j] and elems[j] == Star { states[j + 1] = true }
    }
}

// Simulates all pattern positions at once: O(pattern * line).
fn matches(elems: List[Elem], line: Str, ci: Bool) -> Bool {
    let n = elems.len()
    var cur = List.filled(n + 1, false)
    cur[0] = true
    close(elems, mut cur)
    for k in 0..line.len() {
        let c = line.byte(k)
        var next = List.filled(n + 1, false)
        for j in 0..n {
            if not cur[j] { continue }
            if elems[j] == Star {
                next[j] = true
            } else if elem_matches(elems[j], c, ci) {
                next[j + 1] = true
            }
        }
        close(elems, mut next)
        cur = next
    }
    cur[n]
}

fn main(sys: Sys) -> Int {
    let con = sys.console
    var ci = false
    var invert = false
    var count = false
    var pattern: Option[Str] = None
    var options_done = false
    for a in sys.args {
        if pattern.is_some() {
            con.eprintln("unexpected argument: {a}")
            return 2
        }
        if options_done {
            pattern = Some(a)
        } else if a == "--" {
            options_done = true
        } else if a == "-i" {
            ci = true
        } else if a == "-v" {
            invert = true
        } else if a == "-c" {
            count = true
        } else if a.starts_with("-") {
            con.eprintln("unknown option: {a}")
            return 2
        } else {
            pattern = Some(a)
        }
    }
    let Some(pat) = pattern else {
        con.eprintln("missing pattern")
        return 2
    }
    let elems = match parse_pattern(pat) {
        Ok(e) => e,
        Err(msg) => {
            con.eprintln("invalid pattern: {msg}")
            return 2
        }
    }
    var out = ""
    var selected = 0
    for raw in con.read_all().lines() {
        let line = raw.strip_suffix("\r").unwrap_or(raw)
        if matches(elems, line, ci) != invert {
            selected += 1
            if not count { out += line + "\n" }
        }
    }
    if count { out = "{selected}\n" }
    con.print(out)
    if selected > 0 { 0 } else { 1 }
}
