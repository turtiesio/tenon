struct Stats { days: Int, lo: Int, hi: Int, sum: Int }

struct Reading { station: Str, date: Str, temp: Int }

fn digits_at(s: Str, start: Int, count: Int) -> Option[Int] {
    let part = s.slice(start, start + count)
    if part.len() != count or not part.is_digits() { return None }
    part.to_int()
}

fn is_leap(y: Int) -> Bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn days_in_month(y: Int, m: Int) -> Int {
    if m == 2 {
        if is_leap(y) { 29 } else { 28 }
    } else if m == 4 or m == 6 or m == 9 or m == 11 {
        30
    } else {
        31
    }
}

fn valid_date(d: Str) -> Bool {
    if d.len() != 10 or d.byte(4) != '-' or d.byte(7) != '-' { return false }
    let Some(y) = digits_at(d, 0, 4) else { return false }
    let Some(m) = digits_at(d, 5, 2) else { return false }
    let Some(day) = digits_at(d, 8, 2) else { return false }
    if y < 1 or m < 1 or m > 12 { return false }
    day >= 1 and day <= days_in_month(y, m)
}

// -?[0-9]{1,2}\.[0-9] as tenths of a degree
fn parse_temp(s: Str) -> Option[Int] {
    let neg = s.starts_with("-")
    let body = if neg { s.slice(1, s.len()) } else { s }
    let n = body.len()
    if n != 3 and n != 4 { return None }
    if body.byte(n - 2) != '.' { return None }
    let whole = body.slice(0, n - 2)
    let frac = body.slice(n - 1, n)
    if not whole.is_digits() or not frac.is_digits() { return None }
    let t = whole.to_int()? * 10 + frac.to_int()?
    Some(if neg { -t } else { t })
}

fn valid_station(s: Str) -> Bool {
    let n = s.char_count()
    n >= 1 and n <= 40 and not s.starts_with(" ") and not s.ends_with(" ")
}

fn parse_line(line: Str) -> Option[Reading] {
    let f = line.split(";")
    if f.len() != 3 { return None }
    if not valid_station(f[0]) or not valid_date(f[1]) { return None }
    let t = parse_temp(f[2])?
    Some(Reading { station: f[0], date: f[1], temp: t })
}

fn fmt_tenths(t: Int) -> Str {
    let a = t.abs()
    (if t < 0 { "-" } else { "" }) + "{a / 10}.{a % 10}"
}

// mean of sum / days in tenths, halves away from zero
fn mean_tenths(sum: Int, days: Int) -> Int {
    if sum >= 0 {
        (2 * sum + days) / (2 * days)
    } else {
        -((-2 * sum + days) / (2 * days))
    }
}

fn main(sys: Sys) -> Int {
    let con = sys.console
    var by_year = false
    if sys.args.len() > 1 or (sys.args.len() == 1 and sys.args[0] != "-y") {
        con.eprintln("usage: climate [-y]")
        return 2
    }
    if sys.args.len() == 1 { by_year = true }

    var used: Map[(Str, Str), Int] = [:]
    var skipped = 0
    var replaced = 0
    for raw in con.read_all().lines() {
        let line = raw.strip_suffix("\r").unwrap_or(raw)
        if line.is_empty() { continue }
        let Some(r) = parse_line(line) else {
            skipped += 1
            continue
        }
        let key = (r.station, r.date)
        if used.contains(key) { replaced += 1 }
        used[key] = r.temp
    }

    var groups: Map[(Str, Str), Stats] = [:]
    for ((station, date), temp) in used.entries() {
        let period = if by_year { date.slice(0, 4) } else { date.slice(0, 7) }
        let key = (station, period)
        if groups.contains(key) {
            groups[key].days += 1
            groups[key].lo = groups[key].lo.min(temp)
            groups[key].hi = groups[key].hi.max(temp)
            groups[key].sum += temp
        } else {
            groups[key] = Stats { days: 1, lo: temp, hi: temp, sum: temp }
        }
    }

    var keys = groups.keys()
    keys.sort()
    for key in keys {
        let g = groups[key]
        con.println("{key.0} {key.1} days={g.days} min={fmt_tenths(g.lo)} max={fmt_tenths(g.hi)} mean={fmt_tenths(mean_tenths(g.sum, g.days))}")
    }
    con.println("readings={used.len()} skipped={skipped} replaced={replaced}")
    0
}
