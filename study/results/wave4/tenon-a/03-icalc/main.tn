// icalc [-D NAME=VALUE]... EXPR

const LIMIT: Int = 999999999999999

enum Tok { TNum(Int), TName(Str), TOp(Int) }

enum Expr { Num(Int), Var(Str), Neg(Expr), Bin(Int, Expr, Expr) }

fn is_name_start(c: Int) -> Bool { c >= 'a' and c <= 'z' }
fn is_name_char(c: Int) -> Bool { is_name_start(c) or c.is_digit() or c == '_' }

// None on any lexical error.
fn tokenize(s: Str) -> Option[List[Tok]] {
    var toks: List[Tok] = []
    var i = 0
    let n = s.len()
    while i < n {
        let c = s.byte(i)
        if c == ' ' {
            i += 1
        } else if c.is_digit() {
            let start = i
            while i < n and s.byte(i).is_digit() { i += 1 }
            if i - start > 15 { return None }
            toks.push(TNum(s.slice(start, i).to_int()?))
        } else if is_name_start(c) {
            let start = i
            while i < n and is_name_char(s.byte(i)) { i += 1 }
            toks.push(TName(s.slice(start, i)))
        } else if c == '+' or c == '-' or c == '*' or c == '/' or c == '%' or c == '(' or c == ')' {
            toks.push(TOp(c))
            i += 1
        } else {
            return None
        }
    }
    Some(toks)
}

struct Parser { toks: List[Tok], pos: Int }

fn Parser.peek_op(self) -> Option[Int] {
    match self.toks.get(self.pos) {
        Some(TOp(c)) => Some(c),
        _ => None,
    }
}

fn Parser.expr(mut self) -> Option[Expr] {
    var left = self.term()?
    while let Some(op) = self.peek_op() {
        if op != '+' and op != '-' { break }
        self.pos += 1
        let right = self.term()?
        left = Bin(op, left, right)
    }
    Some(left)
}

fn Parser.term(mut self) -> Option[Expr] {
    var left = self.unary()?
    while let Some(op) = self.peek_op() {
        if op != '*' and op != '/' and op != '%' { break }
        self.pos += 1
        let right = self.unary()?
        left = Bin(op, left, right)
    }
    Some(left)
}

fn Parser.unary(mut self) -> Option[Expr] {
    if self.peek_op() == Some('-') {
        self.pos += 1
        return Some(Neg(self.unary()?))
    }
    self.primary()
}

fn Parser.primary(mut self) -> Option[Expr] {
    let tok = self.toks.get(self.pos)?
    self.pos += 1
    match tok {
        TNum(n) => Some(Num(n)),
        TName(name) => Some(Var(name)),
        TOp(c) => {
            if c != '(' { return None }
            let inner = self.expr()?
            if self.peek_op() != Some(')') { return None }
            self.pos += 1
            Some(inner)
        }
    }
}

fn parse(s: Str) -> Option[Expr] {
    var p = Parser { toks: tokenize(s)?, pos: 0 }
    let e = p.expr()?
    if p.pos != p.toks.len() { return None }
    Some(e)
}

fn check(v: Option[Int]) -> Result[Int, Str] {
    match v {
        Some(x) if x.abs() <= LIMIT => Ok(x),
        _ => Err("overflow"),
    }
}

fn eval(e: Expr, vars: Map[Str, Int]) -> Result[Int, Str] {
    match e {
        Num(n) => Ok(n),
        Var(name) => vars.get(name).ok_or("undefined {name}"),
        Neg(inner) => Ok(-eval(inner, vars)?),
        Bin(op, l, r) => {
            let a = eval(l, vars)?
            let b = eval(r, vars)?
            if (op == '/' or op == '%') and b == 0 { return Err("division by zero") }
            match op {
                '+' => check(a.checked_add(b)),
                '-' => check(a.checked_sub(b)),
                '*' => check(a.checked_mul(b)),
                '/' => check(a.checked_div(b)),
                _ => check(Some(a % b)),
            }
        }
    }
}

// [a-z][a-z0-9_]{0,15}=-?[0-9]{1,15}
fn parse_define(v: Str) -> Option[(Str, Int)] {
    let (name, num) = v.split_once("=")?
    if name.is_empty() or name.len() > 16 or not is_name_start(name.byte(0)) { return None }
    for i in 0..name.len() {
        if not is_name_char(name.byte(i)) { return None }
    }
    let digits = num.strip_prefix("-").unwrap_or(num)
    if not digits.is_digits() or digits.len() > 15 { return None }
    Some((name, num.to_int()?))
}

fn main(sys: Sys) -> Int {
    let con = sys.console
    let args = sys.args
    var vars: Map[Str, Int] = [:]
    var exprs: List[Str] = []
    var i = 0
    while i < args.len() {
        if args[i] == "-D" {
            if i + 1 >= args.len() {
                con.eprintln("icalc: -D needs a value")
                return 2
            }
            let Some((name, value)) = parse_define(args[i + 1]) else {
                con.eprintln("icalc: bad definition '{args[i + 1]}'")
                return 2
            }
            vars[name] = value
            i += 2
        } else {
            exprs.push(args[i])
            i += 1
        }
    }
    if exprs.len() != 1 {
        con.eprintln("usage: icalc [-D NAME=VALUE]... EXPR")
        return 2
    }
    let Some(e) = parse(exprs[0]) else {
        con.println("error: syntax")
        return 1
    }
    match eval(e, vars) {
        Ok(v) => {
            con.println("{v}")
            0
        }
        Err(reason) => {
            con.println("error: {reason}")
            1
        }
    }
}
