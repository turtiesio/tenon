struct Request { time: Int, origin: Int, destination: Int }
fn parse(input: Str, floors: Int) -> Option[List[Request]] {
    var requests: List[Request] = []
    var previous_time = 0
    for raw in input.lines() {
        let line = raw.strip_suffix("\r").unwrap_or(raw)
        if line.trim_chars(" ").is_empty() { continue }
        let parts = line.split(" ")
        if parts.len() != 3 { return None }
        for (index, part) in parts.enumerate() {
            if not part.is_digits() or part.len() > (if index == 0 { 6 } else { 3 }) { return None }
        }
        let time = parts[0].to_int()?
        let origin = parts[1].to_int()?
        let destination = parts[2].to_int()?
        if time < previous_time or origin >= floors or destination >= floors or origin == destination { return None }
        requests.push(Request { time: time, origin: origin, destination: destination })
        previous_time = time
    }
    Some(requests)
}
fn main(sys: Sys) -> Int {
    if sys.args.len() != 1 { sys.console.eprintln("expected floor count"); return 2 }
    let arg = sys.args[0]
    if not arg.is_digits() or arg.len() > 3 { sys.console.eprintln("invalid floor count"); return 2 }
    let floors = arg.to_int().unwrap()
    if floors < 2 or floors > 100 { sys.console.eprintln("invalid floor count"); return 2 }
    let Some(requests) = parse(sys.console.read_all(), floors) else { sys.console.eprintln("invalid request"); return 1 }
    var waiting: List[List[Int]] = List.filled(floors, [])
    var riding: List[List[Int]] = List.filled(floors, [])
    var boarded: List[Int] = List.filled(requests.len(), -1)
    var arrived: List[Int] = List.filled(requests.len(), -1)
    var next_request = 0
    var completed = 0
    var floor = 0
    var direction = 0
    var tick = 0
    var moves = 0
    var stops = 0
    var finish = 0
    var total_wait = 0
    while completed < requests.len() {
        while next_request < requests.len() and requests[next_request].time == tick {
            waiting[requests[next_request].origin].push(next_request)
            next_request += 1
        }
        if not riding[floor].is_empty() or not waiting[floor].is_empty() {
            for leaving in riding[floor] { arrived[leaving] = tick; completed += 1 }
            riding[floor].clear()
            for entering in waiting[floor] {
                boarded[entering] = tick
                total_wait += tick - requests[entering].time
                riding[requests[entering].destination].push(entering)
            }
            waiting[floor].clear()
            stops += 1
            if completed == requests.len() { finish = tick; break }
        } else {
            var above = false
            var below = false
            var nearest = -1
            var distance = floors + 1
            for target in 0..floors {
                if waiting[target].is_empty() and riding[target].is_empty() { continue }
                if target > floor { above = true } else { below = true }
                let gap = (target - floor).abs()
                if gap <= distance { nearest = target; distance = gap }
            }
            if nearest == -1 {
                direction = 0
                if next_request < requests.len() { tick = requests[next_request].time; continue }
            } else {
                if direction == 0 { direction = if nearest > floor { 1 } else { -1 } }
                else if direction == 1 and not above { direction = -1 }
                else if direction == -1 and not below { direction = 1 }
                floor += direction
                moves += 1
            }
        }
        tick += 1
    }
    for (index, request) in requests.enumerate() {
        let _ = request
        sys.console.println("{index + 1} board={boarded[index]} arrive={arrived[index]}")
    }
    sys.console.println("moves={moves} stops={stops} finish={finish} total_wait={total_wait}")
    0
}
