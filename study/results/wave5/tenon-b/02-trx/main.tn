struct Token { code: Int, escaped: Bool }

fn tokenize(arg: Str) -> Result[List[Token], Str] {
    var out: List[Token] = []
    var i = 0
    while i < arg.len() {
        let c = arg.byte(i)
        if c == '\\' {
            if i + 1 >= arg.len() { return Err("trailing backslash in '{arg}'") }
            let d = arg.byte(i + 1)
            if d == 'n' {
                out.push(Token { code: '\n', escaped: true })
            } else if d == 't' {
                out.push(Token { code: '\t', escaped: true })
            } else if d == '\\' {
                out.push(Token { code: '\\', escaped: true })
            } else if d == '-' {
                out.push(Token { code: '-', escaped: true })
            } else {
                return Err("bad escape in '{arg}'")
            }
            i += 2
        } else {
            out.push(Token { code: c, escaped: false })
            i += 1
        }
    }
    Ok(out)
}

fn parse_set(arg: Str) -> Result[List[Int], Str] {
    let toks = tokenize(arg)?
    var out: List[Int] = []
    var i = 0
    while i < toks.len() {
        let t = toks[i]
        let is_range = i + 2 < toks.len() and toks[i + 1].code == '-' and not toks[i + 1].escaped
        if is_range {
            let hi = toks[i + 2].code
            if t.code > hi { return Err("reversed range in '{arg}'") }
            for c in t.code..(hi + 1) { out.push(c) }
            i += 3
        } else {
            out.push(t.code)
            i += 1
        }
    }
    Ok(out)
}

fn in_set(table: List[Bool], c: Int) -> Bool { c >= 0 and c < 256 and table[c] }

fn membership(set: List[Int]) -> List[Bool] {
    var t = List.filled(256, false)
    for c in set { t[c] = true }
    t
}

fn usage(sys: Sys, msg: Str) -> Int {
    sys.console.eprintln("trx: {msg}")
    sys.console.eprintln("usage: trx [-d] [-s] [--] SET1 [SET2]")
    2
}

fn main(sys: Sys) -> Int {
    let args = sys.args
    var delete = false
    var squeeze = false
    var i = 0
    while i < args.len() {
        let a = args[i]
        if a == "-d" {
            delete = true
        } else if a == "-s" {
            squeeze = true
        } else if a == "--" {
            i += 1
            break
        } else if a.starts_with("-") and a.len() >= 2 {
            return usage(sys, "unknown option '{a}'")
        } else {
            break
        }
        i += 1
    }
    let sets = args.slice(i, args.len())
    let want = if delete and squeeze { 2 } else if delete { 1 } else if squeeze { 1 } else { 2 }
    let want_alt = if squeeze and not delete { 2 } else { want }
    if sets.len() != want and sets.len() != want_alt {
        return usage(sys, "wrong number of sets")
    }
    let translate = not delete and sets.len() == 2

    let set1 = match parse_set(sets[0]) {
        Ok(s) => s,
        Err(e) => return usage(sys, e),
    }
    var set2: List[Int] = []
    if sets.len() == 2 {
        set2 = match parse_set(sets[1]) {
            Ok(s) => s,
            Err(e) => return usage(sys, e),
        }
    }
    if translate and set2.is_empty() { return usage(sys, "SET2 must not be empty") }

    // mapping table: -1 means "not in SET1"
    var map = List.filled(256, -1)
    if translate {
        for (k, x) in set1.enumerate() {
            map[x] = if k < set2.len() { set2[k] } else { set2[set2.len() - 1] }
        }
    }
    let del_table = membership(if delete { set1 } else { [] })
    let squeeze_set = if sets.len() == 2 { set2 } else { set1 }
    let sq_table = membership(if squeeze { squeeze_set } else { [] })

    let input = sys.console.read_all_bytes()
    var out: List[Int] = []
    var last = -1
    for b in input {
        var c = b
        if delete and in_set(del_table, c) { continue }
        if translate and map[c] >= 0 { c = map[c] }
        if squeeze and c == last and in_set(sq_table, c) { continue }
        out.push(c)
        last = c
    }
    sys.console.write_bytes(out)
    0
}
