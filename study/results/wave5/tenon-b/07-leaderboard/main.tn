struct Entry { rank: Int, name: Str, total: Int }

struct Board { scores: Map[Str, Int], order: List[Entry], dirty: Bool }

fn valid_player(s: Str) -> Bool {
    if s.len() < 1 or s.len() > 16 or not s.byte(0).is_lower() { return false }
    for i in 1..s.len() {
        let c = s.byte(i)
        if not (c.is_lower() or c.is_digit() or c == '_') { return false }
    }
    true
}

fn digits_between(s: Str, lo: Int, hi: Int) -> Bool {
    s.len() >= lo and s.len() <= hi and s.is_digits()
}

fn parse_points(s: Str) -> Option[Int] {
    let body = s.strip_prefix("-").unwrap_or(s)
    if not digits_between(body, 1, 6) { return None }
    s.to_int()
}

fn parse_k(s: Str) -> Option[Int] {
    if not digits_between(s, 1, 3) or s.byte(0) == '0' { return None }
    s.to_int()
}

fn parse_d(s: Str) -> Option[Int] {
    if not digits_between(s, 1, 3) { return None }
    s.to_int()
}

fn Entry.text(self) -> Str { "{self.rank}:{self.name}:{self.total}" }

fn Board.ordered(mut self) -> List[Entry] {
    if self.dirty {
        var pairs = self.scores.entries()
        pairs.sort_by(fn(e) => (-e.1, e.0))
        var out: List[Entry] = []
        for (i, p) in pairs.enumerate() {
            let rank = if i > 0 and out[i - 1].total == p.1 { out[i - 1].rank } else { i + 1 }
            out.push(Entry { rank, name: p.0, total: p.1 })
        }
        self.order = out
        self.dirty = false
    }
    self.order
}

fn listing(head: Str, entries: List[Entry]) -> Str {
    var s = head
    for e in entries { s += " " + e.text() }
    s
}

fn Board.handle(mut self, line: Str) -> Str {
    let bad = "ERR bad command"
    let unknown = "ERR unknown player"
    let w = line.split(" ")
    match w[0] {
        "SCORE" => {
            if w.len() != 3 or not valid_player(w[1]) { return bad }
            let Some(n) = parse_points(w[2]) else { return bad }
            let total = self.scores.get_or(w[1], 0) + n
            self.scores[w[1]] = total
            self.dirty = true
            "TOTAL {total}"
        }
        "RANK" => {
            if w.len() != 2 or not valid_player(w[1]) { return bad }
            let Some(total) = self.scores.get(w[1]) else { return unknown }
            var higher = 0
            for v in self.scores.values() {
                if v > total { higher += 1 }
            }
            "RANK {higher + 1} {total}"
        }
        "TOP" => {
            if w.len() != 2 { return bad }
            let Some(k) = parse_k(w[1]) else { return bad }
            let all = self.ordered()
            listing("TOP", all.slice(0, k.min(all.len())))
        }
        "AROUND" => {
            if w.len() != 3 or not valid_player(w[1]) { return bad }
            let Some(d) = parse_d(w[2]) else { return bad }
            if not self.scores.contains(w[1]) { return unknown }
            let all = self.ordered()
            var pos = 0
            for (i, e) in all.enumerate() {
                if e.name == w[1] { pos = i }
            }
            listing("AROUND", all.slice((pos - d).max(0), (pos + d).min(all.len() - 1) + 1))
        }
        "REMOVE" => {
            if w.len() != 2 or not valid_player(w[1]) { return bad }
            let Some(_) = self.scores.remove(w[1]) else { return unknown }
            self.dirty = true
            "OK"
        }
        "COUNT" => {
            if w.len() != 1 { return bad }
            "COUNT {self.scores.len()}"
        }
        _ => bad,
    }
}

fn main(sys: Sys) -> Int {
    let con = sys.console
    if not sys.args.is_empty() {
        con.eprintln("usage: leaderboard (no arguments)")
        return 2
    }
    var board = Board { scores: [:], order: [], dirty: false }
    while let Some(line) = con.read_line() {
        con.println(board.handle(line))
        con.flush()
    }
    0
}
