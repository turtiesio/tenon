// The docs name only paths that exist (tenon.md §6, "No staleness").
//
//     tenon run ops/gates/doclinks.tn        (from the repository root; ./check runs it)
//
// Reads README.md and every docs/**/*.md, outside fenced code blocks, and
// checks two kinds of path:
//   - a relative link `[text](path)`, relative to the document's directory;
//   - a repository path: a word, in backticks or not, with a `/` and whose
//     first component is a top-level entry of the repository
//     (`compiler/tenon.tn`, `tests/run/`, `lib/prelude.tn:26`).
// Each must name a file or directory that exists. A path with `*` must match
// at least one; so must one with a placeholder (NAME, DIR, FILE, N, ...:
// `tests/run/NAME.tn`, `evidence/study/results/waveN/`) that does not exist as
// written. Words with `{`, `$`, `<` or `=` are not paths. The exceptions are
// listed, with their reasons, in ops/gates/doclinks_ignore.txt: `doc PATH` (a
// document that is not read) and `path GLOB` (a path that is not checked).
// Prints each missing path as DOC:LINE; exit status 1 if there is one.

struct Ignore { docs: List[Str], paths: List[Str] }

const PLACEHOLDERS: List[Str] = ["NAME", "DIR", "FILE", "OUT", "PREFIX", "TAG", "EXE", "N", "K", "X"]

fn load_ignore(fs: Fs) -> Ignore {
    var ig = Ignore { docs: [], paths: [] }
    let Ok(text) = fs.read("ops/gates/doclinks_ignore.txt") else { return ig }
    for line in text.lines() {
        let w = line.words()
        if w.len() < 2 or w[0].starts_with("#") { continue }
        if w[0] == "doc" { ig.docs.push(w[1]) } else if w[0] == "path" { ig.paths.push(w[1]) }
    }
    ig
}

fn md_files(fs: Fs, dir: Str, out: mut List[Str]) {
    let Ok(names) = fs.list(dir) else { return }
    for n in names {
        let p = path_join(dir, n)
        if fs.is_dir(p) { md_files(fs, p, mut out) } else if n.ends_with(".md") { out.push(p) }
    }
}

// `a/./b/../c` is `a/c`; None if it leaves the root
fn normalize(p: Str) -> Option[Str] {
    var parts: List[Str] = []
    for c in p.split("/") {
        if c == "" or c == "." { continue }
        if c == ".." {
            if parts.is_empty() { return None }
            let _ = parts.pop()
        } else {
            parts.push(c)
        }
    }
    Some(parts.join("/"))
}

// does `s` from byte `j` match `pat` from byte `i` (`*`: any run of bytes)?
fn wild(pat: Str, s: Str, i: Int, j: Int) -> Bool {
    if i == pat.len() { return j == s.len() }
    if pat.byte(i) == '*' {
        for k in j..s.len() + 1 {
            if wild(pat, s, i + 1, k) { return true }
        }
        return false
    }
    j < s.len() and pat.byte(i) == s.byte(j) and wild(pat, s, i + 1, j + 1)
}

fn glob_exists(fs: Fs, base: Str, comps: List[Str], k: Int) -> Bool {
    if k == comps.len() { return true }
    let c = comps[k]
    if not c.contains("*") {
        let p = path_join(base, c)
        return fs.exists(p) and glob_exists(fs, p, comps, k + 1)
    }
    let Ok(names) = fs.list(if base == "" { "." } else { base }) else { return false }
    names.any(fn(n) => wild(c, n, 0, 0) and glob_exists(fs, path_join(base, n), comps, k + 1))
}

// each placeholder (a run of capitals in PLACEHOLDERS) becomes `*`
fn unplaceholder(c: Str) -> Str {
    var out = ""
    var i = 0
    while i < c.len() {
        var j = i
        while j < c.len() and c.byte(j).is_upper() { j += 1 }
        if j > i {
            let run = c.slice(i, j)
            out += if PLACEHOLDERS.contains(run) { "*" } else { run }
            i = j
        } else {
            out += c.slice(i, i + 1)
            i += 1
        }
    }
    out
}

fn exists(fs: Fs, path: Str) -> Bool {
    if path == "" or fs.exists(path) { return true }
    let comps = path.split("/").filter(fn(c) => c != "").map(unplaceholder)
    glob_exists(fs, "", comps, 0)
}

fn ignored(ig: Ignore, path: Str) -> Bool {
    let p = path.trim_end_chars("/")
    ig.paths.any(fn(g) => wild(g.trim_end_chars("/"), p, 0, 0))
}

// the targets of the links `[text](target)` on a line, and the line without them
fn links(line: Str) -> (List[Str], Str) {
    var out: List[Str] = []
    var rest = ""
    var i = 0
    while let Some(k) = line.find_from("](", i) {
        let Some(e) = line.find_from(")", k + 2) else { break }
        let target = line.slice(k + 2, e)
        let in_code = line.slice(0, k).bytes().count(fn(b) => b == '`') % 2 == 1
        if in_code or target.contains(" ") {
            // not a link: code such as `fn f[T: A](x: T)`
            rest += line.slice(i, k + 2)
            i = k + 2
        } else {
            out.push(target)
            rest += line.slice(i, k + 1) + " "
            i = e + 1
        }
    }
    rest += line.slice(i, line.len())
    (out, rest)
}

// a word as a repository path: without quotes, brackets, punctuation and a `:LINE` suffix
fn as_path(word: Str, top: List[Str]) -> Option[Str] {
    var w = word.trim_start_chars("(`[\"'*").trim_end_chars(".,:;)`]\"'")
    w = w.strip_suffix("'s").unwrap_or(w).trim_end_chars("`")
    if w.contains("://") or w.starts_with("/") { return None }
    if w.contains("\{") or w.contains("$") or w.contains("<") or w.contains("=") or w.contains("|") { return None }
    if let Some((p, suffix)) = w.rsplit_once(":") {
        if suffix.all_bytes(fn(b) => b.is_digit() or b == ',' or b == '-') { w = p }
    }
    let p = w.strip_prefix("./").unwrap_or(w)
    let Some(slash) = p.find("/") else { return None }
    if top.contains(p.slice(0, slash)) { Some(p) } else { None }
}

fn main(sys: Sys) -> Int {
    let con = sys.console
    let fs = sys.fs.within(".").read_only()
    let ig = load_ignore(fs)
    let top = fs.list(".").unwrap_or([])
    var docs = ["README.md"]
    md_files(fs, "docs", mut docs)
    var checked = 0
    var missing = 0
    var read = 0
    for doc in docs {
        if ig.docs.contains(doc) { continue }
        let Ok(text) = fs.read(doc) else {
            con.eprintln("doclinks: cannot read {doc}")
            return 2
        }
        read += 1
        var fenced = false
        for (n, line) in text.lines().enumerate() {
            if line.trim().starts_with("```") {
                fenced = not fenced
                continue
            }
            if fenced { continue }
            let (targets, rest) = links(line)
            var paths: List[(Str, Str)] = []
            for t in targets {
                let target = t.split("#")[0]
                if target == "" or target.contains("://") or target.starts_with("mailto:") { continue }
                match normalize(path_join(path_parent(doc), target)) {
                    Some(p) => paths.push((t, p)),
                    None => paths.push((t, "..")),
                }
            }
            for word in rest.words() {
                if let Some(p) = as_path(word, top) { paths.push((p, p)) }
            }
            for (shown, p) in paths {
                if ignored(ig, p) { continue }
                checked += 1
                if p == ".." or not exists(fs, p) {
                    con.println("{doc}:{n + 1}: {shown}: no such file or directory")
                    missing += 1
                }
            }
        }
    }
    con.println("doclinks: {read} docs, {checked} paths, {missing} missing")
    if missing > 0 { 1 } else { 0 }
}
