// STATUS.md is not older than the last evidence run (tenon.md §6 item 2,
// "No-staleness gates").
//
//     tenon run ops/gates/status_age.tn        (from the repository root; ./check runs it)
//
// An evidence run ends with ops/repo/status.py, which writes STATUS.md
// ("Generated by `ops/repo/status.py` at commit `C` on DATE") and appends the
// same date and commit to .evidence/history.jsonl. STATUS.md is older than the
// last run when the last line of .evidence/history.jsonl has a later date, or
// the same date and a commit of which STATUS.md's commit is a proper ancestor
// (`git merge-base --is-ancestor`). Only what is provably older fails: with no
// .evidence/history.jsonl (a fresh clone, CI), or commits git does not know (a
// shallow clone), only the dates are compared. A STATUS.md without its
// "Generated by" line fails.

// The text after `key` up to the next `stop`: field(line, "\"date\": \"", "\"").
fn field(line: Str, key: Str, stop: Str) -> Option[Str] {
    let i = line.find(key)?
    let start = i + key.len()
    let end = line.find_from(stop, start)?
    Some(line.slice(start, end))
}

fn main(sys: Sys) -> Int {
    let con = sys.console
    let fs = sys.fs.within(".").read_only()
    let fix = "regenerate it with `python3 ops/repo/status.py` (or land the evidence run's STATUS.md)"
    let status = fs.read("STATUS.md").unwrap_or("")
    let Some(gen) = status.lines().filter(fn(l) => l.starts_with("Generated by ")).first() else {
        con.println("status_age: STATUS.md has no `Generated by ... at commit `C` on DATE` line; {fix}")
        return 1
    }
    let (Some(s_commit), Some(s_date)) = (field(gen, "at commit `", "`"), field(gen, " on ", ".")) else {
        con.println("status_age: cannot read the commit and date of STATUS.md's line: {gen}")
        return 1
    }
    let Ok(hist) = fs.read(".evidence/history.jsonl") else {
        con.println("status_age: STATUS.md of {s_date} (`{s_commit}`); no .evidence/history.jsonl here, nothing newer to compare")
        return 0
    }
    let runs = hist.lines().filter(fn(l) => l.trim() != "")
    let Some(last) = runs.last() else {
        con.println("status_age: STATUS.md of {s_date}; .evidence/history.jsonl is empty")
        return 0
    }
    let (Some(e_date), Some(e_commit)) = (field(last, "\"date\": \"", "\""), field(last, "\"commit\": \"", "\"")) else {
        con.println("status_age: cannot read the date and commit of the last line of .evidence/history.jsonl: {last}")
        return 1
    }
    var older = e_date > s_date
    if e_date == s_date and e_commit != s_commit {
        let r = sys.proc.run_with("git", ["merge-base", "--is-ancestor", s_commit, e_commit], "", [], 10000)
        older = r.is_ok_and(fn(o) => o.status == 0)
    }
    if older {
        con.println("status_age: STATUS.md (commit `{s_commit}`, {s_date}) is older than the last evidence run (.evidence/history.jsonl: `{e_commit}`, {e_date}); {fix}")
        return 1
    }
    con.println("status_age: STATUS.md (`{s_commit}`, {s_date}) is not older than the last evidence run (`{e_commit}`, {e_date})")
    0
}
