// Tenon prelude: implicitly part of every program.
// `extern fn` signatures are implemented by each backend (interpreter and C);
// everything else is ordinary Tenon. This file is the single source of the
// builtin API.

enum Option[T] { Some(T), None }
enum Result[T, E] { Ok(T), Err(E) }
enum IoError { NotFound(Str), Denied(Str), Failed(Str) }

// The authority a program starts with; only `main` receives one.
pub struct Sys { pub console: Console, pub fs: Fs, pub clock: Clock, pub net: Net, pub args: List[Str] }

extern fn panic[T](msg: Str) -> T
extern fn assert(cond: Bool)

// Derived, strict codec: the literal syntax that formatting prints, with every
// field. `decode` accepts exactly what `encode` produces and nothing else.
// Not available for functions, capabilities, linear/unique types, or types
// with fields the caller cannot see (decoding must not forge values).
extern fn encode[T](x: T) -> Str
extern fn decode[T](s: Str) -> Result[T, Str]

// ---- Int / Float ----
pub const INT_MAX: Int = 9223372036854775807
pub const INT_MIN: Int = -9223372036854775807 - 1
// Arithmetic that reports overflow (and division by zero) as None instead of trapping.
extern fn Int.checked_add(self, o: Int) -> Option[Int]
extern fn Int.checked_sub(self, o: Int) -> Option[Int]
extern fn Int.checked_mul(self, o: Int) -> Option[Int]
extern fn Int.checked_div(self, o: Int) -> Option[Int]
extern fn Int.to_float(self) -> Float
fn Int.abs(self) -> Int { if self < 0 { -self } else { self } }
fn Int.min(self, o: Int) -> Int { if self < o { self } else { o } }
fn Int.max(self, o: Int) -> Int { if self > o { self } else { o } }
// Euclidean division: the remainder is never negative (-7.rem_euclid(3) == 2).
fn Int.rem_euclid(self, d: Int) -> Int {
    let r = self % d
    if r < 0 { r + d.abs() } else { r }
}
fn Int.div_euclid(self, d: Int) -> Int { (self - self.rem_euclid(d)) / d }
// self to the power e (e >= 0, else trap); overflow traps like `*`. 0.pow(0) == 1.
fn Int.pow(self, e: Int) -> Int {
    if e < 0 { panic("pow with a negative exponent {e}") }
    var r = 1
    var b = self
    var k = e
    while k > 0 {
        if k % 2 == 1 { r *= b }
        k /= 2
        if k > 0 { b *= b } // if this overflows, so does the result
    }
    r
}
// None on overflow or a negative exponent.
fn Int.checked_pow(self, e: Int) -> Option[Int] {
    if e < 0 { return None }
    var r = 1
    var b = self
    var k = e
    while k > 0 {
        if k % 2 == 1 { r = r.checked_mul(b)? }
        k /= 2
        if k > 0 { b = b.checked_mul(b)? }
    }
    Some(r)
}
// Digits 0-9 then a-z, '-' for negatives: 255.to_str_radix(16) == "ff". Base 2..36, else trap.
fn Int.to_str_radix(self, base: Int) -> Str {
    if base < 2 or base > 36 { panic("to_str_radix: base {base} is not in 2..36") }
    if self == 0 { return "0" }
    var n = if self < 0 { self } else { -self } // negative, so INT_MIN works
    var digits: List[Str] = []
    while n != 0 {
        let d = -(n % base)
        digits.push((if d < 10 { '0' + d } else { 'a' + d - 10 }).char())
        n /= base
    }
    digits.reverse()
    (if self < 0 { "-" } else { "" }) + digits.join("")
}
// Fixed-point text: 1234.fmt_fixed(2) == "12.34", (-5).fmt_fixed(2) == "-0.05".
fn Int.fmt_fixed(self, scale: Int) -> Str {
    if scale <= 0 { return self.to_str() }
    let digits = self.abs().to_str().pad_left(scale + 1, "0")
    let cut = digits.len() - scale
    (if self < 0 { "-" } else { "" }) + digits.slice(0, cut) + "." + digits.slice(cut, digits.len())
}
extern fn Int.char(self) -> Str
// Character classes for code points (ASCII): '7'.is_digit(), s.byte(i).is_space()
fn Int.is_digit(self) -> Bool { self >= '0' and self <= '9' }
fn Int.is_upper(self) -> Bool { self >= 'A' and self <= 'Z' }
fn Int.is_lower(self) -> Bool { self >= 'a' and self <= 'z' }
fn Int.is_alpha(self) -> Bool { self.is_upper() or self.is_lower() }
fn Int.is_alnum(self) -> Bool { self.is_alpha() or self.is_digit() }
fn Int.is_space(self) -> Bool { self == ' ' or self == '\t' or self == '\n' or self == '\r' }
extern fn Float.to_int(self) -> Int
extern fn Float.sqrt(self) -> Float
extern fn Float.floor(self) -> Float
extern fn Float.ceil(self) -> Float
extern fn Float.round(self) -> Float
// Exactly `decimals` digits after the point (round half to even on the binary value, like printf).
extern fn Float.to_fixed(self, decimals: Int) -> Str
fn Float.abs(self) -> Float { if self < 0.0 { -self } else { self } }
fn Float.min(self, o: Float) -> Float { if self < o { self } else { o } }
fn Float.max(self, o: Float) -> Float { if self > o { self } else { o } }

// ---- Str (UTF-8 bytes; offsets are byte offsets) ----
extern fn Str.len(self) -> Int
extern fn Str.byte(self, i: Int) -> Int
extern fn Str.slice(self, start: Int, end: Int) -> Str
extern fn Str.find(self, sub: Str) -> Option[Int]
extern fn Str.find_from(self, sub: Str, start: Int) -> Option[Int] // first match at or after byte `start`
extern fn Str.split(self, sep: Str) -> List[Str]
extern fn Str.trim(self) -> Str
extern fn Str.trim_start(self) -> Str
extern fn Str.trim_end(self) -> Str
extern fn Str.starts_with(self, prefix: Str) -> Bool
extern fn Str.ends_with(self, suffix: Str) -> Bool
extern fn Str.to_int(self) -> Option[Int]
// Strict: optional '-', then one or more digits of `base` (2..36, else trap),
// letters in either case; no '+', spaces or '_'. None if invalid or on overflow.
fn Str.to_int_radix(self, base: Int) -> Option[Int] {
    if base < 2 or base > 36 { panic("to_int_radix: base {base} is not in 2..36") }
    let neg = self.starts_with("-")
    let start = if neg { 1 } else { 0 }
    if start == self.len() { return None }
    var n = 0 // accumulated negatively, so INT_MIN parses
    for i in start..self.len() {
        let c = self.byte(i)
        let d = if c.is_digit() { c - '0' } else if c.is_lower() { c - 'a' + 10 } else if c.is_upper() { c - 'A' + 10 } else { 36 }
        if d >= base { return None }
        n = n.checked_mul(base)?.checked_sub(d)?
    }
    if neg { Some(n) } else { n.checked_mul(-1) }
}
extern fn Str.to_float(self) -> Option[Float]
extern fn Str.upper(self) -> Str
extern fn Str.lower(self) -> Str
extern fn Str.replace(self, from: Str, to: Str) -> Str
// The code points of the string, each as a one-character string: "Zü".chars() == ["Z", "ü"].
extern fn Str.chars(self) -> List[Str]
// Number of code points (len() is the number of bytes): "Zürich".char_count() == 6, .len() == 7.
extern fn Str.char_count(self) -> Int
// Bytes are List[Int] with every element in 0..255. s.bytes() is the UTF-8 encoding of s.
extern fn Str.bytes(self) -> List[Int]
// Str.from_utf8(b): None if b is not valid UTF-8 or an element is outside 0..255.
extern fn Str.from_utf8(bytes: List[Int]) -> Option[Str]
// Each invalid sequence becomes U+FFFD (the rule console input uses); an element outside 0..255 traps.
extern fn Str.from_utf8_lossy(bytes: List[Int]) -> Str
fn Str.is_empty(self) -> Bool { self.len() == 0 }
fn Str.is_digits(self) -> Bool {
    if self.is_empty() { return false }
    for i in 0..self.len() {
        if not self.byte(i).is_digit() { return false }
    }
    true
}
fn Str.strip_prefix(self, p: Str) -> Option[Str] {
    if self.starts_with(p) { Some(self.slice(p.len(), self.len())) } else { None }
}
fn Str.strip_suffix(self, p: Str) -> Option[Str] {
    if self.ends_with(p) { Some(self.slice(0, self.len() - p.len())) } else { None }
}
// Removes leading and trailing bytes that occur in `chars` (ASCII), e.g. s.trim_chars(" \t").
fn Str.trim_chars(self, chars: Str) -> Str {
    var a = 0
    var b = self.len()
    while a < b and chars.find(self.slice(a, a + 1)).is_some() { a += 1 }
    while b > a and chars.find(self.slice(b - 1, b)).is_some() { b -= 1 }
    self.slice(a, b)
}
fn Str.contains(self, sub: Str) -> Bool { self.find(sub).is_some() }
// pred holds for every byte (true for ""): s.all_bytes(fn(b) => b.is_lower() or b.is_digit() or b == '_')
fn Str.all_bytes(self, pred: fn(Int) -> Bool) -> Bool {
    for i in 0..self.len() {
        if not pred(self.byte(i)) { return false }
    }
    true
}
// Byte offset of the last match; "".rfind("") == Some(0), s.rfind("") == Some(s.len()).
fn Str.rfind(self, sub: Str) -> Option[Int] {
    if sub.is_empty() { return Some(self.len()) }
    var last = self.find(sub)?
    while true {
        let Some(i) = self.find_from(sub, last + 1) else { return Some(last) }
        last = i
    }
}
// Split around the first (split_once) or last (rsplit_once) match of sep:
// "k=v=w".split_once("=") == Some(("k", "v=w")); the pieces share bytes, like slice.
fn Str.split_once(self, sep: Str) -> Option[(Str, Str)] {
    let i = self.find(sep)?
    Some((self.slice(0, i), self.slice(i + sep.len(), self.len())))
}
fn Str.rsplit_once(self, sep: Str) -> Option[(Str, Str)] {
    let i = self.rfind(sep)?
    Some((self.slice(0, i), self.slice(i + sep.len(), self.len())))
}
// Lines without their "\n"; a final empty line is dropped.
extern fn Str.lines(self) -> List[Str]
// Pieces separated by runs of spaces, tabs, "\r" or "\n".
extern fn Str.words(self) -> List[Str]
fn Str.repeat(self, n: Int) -> Str {
    var parts: List[Str] = []
    for _ in 0..n { parts.push(self) }
    parts.join("")
}
// Padding counts code points (char_count), not bytes, so "Zürich".pad_right(8, ".") is
// "Zürich.."; `fill` must be exactly one character (one code point), otherwise a trap.
fn Str.pad_left(self, width: Int, fill: Str) -> Str {
    if fill.char_count() != 1 { panic("pad_left: fill must be exactly one character, got {encode(fill)}") }
    let n = self.char_count()
    if n >= width { self } else { fill.repeat(width - n) + self }
}
fn Str.pad_right(self, width: Int, fill: Str) -> Str {
    if fill.char_count() != 1 { panic("pad_right: fill must be exactly one character, got {encode(fill)}") }
    let n = self.char_count()
    if n >= width { self } else { self + fill.repeat(width - n) }
}

// ---- List ----
extern fn List[T].len(self) -> Int
extern fn List[T].push(mut self, x: T)
extern fn List[T].pop(mut self) -> Option[T]
extern fn List[T].insert(mut self, i: Int, x: T)
extern fn List[T].remove(mut self, i: Int) -> T
extern fn List[T].clear(mut self)
extern fn List[T].slice(self, start: Int, end: Int) -> List[T]
extern fn List[T].sort(mut self)
extern fn List[T].sort_by[K](mut self, key: fn(T) -> K)
extern fn List[T].sort_by_desc[K](mut self, key: fn(T) -> K) // stable: equal keys keep their order
extern fn List[T].reverse(mut self)
extern fn List[Str].join(self, sep: Str) -> Str
fn List[T].is_empty(self) -> Bool { self.len() == 0 }
// [(0, a), (1, b), ...] for `for (i, x) in xs.enumerate()`
fn List[T].enumerate(self) -> List[(Int, T)] {
    var out: List[(Int, T)] = []
    for i in 0..self.len() { out.push((i, self[i])) }
    out
}
fn List[T].filled(n: Int, x: T) -> List[T] {
    var out: List[T] = []
    for _ in 0..n { out.push(x) }
    out
}
fn List[T].swap(mut self, i: Int, j: Int) {
    let t = self[i]
    self[i] = self[j]
    self[j] = t
}
// Stable sort with a comparison: cmp(a, b) < 0 puts a first.
fn List[T].sort_with(mut self, cmp: fn(T, T) -> Int) {
    var width = 1
    let n = self.len()
    while width < n {
        var out: List[T] = []
        var lo = 0
        while lo < n {
            let mid = (lo + width).min(n)
            let hi = (lo + 2 * width).min(n)
            var i = lo
            var j = mid
            while i < mid or j < hi {
                if j >= hi or (i < mid and cmp(self[j], self[i]) >= 0) {
                    out.push(self[i])
                    i += 1
                } else {
                    out.push(self[j])
                    j += 1
                }
            }
            lo = hi
        }
        self = out
        width *= 2
    }
}
fn List[T].get(self, i: Int) -> Option[T] {
    if i >= 0 and i < self.len() { Some(self[i]) } else { None }
}
fn List[T].first(self) -> Option[T] { self.get(0) }
fn List[T].last(self) -> Option[T] { self.get(self.len() - 1) }
fn List[T].index_of(self, x: T) -> Option[Int] {
    for i in 0..self.len() {
        if self[i] == x { return Some(i) }
    }
    None
}
fn List[T].contains(self, x: T) -> Bool { self.index_of(x).is_some() }
// The list must be sorted ascending by the derived ordering (as sort() leaves it).
// Ok(i): the first index i with self[i] == x; Err(i): x is absent, and self.insert(i, x)
// keeps the list sorted. O(log n).
fn List[T].binary_search(self, x: T) -> Result[Int, Int] {
    var lo = 0
    var hi = self.len()
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if self[mid] < x { lo = mid + 1 } else { hi = mid }
    }
    if lo < self.len() and self[lo] == x { Ok(lo) } else { Err(lo) }
}
fn List[T].extend(mut self, other: List[T]) {
    for x in other { self.push(x) }
}
fn List[T].sorted(self) -> List[T] {
    var c = self
    c.sort()
    c
}
fn List[T].reversed(self) -> List[T] {
    var c = self
    c.reverse()
    c
}
fn List[T].map[U](self, f: fn(T) -> U) -> List[U] {
    var out: List[U] = []
    for x in self { out.push(f(x)) }
    out
}
fn List[T].filter(self, keep: fn(T) -> Bool) -> List[T] {
    var out: List[T] = []
    for x in self {
        if keep(x) { out.push(x) }
    }
    out
}
fn List[T].any(self, pred: fn(T) -> Bool) -> Bool {
    for x in self {
        if pred(x) { return true }
    }
    false
}
fn List[T].all(self, pred: fn(T) -> Bool) -> Bool {
    for x in self {
        if not pred(x) { return false }
    }
    true
}
fn List[T].count(self, pred: fn(T) -> Bool) -> Int {
    var n = 0
    for x in self {
        if pred(x) { n += 1 }
    }
    n
}
// The element with the largest (max_by) or smallest (min_by) key; the first
// of several equal keys; None for an empty list. Keys use the derived ordering.
fn List[T].max_by[K](self, key: fn(T) -> K) -> Option[T] {
    if self.is_empty() { return None }
    var best = self[0]
    var bk = key(best)
    for i in 1..self.len() {
        let k = key(self[i])
        if k > bk {
            best = self[i]
            bk = k
        }
    }
    Some(best)
}
fn List[T].min_by[K](self, key: fn(T) -> K) -> Option[T] {
    if self.is_empty() { return None }
    var best = self[0]
    var bk = key(best)
    for i in 1..self.len() {
        let k = key(self[i])
        if k < bk {
            best = self[i]
            bk = k
        }
    }
    Some(best)
}
// Elements by key, keys in order of first occurrence, each group in list order:
// ["ab", "c", "de"].group_by(fn(s) => s.len()) == [2: ["ab", "de"], 1: ["c"]]
fn List[T].group_by[K](self, key: fn(T) -> K) -> Map[K, List[T]] {
    var out: Map[K, List[T]] = [:]
    for x in self {
        let k = key(x)
        out.or_insert(k, [])
        out[k].push(x)
    }
    out
}
fn List[Int].sum(self) -> Int {
    var s = 0
    for x in self { s += x }
    s
}

// ---- Map (iteration follows insertion order) ----
extern fn Map[K, V].len(self) -> Int
extern fn Map[K, V].get(self, k: K) -> Option[V]
extern fn Map[K, V].insert(mut self, k: K, v: V)
extern fn Map[K, V].remove(mut self, k: K) -> Option[V]
extern fn Map[K, V].keys(self) -> List[K]
extern fn Map[K, V].values(self) -> List[V]
fn Map[K, V].is_empty(self) -> Bool { self.len() == 0 }
fn Map[K, V].contains(self, k: K) -> Bool { self.get(k).is_some() }
fn Map[K, V].get_or(self, k: K, default: V) -> V { self.get(k).unwrap_or(default) }
// Insert v only if k is absent: `m.or_insert(k, []); m[k].push(x)` groups values.
fn Map[K, V].or_insert(mut self, k: K, v: V) {
    if not self.contains(k) { self[k] = v }
}
// m.update(k, 0, fn(n) => n + 1): apply f to the value at k (default if absent) and store it.
fn Map[K, V].update(mut self, k: K, default: V, f: fn(V) -> V) {
    let v = f(self.get_or(k, default))
    self[k] = v
}
fn Map[K, V].entries(self) -> List[(K, V)] {
    var out: List[(K, V)] = []
    for e in self { out.push(e) }
    out
}

// ---- Set (iteration follows insertion order) ----
pub struct Set[T] { items_: Map[T, Unit] }
fn Set[T].new() -> Set[T] { Set { items_: [:] } }
fn Set[T].of(xs: List[T]) -> Set[T] {
    var m: Map[T, Unit] = [:]
    for x in xs { m[x] = () }
    Set { items_: m }
}
fn Set[T].insert(mut self, x: T) -> Bool {
    if self.items_.contains(x) { return false }
    self.items_[x] = ()
    true
}
fn Set[T].remove(mut self, x: T) -> Bool { self.items_.remove(x).is_some() }
fn Set[T].contains(self, x: T) -> Bool { self.items_.contains(x) }
fn Set[T].len(self) -> Int { self.items_.len() }
fn Set[T].is_empty(self) -> Bool { self.items_.len() == 0 }
fn Set[T].items(self) -> List[T] { self.items_.keys() }

// ---- Heap: a priority queue; pop returns the smallest item (derived ordering).
// For largest-first, push negated keys: h.push((-priority, item)).
pub struct Heap[T] { items_: List[T] }
fn Heap[T].new() -> Heap[T] { Heap { items_: [] } }
fn Heap[T].len(self) -> Int { self.items_.len() }
fn Heap[T].is_empty(self) -> Bool { self.items_.len() == 0 }
fn Heap[T].peek(self) -> Option[T] { self.items_.first() }
fn Heap[T].push(mut self, x: T) {
    self.items_.push(x)
    var i = self.items_.len() - 1
    while i > 0 {
        let p = (i - 1) / 2
        if self.items_[i] < self.items_[p] {
            self.items_.swap(i, p)
            i = p
        } else {
            break
        }
    }
}
fn Heap[T].pop(mut self) -> Option[T] {
    let n = self.items_.len()
    if n == 0 { return None }
    let top = self.items_[0]
    let last = self.items_.pop().unwrap()
    if n > 1 {
        self.items_[0] = last
        var i = 0
        while true {
            let (l, r) = (2 * i + 1, 2 * i + 2)
            var m = i
            if l < n - 1 and self.items_[l] < self.items_[m] { m = l }
            if r < n - 1 and self.items_[r] < self.items_[m] { m = r }
            if m == i { break }
            self.items_.swap(i, m)
            i = m
        }
    }
    Some(top)
}

// ---- Option / Result ----
extern fn Option[T].unwrap(self) -> T
extern fn Option[T].expect(self, msg: Str) -> T
fn Option[T].is_some(self) -> Bool { match self { Some(_) => true, None => false } }
fn Option[T].is_none(self) -> Bool { not self.is_some() }
fn Option[T].unwrap_or(self, default: T) -> T { match self { Some(x) => x, None => default } }
fn Option[T].ok_or[E](self, err: E) -> Result[T, E] {
    match self { Some(x) => Ok(x), None => Err(err) }
}
fn Option[T].map[U](self, f: fn(T) -> U) -> Option[U] {
    match self { Some(x) => Some(f(x)), None => None }
}
fn Option[T].and_then[U](self, f: fn(T) -> Option[U]) -> Option[U] {
    match self { Some(x) => f(x), None => None }
}
fn Option[T].map_or[U](self, default: U, f: fn(T) -> U) -> U {
    match self { Some(x) => f(x), None => default }
}
fn Option[T].filter(self, keep: fn(T) -> Bool) -> Option[T] {
    match self { Some(x) => if keep(x) { Some(x) } else { None }, None => None }
}
fn Option[T].is_some_and(self, pred: fn(T) -> Bool) -> Bool {
    match self { Some(x) => pred(x), None => false }
}
extern fn Result[T, E].unwrap(self) -> T
extern fn Result[T, E].expect(self, msg: Str) -> T
fn Result[T, E].is_ok(self) -> Bool { match self { Ok(_) => true, Err(_) => false } }
fn Result[T, E].is_err(self) -> Bool { not self.is_ok() }
fn Result[T, E].ok(self) -> Option[T] { match self { Ok(x) => Some(x), Err(_) => None } }
fn Result[T, E].unwrap_or(self, default: T) -> T { match self { Ok(x) => x, Err(_) => default } }
fn Result[T, E].map_err[F](self, f: fn(E) -> F) -> Result[T, F] {
    match self { Ok(x) => Ok(x), Err(e) => Err(f(e)) }
}
fn Result[T, E].err(self) -> Option[E] { match self { Ok(_) => None, Err(e) => Some(e) } }
fn Result[T, E].map[U](self, f: fn(T) -> U) -> Result[U, E] {
    match self { Ok(x) => Ok(f(x)), Err(e) => Err(e) }
}
fn Result[T, E].and_then[U](self, f: fn(T) -> Result[U, E]) -> Result[U, E] {
    match self { Ok(x) => f(x), Err(e) => Err(e) }
}
fn Result[T, E].map_or[U](self, default: U, f: fn(T) -> U) -> U {
    match self { Ok(x) => f(x), Err(_) => default }
}
fn Result[T, E].is_ok_and(self, pred: fn(T) -> Bool) -> Bool {
    match self { Ok(x) => pred(x), Err(_) => false }
}
fn Result[T, E].is_err_and(self, pred: fn(E) -> Bool) -> Bool {
    match self { Ok(_) => false, Err(e) => pred(e) }
}

// ---- Capabilities ----
extern fn Console.print(self, s: Str)
extern fn Console.println(self, s: Str)
extern fn Console.eprintln(self, s: Str)
// Text input replaces invalid UTF-8 with U+FFFD; read_line drops the line's "\n" and then one
// trailing "\r" (also from a last line without "\n").
extern fn Console.read_line(self) -> Option[Str]
extern fn Console.read_all(self) -> Str
extern fn Console.read_all_bytes(self) -> List[Int] // the rest of stdin, unchanged
extern fn Console.write_bytes(self, data: List[Int]) // raw bytes to stdout; an element outside 0..255 traps
extern fn Console.flush(self) // output is also flushed before any blocking read and at exit

// Paths are relative to the Fs root. `within` narrows the root; an attenuated
// Fs rejects absolute paths and `..`. `read_only` drops write authority.
extern fn Fs.read(self, path: Str) -> Result[Str, IoError] // Err(Failed("path: invalid UTF-8")) if not UTF-8
extern fn Fs.write(self, path: Str, data: Str) -> Result[Unit, IoError]
extern fn Fs.append(self, path: Str, data: Str) -> Result[Unit, IoError]
// Byte variants of read/write/append (same rules); writing an element outside 0..255 traps.
extern fn Fs.read_bytes(self, path: Str) -> Result[List[Int], IoError]
extern fn Fs.write_bytes(self, path: Str, data: List[Int]) -> Result[Unit, IoError]
extern fn Fs.append_bytes(self, path: Str, data: List[Int]) -> Result[Unit, IoError]
extern fn Fs.exists(self, path: Str) -> Bool
extern fn Fs.remove(self, path: Str) -> Result[Unit, IoError] // file or empty directory
extern fn Fs.list(self, dir: Str) -> Result[List[Str], IoError]
extern fn Fs.mkdir(self, path: Str) -> Result[Unit, IoError] // also creates missing parents
extern fn Fs.mkdir_one(self, path: Str) -> Result[Unit, IoError] // exactly one; parent must exist, path must not
extern fn Fs.rename(self, from: Str, to: Str) -> Result[Unit, IoError] // atomic; replaces `to`
extern fn Fs.is_dir(self, path: Str) -> Bool
extern fn Fs.within(self, dir: Str) -> Fs
extern fn Fs.read_only(self) -> Fs

// Path text helpers ('/'-separated, purely lexical; they never touch the disk).
// path_join("a", "b") == "a/b", path_join("a/", "b") == "a/b"; an absolute
// second part replaces the first: path_join("a", "/b") == "/b"; an empty part
// yields the other one.
fn path_join(a: Str, b: Str) -> Str {
    if a.is_empty() or b.starts_with("/") { return b }
    if b.is_empty() { return a }
    if a.ends_with("/") { a + b } else { a + "/" + b }
}
// Trailing slashes are ignored. path_parent("a/b") == "a", path_parent("a/b/") == "a",
// path_parent("a") == ".", path_parent("") == ".", path_parent("/a") == "/",
// path_parent("/") == "/". `..` is not resolved: path_parent("a/..") == "a".
fn path_parent(p: Str) -> Str {
    var n = p.len()
    while n > 0 and p.byte(n - 1) == '/' { n -= 1 } // drop trailing slashes
    while n > 0 and p.byte(n - 1) != '/' { n -= 1 } // drop the last component
    if n == 0 { return if p.starts_with("/") { "/" } else { "." } }
    while n > 1 and p.byte(n - 1) == '/' { n -= 1 }  // drop the separator(s)
    p.slice(0, n)
}
// The last component; trailing slashes are ignored. path_base("a/b") == "b",
// path_base("a/b/") == "b", path_base("a") == "a", path_base("/") == "/", path_base("") == "".
fn path_base(p: Str) -> Str {
    var end = p.len()
    while end > 0 and p.byte(end - 1) == '/' { end -= 1 }
    if end == 0 { return if p.is_empty() { "" } else { "/" } }
    var start = end
    while start > 0 and p.byte(start - 1) != '/' { start -= 1 }
    p.slice(start, end)
}

// TCP on 127.0.0.1 or a named host. Listener and Conn are unique handles:
// they cannot be copied, and dropping one closes it.
extern fn Net.listen(self, port: Int) -> Result[Listener, IoError] // port 0: any free port
extern fn Net.connect(self, host: Str, port: Int) -> Result[Conn, IoError]
extern fn Listener.port(self) -> Int
extern fn Listener.accept(self) -> Result[Conn, IoError]
extern fn Conn.read_line(self) -> Result[Option[Str], IoError] // None at end of stream; drops "\n", then one trailing "\r", like Console.read_line
extern fn Conn.read(self, n: Int) -> Result[Str, IoError]       // up to n bytes; fewer only at end
extern fn Conn.write(self, s: Str) -> Result[Unit, IoError]

// Event loop: one Poller owns many sockets, named by Int ids. wait() returns
// what happened, in id order: new connections are accepted for you.
pub enum NetEvent { Accepted(Int, Int), Data(Int, Str), Closed(Int), Timeout }
extern fn Net.poller(self) -> Poller
extern fn Poller.listen(self, port: Int) -> Result[Int, IoError] // a listener id
extern fn Poller.connect(self, host: Str, port: Int) -> Result[Int, IoError] // a connection id
extern fn Poller.port(self, id: Int) -> Int
extern fn Poller.wait(self, timeout_ms: Int) -> List[NetEvent] // -1: no timeout
extern fn Poller.send(self, id: Int, data: Str) -> Result[Unit, IoError]
extern fn Poller.close(self, id: Int)

extern fn Clock.now_ms(self) -> Int
extern fn Clock.mono_ns(self) -> Int
extern fn Clock.sleep_ms(self, ms: Int)
