// Count words (lowercased, split on whitespace) from stdin; print the top 10.
fn main(sys: Sys) {
    let con = sys.console
    var counts: Map[Str, Int] = [:]
    for w in con.read_all().lower().words() {
        counts[w] = counts.get_or(w, 0) + 1
    }
    var entries = counts.entries()
    entries.sort_by(fn(e) => (-e.1, e.0))
    for e in entries.slice(0, 10.min(entries.len())) {
        con.println("{e.1} {e.0}")
    }
}
